/* ====== ORBIT ====== */
.pv-orbit {
  position: relative;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-bg); color: #fff;
  padding: 72px 16px 88px; overflow: hidden;
}
.pv-orbit__bg {
  position: absolute; inset: 0; z-index: 0;
  background: radial-gradient(800px 600px at 50% 50%, rgba(24,95,165,0.25) 0%, rgba(10,26,46,0) 60%), linear-gradient(180deg, var(--pv-bg) 0%, var(--pv-bg-2) 100%);
}
.pv-orbit__grid {
  position: absolute; inset: 0;
  background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 56px 56px;
  -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, #000 30%, transparent 100%);
  mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, #000 30%, transparent 100%);
}
.pv-orbit__inner { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; }
.pv-orbit__head { text-align: center; max-width: 56ch; margin: 0 auto 56px; display: flex; flex-direction: column; align-items: center; }
.pv-orbit__title {
  font-size: clamp(26px, 5vw, 44px); font-weight: 900;
  letter-spacing: -0.025em; line-height: 1.15;
  margin: 16px 0 14px; color: #fff; text-wrap: balance;
}
.pv-orbit__title-accent {
  color: var(--pv-accent);
  background-image: linear-gradient(180deg, transparent 70%, rgba(147,197,253,.30) 70%, rgba(147,197,253,.30) 92%, transparent 92%);
  background-repeat: no-repeat; padding: 0 4px;
}
.pv-orbit__lead { font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.62); margin: 0; line-height: 1.55; max-width: 50ch; }

.pv-orbit__stage {
  position: relative; width: 100%; max-width: 560px; aspect-ratio: 1; margin: 0 auto;
  --orbit-radius: 120px; --orbit-pin-size: 48px;
}
@media (min-width: 380px) { .pv-orbit__stage { --orbit-radius: 138px; } }
@media (min-width: 480px) { .pv-orbit__stage { --orbit-radius: 168px; --orbit-pin-size: 54px; } }
@media (min-width: 640px) { .pv-orbit__stage { --orbit-radius: 205px; --orbit-pin-size: 60px; } }
@media (min-width: 800px) { .pv-orbit__stage { --orbit-radius: 230px; --orbit-pin-size: 64px; } }
.pv-orbit__rings { position: absolute; inset: 0; width: 100%; height: 100%; }

.pv-orbit__core {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 18%; aspect-ratio: 1;
  display: flex; align-items: center; justify-content: center; z-index: 5;
}
.pv-orbit__core-mark {
  position: relative; z-index: 3;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, #fff 0%, #F0F6FC 100%);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 0 1px rgba(147,197,253,0.4), 0 0 40px rgba(147,197,253,0.3), 0 12px 40px rgba(12,68,124,0.5);
  padding: 22%;
}
.pv-orbit__core-mark img { width: 100%; height: 100%; object-fit: contain; }
.pv-orbit__core-ring { position: absolute; width: 130%; height: 130%; border: 1px solid rgba(147,197,253,0.4); border-radius: 50%; z-index: 2; }
.pv-orbit__core-pulse { position: absolute; inset: 0; border-radius: 50%; background: rgba(147,197,253,0.20); z-index: 1; animation: pvOrbitPulse 3s ease-out infinite; }
@keyframes pvOrbitPulse { 0% { transform: scale(1); opacity: 0.6; } 100% { transform: scale(2.2); opacity: 0; } }

.pv-orbit__ring { position: absolute; inset: 0; animation: pvOrbitRotate 60s linear infinite; }
.pv-orbit__stage.is-paused .pv-orbit__ring { animation-play-state: paused; }
@keyframes pvOrbitRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.pv-orbit__pin {
  position: absolute; top: 50%; left: 50%;
  width: var(--orbit-pin-size); height: var(--orbit-pin-size);
  margin-top: calc(var(--orbit-pin-size) / -2);
  margin-left: calc(var(--orbit-pin-size) / -2);
  text-decoration: none;
  transform: rotate(var(--angle)) translateY(calc(-1 * var(--orbit-radius))) rotate(calc(-1 * var(--angle)));
}
.pv-orbit__pin-core {
  position: relative; display: flex; align-items: center; justify-content: center;
  width: 100%; height: 100%; border-radius: 50%;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.16);
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
  color: var(--pv-accent);
  transition: background 200ms var(--pv-ease), border-color 200ms var(--pv-ease), box-shadow 200ms var(--pv-ease), color 200ms var(--pv-ease);
}
.pv-orbit__pin-core [data-lucide] { width: 22px; height: 22px; stroke-width: 2.2; }
.pv-orbit__pin:hover .pv-orbit__pin-core, .pv-orbit__pin.is-active .pv-orbit__pin-core {
  background: var(--pv-primary);
  border-color: rgba(147,197,253,0.6); color: #fff;
  box-shadow: 0 0 0 4px rgba(147,197,253,0.20), 0 8px 24px rgba(24,95,165,0.45);
}
.pv-orbit__pin-label {
  position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%);
  display: inline-flex; align-items: center; gap: 6px;
  background: #fff;
  border: 1px solid rgba(147,197,253,0.4);
  border-radius: 9999px; padding: 6px 10px 6px 12px;
  font-size: 11px; font-weight: 800; color: var(--pv-primary-dk);
  white-space: nowrap; opacity: 0; pointer-events: none;
  box-shadow: 0 8px 20px rgba(0,0,0,0.3);
  transition: opacity 200ms var(--pv-ease), bottom 200ms var(--pv-ease);
}
.pv-orbit__pin:hover .pv-orbit__pin-label, .pv-orbit__pin.is-active .pv-orbit__pin-label { opacity: 1; bottom: calc(100% + 14px); }
.pv-orbit__pin-arrow { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 50%; background: var(--pv-primary); color: #fff; }
.pv-orbit__pin-arrow [data-lucide] { width: 10px; height: 10px; stroke-width: 3; }

.pv-orbit__hud {
  position: absolute; bottom: -16px; left: 50%; transform: translateX(-50%);
  background: rgba(10,26,46,0.75);
  border: 1px solid rgba(255,255,255,0.14);
  -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
  border-radius: 12px; padding: 9px 16px;
  display: flex; align-items: center; gap: 12px;
  font-size: 12px; z-index: 4;
}
.pv-orbit__hud-label { font-size: 9px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.55); }
.pv-orbit__hud-value { font-size: 12px; font-weight: 800; color: #fff; min-width: 11ch; }
@media (min-width: 720px) { .pv-orbit { padding: 100px 32px 120px; } }

/* ====== SHELF ====== */
