{% comment %}
========================================================================
PROVENZANO HOME v6 — LINGO style + paleta Provenzano
========================================================================
Estética Duolingo:
- Bordes inferiores 3D tactiles (border-b-4 + active translateY)
- Tipografía Nunito redondeada
- Colores brillantes y planos
- Cards con bottom-shadow para depth
- Todo interactivo en mobile y PC

Secciones:
1. Hero (presentación + CTA catálogo + WhatsApp)
2. Categorías (orbit rotando, tap pausa + label)
3. Catálogo (CTA gigante + marcas hover)
4. Envíos (mapa Argentina + 4 cards + zonas GBA + cómo comprar)
5. Footer mini + FAB
========================================================================
{% endcomment %}

{% schema %}
{
  "name": "Home Provenzano",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "logo_url", "label": "URL del logo", "default": "https://cdn.shopify.com/s/files/1/0729/9366/9368/files/provenzano-logo.svg?v=1777313813" },
    { "type": "text", "id": "wpp_phone", "label": "WhatsApp", "default": "5491141794592" }
  ],
  "presets": [{ "name": "Home Provenzano" }]
}
{% endschema %}

{%- assign logo_url = section.settings.logo_url | default: 'https://cdn.shopify.com/s/files/1/0729/9366/9368/files/provenzano-logo.svg?v=1777313813' -%}
{%- assign wpp_phone = section.settings.wpp_phone | default: '5491141794592' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<div class="pv">
  {%- comment -%} ============ HERO ============ {%- endcomment -%}
  <header class="pv-hero">

    <nav class="pv-nav pv-wrap">
      <a href="/" class="pv-nav__brand">
        <span class="pv-nav__mark"><img src="{{ logo_url }}" alt=""></span>
        <span class="pv-nav__txt">
          <span class="pv-nav__name">Provenzano</span>
          <span class="pv-nav__tag"><span class="pv-nav__live"></span>Mayorista · Liniers</span>
        </span>
      </a>
      <div class="pv-nav__actions">
        <a href="/search" class="pv-icon-btn" aria-label="Buscar"><i data-lucide="search"></i></a>
        <a href="/cart" class="pv-icon-btn" aria-label="Carrito">
          <i data-lucide="shopping-cart"></i>
          <span class="pv-icon-btn__badge" id="provCartBadge" style="display:none">0</span>
        </a>
      </div>
    </nav>

    <div class="pv-hero__inner pv-wrap">
      <div class="pv-hero__chip pv-rev">
        <span class="pv-hero__chip-icon">🏪</span>
        <span>Mayorista de kiosko · desde 2003</span>
      </div>

      <h1 class="pv-hero__title pv-rev" data-delay="80">
        Tu mayorista de<br>
        <em>toda la vida.</em>
      </h1>

      <p class="pv-hero__lead pv-rev" data-delay="160">
        Abastecemos kioscos, almacenes y revendedores desde Liniers, CABA. Catálogo de <b>200+ productos</b> con precios mayoristas <b>actualizados todos los días</b>.
      </p>

      <div class="pv-hero__ctas pv-rev" data-delay="240">
        <a href="/collections/all" class="pv-btn pv-btn--xl">
          Armá tu pedido
          <i data-lucide="arrow-right"></i>
        </a>
        <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola Provenzano, quiero hacer una consulta' | url_encode }}" target="_blank" rel="noopener" class="pv-btn pv-btn--lg pv-btn--wa">
          <i data-lucide="message-circle"></i>
          WhatsApp
        </a>
      </div>

      <div class="pv-hero__stats pv-rev" data-delay="320">
        <div class="pv-stat pv-stat--blue">
          <span class="pv-stat__icon">📅</span>
          <span class="pv-stat__num">20<i>+</i></span>
          <span class="pv-stat__lab">años en Liniers</span>
        </div>
        <div class="pv-stat pv-stat--success">
          <span class="pv-stat__icon">📦</span>
          <span class="pv-stat__num">216<i>+</i></span>
          <span class="pv-stat__lab">productos en stock</span>
        </div>
        <div class="pv-stat pv-stat--warning">
          <span class="pv-stat__icon">🚚</span>
          <span class="pv-stat__num">24</span>
          <span class="pv-stat__lab">provincias</span>
        </div>
        <div class="pv-stat pv-stat--danger">
          <span class="pv-stat__icon">🧾</span>
          <span class="pv-stat__num">A<i>/</i>B</span>
          <span class="pv-stat__lab">factura</span>
        </div>
      </div>
    </div>
  </header>
  {%- comment -%} ============ ORBIT CATEGORIAS ============ {%- endcomment -%}
  <section class="pv-orb" id="provOrb">
    <div class="pv-wrap pv-orb__head">
      <span class="pv-sec-label">02 · Categorías</span>
      <h2 class="pv-sec-title pv-rev">Lo que <em>más rota.</em></h2>
      <p class="pv-orb__lead pv-rev" data-delay="80">8 rubros que mueven el 80% de un kiosko. Tocá cualquiera para verlo en el catálogo.</p>
    </div>

    <div class="pv-orb__stage" id="provOrbStage">
      <div class="pv-orb__ring" id="provOrbRing">
        {% assign cats = 'encendedores|🔥|Encendedores,pilas|🔋|Pilas,pegamentos|📎|Pegamentos,afeitado|✂️|Afeitado,perfumeria|✨|Perfumería,repelentes|🦟|Repelentes,golosinas|🍬|Golosinas,farmacia|💊|Farmacia' | split: ',' %}
        {% for cat in cats %}
          {% assign parts = cat | split: '|' %}
          {% assign idx = forloop.index0 %}
          {% assign angle = idx | times: 45 %}
          <a href="/collections/{{ parts[0] }}" class="pv-orb__pin" style="--angle:{{ angle }}deg;--idx:{{ idx }}" aria-label="{{ parts[2] }}">
            <span class="pv-orb__pin-emoji">{{ parts[1] }}</span>
            <span class="pv-orb__pin-name">{{ parts[2] }}</span>
          </a>
        {% endfor %}
      </div>

      <div class="pv-orb__core">
        <div class="pv-orb__core-card">
          <img src="{{ logo_url }}" alt="Provenzano">
          <span>+216 productos</span>
        </div>
      </div>
    </div>

    <div class="pv-wrap pv-orb__cta pv-rev">
      <a href="/collections/all" class="pv-btn pv-btn--lg">Ver catálogo completo <i data-lucide="arrow-right"></i></a>
    </div>
  </section>
  {%- comment -%} ============ BRANDS interactivas ============ {%- endcomment -%}
  <section class="pv-marca" id="provMarca">
    <div class="pv-wrap">
      <header class="pv-marca__head">
        <span class="pv-sec-label">03 · Marcas oficiales</span>
        <h2 class="pv-sec-title pv-rev">Las que <em>tu cliente pide.</em></h2>
        <p class="pv-marca__lead pv-rev" data-delay="80">Tocá cualquier marca para ver qué vendemos. Trabajamos con primeras marcas, producto original.</p>
      </header>

      <div class="pv-marca__layout">
        <div class="pv-marca__list" role="tablist">
          <button class="pv-marca__btn is-active" type="button" data-brand="energizer">
            <span class="pv-marca__btn-num">01</span>
            <span class="pv-marca__btn-name">Energizer</span>
            <span class="pv-marca__btn-arr"><i data-lucide="arrow-right"></i></span>
          </button>
          <button class="pv-marca__btn" type="button" data-brand="duracell">
            <span class="pv-marca__btn-num">02</span>
            <span class="pv-marca__btn-name">Duracell</span>
            <span class="pv-marca__btn-arr"><i data-lucide="arrow-right"></i></span>
          </button>
          <button class="pv-marca__btn" type="button" data-brand="gillette">
            <span class="pv-marca__btn-num">03</span>
            <span class="pv-marca__btn-name">Gillette</span>
            <span class="pv-marca__btn-arr"><i data-lucide="arrow-right"></i></span>
          </button>
          <button class="pv-marca__btn" type="button" data-brand="candela">
            <span class="pv-marca__btn-num">04</span>
            <span class="pv-marca__btn-name">Candela</span>
            <span class="pv-marca__btn-arr"><i data-lucide="arrow-right"></i></span>
          </button>
          <button class="pv-marca__btn" type="button" data-brand="bic">
            <span class="pv-marca__btn-num">05</span>
            <span class="pv-marca__btn-name">BIC</span>
            <span class="pv-marca__btn-arr"><i data-lucide="arrow-right"></i></span>
          </button>
        </div>

        <div class="pv-marca__panels">
          <article class="pv-marca__panel is-active" data-panel="energizer">
            <span class="pv-marca__panel-emoji">🔋</span>
            <h3 class="pv-marca__panel-h">Energizer</h3>
            <span class="pv-marca__panel-eye">Pilas alcalinas</span>
            <p class="pv-marca__panel-p">AA, AAA, C, D y especiales. Stock permanente. Los formatos que más mueve un kiosko.</p>
            <div class="pv-marca__tags"><span>AA</span><span>AAA</span><span>9V</span><span>D</span></div>
          </article>
          <article class="pv-marca__panel" data-panel="duracell">
            <span class="pv-marca__panel-emoji">🐰</span>
            <h3 class="pv-marca__panel-h">Duracell</h3>
            <span class="pv-marca__panel-eye">Pilas premium</span>
            <p class="pv-marca__panel-p">Línea premium para quien busca duración real. Las que tu cliente pide por nombre.</p>
            <div class="pv-marca__tags"><span>AA</span><span>AAA</span><span>9V</span><span>Botón</span></div>
          </article>
          <article class="pv-marca__panel" data-panel="gillette">
            <span class="pv-marca__panel-emoji">✂️</span>
            <h3 class="pv-marca__panel-h">Gillette</h3>
            <span class="pv-marca__panel-eye">Afeitado</span>
            <p class="pv-marca__panel-p">Máquinas, repuestos y desechables. La marca que se vende sola en el mostrador.</p>
            <div class="pv-marca__tags"><span>Prestobarba</span><span>Mach3</span><span>Fusion</span><span>Repuestos</span></div>
          </article>
          <article class="pv-marca__panel" data-panel="candela">
            <span class="pv-marca__panel-emoji">🕯️</span>
            <h3 class="pv-marca__panel-h">Candela</h3>
            <span class="pv-marca__panel-eye">Hogar e iluminación</span>
            <p class="pv-marca__panel-p">Catálogo completo de iluminación, velas y artículos de hogar para el almacén de barrio.</p>
            <div class="pv-marca__tags"><span>Velas</span><span>Fósforos</span><span>Hogar</span></div>
          </article>
          <article class="pv-marca__panel" data-panel="bic">
            <span class="pv-marca__panel-emoji">🔥</span>
            <h3 class="pv-marca__panel-h">BIC</h3>
            <span class="pv-marca__panel-eye">Encendedores y librería</span>
            <p class="pv-marca__panel-p">Mini, Maxi, J5. Lapiceras y artículos de librería. Las marcas que nunca fallan en rotación.</p>
            <div class="pv-marca__tags"><span>Mini</span><span>Maxi</span><span>J5</span><span>Lapiceras</span></div>
          </article>
        </div>
      </div>
    </div>
  </section>
  {%- comment -%} ============ ENVIOS ============ {%- endcomment -%}
  <section class="pv-ship" id="provShip">
    <div class="pv-wrap">

      <header class="pv-ship__head">
        <span class="pv-sec-label">04 · Envíos</span>
        <h2 class="pv-sec-title pv-rev">Llegamos <em>donde estés.</em></h2>
        <p class="pv-ship__lead pv-rev" data-delay="80">Tocá los pines del mapa para ver tiempos por destino. 4 modalidades de envío, todas claras desde el principio.</p>
      </header>

      {%- comment -%} Mapa interactivo {%- endcomment -%}
      <div class="pv-map" id="provMap">
        <div class="pv-map__hud pv-map__hud--tl"><span class="pv-map__hud-dot"></span><span>Origen · Liniers, CABA</span></div>
        <div class="pv-map__hud pv-map__hud--tr"><b>24</b> provincias</div>
        <div class="pv-map__tip" id="provMapTip" aria-hidden="true">
          <span class="pv-map__tip-name"></span>
          <span class="pv-map__tip-meta"></span>
        </div>
        <svg class="pv-map__svg" viewBox="0 0 400 540" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
          <defs>
            <radialGradient id="pv-mg" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(24,95,165,0.30)"/>
              <stop offset="100%" stop-color="rgba(24,95,165,0)"/>
            </radialGradient>
          </defs>
          <g class="pv-map__country">
            <path d="M 220,40 L 235,55 L 240,75 L 248,95 L 256,115 L 268,140 L 274,165 L 282,195 L 290,225 L 296,255 L 298,290 L 290,325 L 280,360 L 268,395 L 252,425 L 234,450 L 215,470 L 195,485 L 178,495 L 165,505 L 158,520 L 162,533 L 175,530 L 175,512 L 188,508 L 192,495 L 178,488 L 198,470 L 215,455 L 220,470 L 215,488 L 218,500 L 232,492 L 230,478 L 240,460 L 252,440 L 230,425 L 215,395 L 200,370 L 185,345 L 170,335 L 155,330 L 148,320 L 152,300 L 168,285 L 180,272 L 186,250 L 178,225 L 168,200 L 155,180 L 148,158 L 152,135 L 162,115 L 175,95 L 188,72 L 200,55 L 210,42 Z" fill="#E6F1FB" stroke="#185FA5" stroke-width="2.5" stroke-linejoin="round"/>
          </g>
          <g class="pv-map__lines" stroke-linecap="round" fill="none">
            <path class="pv-map__line" style="--d:0s"   d="M 260,295 Q 270,325 255,360" stroke="#185FA5" stroke-width="2"/>
            <path class="pv-map__line" style="--d:0.5s" d="M 260,295 Q 240,260 230,225" stroke="#185FA5" stroke-width="2"/>
            <path class="pv-map__line" style="--d:1.0s" d="M 260,295 Q 230,255 215,200" stroke="#185FA5" stroke-width="2"/>
            <path class="pv-map__line" style="--d:1.5s" d="M 260,295 Q 220,260 195,225" stroke="#185FA5" stroke-width="2"/>
            <path class="pv-map__line" style="--d:2.0s" d="M 260,295 Q 215,295 170,278" stroke="#185FA5" stroke-width="2"/>
            <path class="pv-map__line" style="--d:2.5s" d="M 260,295 Q 220,225 195,158" stroke="#185FA5" stroke-width="2"/>
            <path class="pv-map__line" style="--d:3.0s" d="M 260,295 Q 200,360 190,470" stroke="#185FA5" stroke-width="2"/>
          </g>
          <g class="pv-map__origin" transform="translate(260,295)">
            <circle r="22" fill="url(#pv-mg)"/>
            <circle class="pv-map__ping" r="8" fill="none" stroke="#185FA5" stroke-width="2.5" opacity="0.7"/>
            <circle r="9" fill="#185FA5" stroke="#FFFFFF" stroke-width="2.5"/>
            <circle r="3" fill="#FFFFFF"/>
          </g>
          <g class="pv-map__pin" data-name="Mar del Plata" data-meta="Vía cargo · 24 hs" transform="translate(255,360)" tabindex="0" role="button">
            <circle r="14" fill="rgba(24,95,165,0)" class="pv-map__hit"/>
            <circle r="6" fill="#FFFFFF" stroke="#185FA5" stroke-width="3"/>
          </g>
          <g class="pv-map__pin" data-name="Rosario" data-meta="Vía cargo · 24-48 hs" transform="translate(230,225)" tabindex="0" role="button">
            <circle r="14" fill="rgba(24,95,165,0)" class="pv-map__hit"/>
            <circle r="6" fill="#FFFFFF" stroke="#185FA5" stroke-width="3"/>
          </g>
          <g class="pv-map__pin" data-name="Santa Fe" data-meta="Vía cargo · 2 días" transform="translate(215,200)" tabindex="0" role="button">
            <circle r="14" fill="rgba(24,95,165,0)" class="pv-map__hit"/>
            <circle r="6" fill="#FFFFFF" stroke="#185FA5" stroke-width="3"/>
          </g>
          <g class="pv-map__pin" data-name="Córdoba" data-meta="Vía cargo · 2-3 días" transform="translate(195,225)" tabindex="0" role="button">
            <circle r="14" fill="rgba(24,95,165,0)" class="pv-map__hit"/>
            <circle r="6" fill="#FFFFFF" stroke="#185FA5" stroke-width="3"/>
          </g>
          <g class="pv-map__pin" data-name="Mendoza" data-meta="Vía cargo · 3-4 días" transform="translate(170,278)" tabindex="0" role="button">
            <circle r="14" fill="rgba(24,95,165,0)" class="pv-map__hit"/>
            <circle r="6" fill="#FFFFFF" stroke="#185FA5" stroke-width="3"/>
          </g>
          <g class="pv-map__pin" data-name="Salta · NOA" data-meta="Vía cargo · 4-6 días" transform="translate(195,158)" tabindex="0" role="button">
            <circle r="14" fill="rgba(24,95,165,0)" class="pv-map__hit"/>
            <circle r="6" fill="#FFFFFF" stroke="#185FA5" stroke-width="3"/>
          </g>
          <g class="pv-map__pin" data-name="Patagonia" data-meta="Vía cargo · 5-7 días" transform="translate(190,470)" tabindex="0" role="button">
            <circle r="14" fill="rgba(24,95,165,0)" class="pv-map__hit"/>
            <circle r="6" fill="#FFFFFF" stroke="#185FA5" stroke-width="3"/>
          </g>
        </svg>
        <span class="pv-map__cap">Tocá un pin</span>
      </div>

      {%- comment -%} 4 modalidades cards {%- endcomment -%}
      <div class="pv-ship__cards">
        <article class="pv-ship-card pv-ship-card--feat pv-rev">
          <div class="pv-ship-card__top">
            <span class="pv-ship-card__num">02</span>
            <span class="pv-ship-card__icon">🚚</span>
          </div>
          <span class="pv-ship-card__highlight">Envío GRATIS desde $600.000</span>
          <h3 class="pv-ship-card__title">CABA<br>y GBA</h3>
          <span class="pv-ship-card__big">Desde $4.100</span>
          <ul class="pv-ship-card__list">
            <li><span>Pedido mínimo</span><b>$100.000</b></li>
            <li><span>Días</span><b>Mar. y jue.</b></li>
            <li><span>Salida</span><b>14 hs</b></li>
            <li><span>Llegada</span><b>14 a 21 hs</b></li>
          </ul>
          <a href="#provZones" class="pv-ship-card__link">Ver zonas y precios <i data-lucide="arrow-down"></i></a>
        </article>

        <article class="pv-ship-card pv-ship-card--success pv-rev" data-delay="80">
          <div class="pv-ship-card__top"><span class="pv-ship-card__num">01</span><span class="pv-ship-card__icon">🏪</span></div>
          <h3 class="pv-ship-card__title">Retiro<br>en sucursal</h3>
          <span class="pv-ship-card__big pv-ship-card__big--free">SIN COSTO</span>
          <ul class="pv-ship-card__list">
            <li><span>Pedido mínimo</span><b>$100.000</b></li>
            <li><span>Días</span><b>Lun. a sáb.</b></li>
            <li><span>Dirección</span><b>Carhué 74, Liniers</b></li>
          </ul>
        </article>

        <article class="pv-ship-card pv-ship-card--warning pv-rev" data-delay="160">
          <div class="pv-ship-card__top"><span class="pv-ship-card__num">03</span><span class="pv-ship-card__icon">🗺️</span></div>
          <h3 class="pv-ship-card__title">Envío al<br>interior</h3>
          <span class="pv-ship-card__big pv-ship-card__big--alt">Vía cargo</span>
          <ul class="pv-ship-card__list">
            <li><span>Pedido mínimo</span><b>$200.000</b></li>
            <li><span>Tiempo</span><b>2 a 7 días</b></li>
            <li><span>Cobertura</span><b>24 provincias</b></li>
            <li><span>Flete</span><b>Cliente al recibir</b></li>
          </ul>
        </article>

        <article class="pv-ship-card pv-ship-card--danger pv-rev" data-delay="240">
          <div class="pv-ship-card__top"><span class="pv-ship-card__num">04</span><span class="pv-ship-card__icon">🤝</span></div>
          <h3 class="pv-ship-card__title">Tu transporte<br>o comisionista</h3>
          <span class="pv-ship-card__big pv-ship-card__big--free">SIN COSTO</span>
          <ul class="pv-ship-card__list">
            <li><span>Pedido mínimo</span><b>$500.000</b></li>
            <li><span>Retiro</span><b>Carhué 74, Liniers</b></li>
            <li><span>Días</span><b>Lun. a sáb.</b></li>
          </ul>
        </article>
      </div>

      {%- comment -%} Zonas GBA {%- endcomment -%}
      <div class="pv-zones" id="provZones">
        <header class="pv-zones__head pv-rev">
          <span class="pv-sec-label">04.1 · Zonas CABA / GBA</span>
          <h3 class="pv-zones__title">Tu zona, <em>tu precio.</em></h3>
        </header>

        <div class="pv-zones__list">
          <article class="pv-zone pv-zone--success pv-rev">
            <div class="pv-zone__head"><span class="pv-zone__name">CABA</span><span class="pv-zone__price">$4.100</span></div>
            <p class="pv-zone__partidos">Toda la Capital Federal.</p>
          </article>
          <article class="pv-zone pv-zone--blue pv-rev" data-delay="80">
            <div class="pv-zone__head"><span class="pv-zone__name">GBA <em>1</em></span><span class="pv-zone__price">$5.000</span></div>
            <p class="pv-zone__partidos">Avellaneda · Lanús · Lomas de Zamora · La Matanza Norte · Morón · 3 de Febrero · San Martín · Vicente López · San Isidro</p>
          </article>
          <article class="pv-zone pv-zone--warning pv-rev" data-delay="160">
            <div class="pv-zone__head"><span class="pv-zone__name">GBA <em>2</em></span><span class="pv-zone__price">$6.000</span></div>
            <p class="pv-zone__partidos">San Fernando · Tigre · Malvinas Argentinas · José C. Paz · San Miguel · Hurlingham · Ituzaingó · La Matanza Sur · Merlo · Moreno · Esteban Echeverría · Almirante Brown · Ezeiza · Quilmes · Florencio Varela · Berazategui</p>
          </article>
          <article class="pv-zone pv-zone--danger pv-rev" data-delay="240">
            <div class="pv-zone__head"><span class="pv-zone__name">GBA <em>3</em></span><span class="pv-zone__price">$7.900</span></div>
            <p class="pv-zone__partidos">Zárate · Campana · Escobar · Ing. Maschwitz · Garín · Pilar · Del Viso · Derqui · Villa Rosa · Luján · Gral. Rodríguez · Marcos Paz · Nordelta · San Vicente · Guernica · Berisso · La Plata · Cañuelas · Ensenada</p>
          </article>
        </div>
      </div>

    </div>
  </section>
