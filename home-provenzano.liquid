  letter-spacing: -0.03em; line-height: 1;
  color: #fff;
}
.pv-brand__cat {
  position: relative; z-index: 1;
  font-size: 10px; font-weight: 800;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: rgba(255,255,255,0.50);
