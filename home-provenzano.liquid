        <a class="pv-foot__chip pv-foot__chip--wa" href="https://wa.me/{{ wpp_phone }}" target="_blank" rel="noopener">
          <i data-lucide="message-circle"></i> +54 9 11 4179-4592
        </a>
        <a class="pv-foot__chip" href="/collections/all">
          <i data-lucide="layout-grid"></i> Catálogo
        </a>
      </div>
      <div class="pv-foot__legal">
        <span>© Provenzano Mayorista 2026</span>
        <span class="pv-foot__legal-mono">Hecho en Liniers, CABA</span>
      </div>
    </div>
  </footer>

  {%- comment -%} ============ WHATSAPP FAB ============ {%- endcomment -%}
  <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola Provenzano, quiero hacer un pedido' | url_encode }}" target="_blank" rel="noopener" class="pv-fab" aria-label="WhatsApp">
    <span class="pv-fab__ring" aria-hidden="true"></span>
    <span class="pv-fab__ring pv-fab__ring--2" aria-hidden="true"></span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
