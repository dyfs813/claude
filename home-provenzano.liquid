}

.pv-why__card {
  position: relative; overflow: hidden;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 18px;
  padding: 22px;
  display: flex; flex-direction: column; gap: 12px;
  min-height: 160px;
  transition: transform 280ms var(--pv-ease), border-color 280ms var(--pv-ease), background 280ms var(--pv-ease);
}
.pv-why__card::after {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(400px 200px at 100% 0%, rgba(147,197,253,0.08), transparent 60%);
  opacity: 0; transition: opacity 280ms var(--pv-ease);
}
.pv-why__card:hover { transform: translateY(-3px); border-color: rgba(147,197,253,0.3); background: rgba(255,255,255,0.06); }
.pv-why__card:hover::after { opacity: 1; }
.pv-why__card--hero { grid-area: hero; min-height: 260px; padding: 28px; }
.pv-why__card--catalog { grid-area: catalog; }
.pv-why__card--store { grid-area: store; }
.pv-why__card--ship { grid-area: ship; }
.pv-why__card--invoice { grid-area: invoice; }

.pv-why__card-bg {
  position: absolute; inset: 0;
  background:
    radial-gradient(circle at 80% 20%, rgba(24,95,165,0.30), transparent 60%),
    linear-gradient(135deg, rgba(147,197,253,0.05), rgba(255,255,255,0));
}
.pv-why__card-content { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 10px; }
.pv-why__card-eyebrow {
  font-size: 10px; font-weight: 800;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: rgba(147,197,253,0.85);
}
.pv-why__big { display: flex; align-items: baseline; gap: 10px; line-height: 0.9; }
.pv-why__big-num {
  font-size: clamp(64px, 14vw, 120px);
  font-weight: 900; letter-spacing: -0.04em;
  color: #fff; font-variant-numeric: tabular-nums;
  background: linear-gradient(180deg, #fff 0%, #93C5FD 100%);
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.pv-why__big-label {
  font-size: 22px; font-weight: 800;
  color: rgba(255,255,255,0.85);
  letter-spacing: -0.01em;
}
.pv-why__card-icon {
  position: relative; z-index: 2;
  width: 44px; height: 44px; border-radius: 12px;
  display: inline-flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, rgba(147,197,253,0.18), rgba(24,95,165,0.25));
  border: 1px solid rgba(147,197,253,0.30);
  color: var(--pv-accent);
  align-self: flex-start;
}
.pv-why__card-icon [data-lucide] { width: 22px; height: 22px; stroke-width: 2.2; }
.pv-why__card-title {
  margin: 0; font-size: 22px; font-weight: 900;
  color: #fff; letter-spacing: -0.02em; line-height: 1.1;
  display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px;
}
.pv-why__card-title-sub {
  font-size: 14px; font-weight: 700;
  color: rgba(255,255,255,0.65); letter-spacing: 0;
}
.pv-why__card-text {
  margin: 0; font-size: 13px; font-weight: 500;
  color: rgba(255,255,255,0.62); line-height: 1.5;
}
.pv-why__card-link {
  position: relative; z-index: 2; align-self: flex-start;
  display: inline-flex; align-items: center; gap: 4px; margin-top: 4px;
  font-size: 12px; font-weight: 800;
  color: var(--pv-accent); text-decoration: none;
  letter-spacing: 0.02em;
}
.pv-why__card-link:hover { color: #fff; }
.pv-why__card-link [data-lucide] { width: 14px; height: 14px; stroke-width: 2.5; }
.pv-why__card-deco {
  position: absolute; right: -40px; bottom: -40px;
  width: 200px; height: 200px;
  opacity: 0.4; pointer-events: none;
  animation: pvWhyDecoSpin 60s linear infinite;
}
@keyframes pvWhyDecoSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

/* ====== CALCULADORA DE BULTO ====== */
.pv-calc {
  position: relative; overflow: hidden;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-bg);
  padding: 72px 16px 88px; color: #fff;
}
.pv-calc__bg {
  position: absolute; inset: 0; pointer-events: none; z-index: 0;
  background: linear-gradient(180deg, var(--pv-bg) 0%, var(--pv-bg-2) 100%);
}
.pv-calc__grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 56px 56px;
  -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 30%, transparent 100%);
  mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 30%, transparent 100%);
}
.pv-calc__orb {
  position: absolute; width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(37,211,102,0.12), transparent 70%);
  bottom: -200px; right: -100px; filter: blur(60px);
  animation: pvCalcOrb 14s ease-in-out infinite alternate;
}
@keyframes pvCalcOrb {
  from { transform: translate(0, 0); }
  to   { transform: translate(-40px, -30px); }
}
.pv-calc__inner { max-width: 920px; margin: 0 auto; position: relative; z-index: 1; }
.pv-calc__head {
  text-align: center; max-width: 56ch; margin: 0 auto 40px;
  display: flex; flex-direction: column; align-items: center;
}
.pv-calc__title {
  font-size: clamp(24px, 4.5vw, 38px); font-weight: 900;
  letter-spacing: -0.025em; line-height: 1.15;
  margin: 16px 0 10px; color: #fff; text-wrap: balance;
}
.pv-calc__title-accent {
  color: #4ADE80;
  background-image: linear-gradient(180deg, transparent 70%, rgba(74,222,128,.30) 70%, rgba(74,222,128,.30) 92%, transparent 92%);
  background-repeat: no-repeat; padding: 0 4px;
}
.pv-calc__lead {
  font-size: 14px; font-weight: 500;
  color: rgba(255,255,255,0.62);
  margin: 0; max-width: 50ch; line-height: 1.55;
}

.pv-calc__widget {
  background: linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 22px;
  padding: 18px;
  display: grid; gap: 18px;
  grid-template-columns: 1fr;
  box-shadow: 0 24px 60px -20px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.06);
  -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
}
@media (min-width: 760px) {
  .pv-calc__widget { padding: 26px; gap: 24px; grid-template-columns: 1.1fr 1fr; grid-template-rows: auto 1fr; }
  .pv-calc__product { grid-column: 1 / 2; }
  .pv-calc__control { grid-column: 1 / 2; }
  .pv-calc__output  { grid-column: 2 / 3; grid-row: 1 / 3; }
}

/* Producto */
.pv-calc__product {
  display: flex; align-items: center; gap: 14px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 14px; padding: 14px;
}
.pv-calc__product-icon {
  position: relative;
  width: 52px; height: 52px; border-radius: 12px; flex-shrink: 0;
  background: linear-gradient(135deg, rgba(147,197,253,0.18), rgba(24,95,165,0.30));
  border: 1px solid rgba(147,197,253,0.35);
  color: var(--pv-accent);
  display: inline-flex; align-items: center; justify-content: center;
}
.pv-calc__product-icon [data-lucide] { width: 24px; height: 24px; stroke-width: 2.2; position: relative; z-index: 2; }
.pv-calc__product-icon-pulse {
  position: absolute; inset: -2px; border-radius: 14px;
  border: 1px solid rgba(147,197,253,0.5);
  animation: pvCalcPulse 2.5s ease-out infinite;
}
@keyframes pvCalcPulse {
  0%   { transform: scale(1); opacity: 0.7; }
  100% { transform: scale(1.6); opacity: 0; }
}
.pv-calc__product-meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.pv-calc__product-tag {
  font-size: 9px; font-weight: 800;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: rgba(147,197,253,0.85);
}
.pv-calc__product-name {
  margin: 0; font-size: 16px; font-weight: 900;
  color: #fff; letter-spacing: -0.01em; line-height: 1.2;
}
.pv-calc__product-spec {
  margin: 0; font-size: 12px; font-weight: 600;
  color: rgba(255,255,255,0.65); line-height: 1.4;
}
.pv-calc__product-spec b { color: #fff; font-weight: 800; }
.pv-calc__product-price { color: var(--pv-accent); font-weight: 800; font-variant-numeric: tabular-nums; }

/* Control */
.pv-calc__control { display: flex; flex-direction: column; gap: 10px; }
.pv-calc__control-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.pv-calc__control-label {
  font-size: 12px; font-weight: 800;
  letter-spacing: 0.08em; text-transform: uppercase;
  color: rgba(255,255,255,0.75);
}
.pv-calc__bultos { display: inline-flex; align-items: center; gap: 6px; }
.pv-calc__step {
  width: 30px; height: 30px; border-radius: 8px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.16);
  color: #fff;
  font-size: 18px; font-weight: 800; line-height: 1;
  display: inline-flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: background 160ms var(--pv-ease), transform 100ms var(--pv-ease);
}
.pv-calc__step:hover { background: rgba(255,255,255,0.12); }
.pv-calc__step:active { transform: scale(0.92); }
.pv-calc__bultos-val {
  min-width: 36px; text-align: center;
  font-size: 22px; font-weight: 900; color: #fff;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

/* Slider custom */
.pv-calc__slider {
  -webkit-appearance: none; appearance: none;
  width: 100%; height: 6px; border-radius: 6px;
  background: linear-gradient(90deg, var(--pv-accent) 0%, var(--pv-accent) var(--pv-calc-pct, 15%), rgba(255,255,255,0.10) var(--pv-calc-pct, 15%), rgba(255,255,255,0.10) 100%);
  outline: none;
  cursor: pointer;
}
.pv-calc__slider::-webkit-slider-thumb {
  -webkit-appearance: none; appearance: none;
  width: 22px; height: 22px; border-radius: 50%;
  background: #fff;
  border: 3px solid var(--pv-accent);
  box-shadow: 0 4px 12px rgba(147,197,253,0.4), 0 0 0 6px rgba(147,197,253,0.12);
  cursor: grab;
  transition: transform 160ms var(--pv-ease), box-shadow 160ms var(--pv-ease);
}
.pv-calc__slider::-webkit-slider-thumb:active { transform: scale(1.15); cursor: grabbing; }
.pv-calc__slider::-moz-range-thumb {
  width: 22px; height: 22px; border-radius: 50%;
  background: #fff;
  border: 3px solid var(--pv-accent);
  box-shadow: 0 4px 12px rgba(147,197,253,0.4);
  cursor: grab;
}
.pv-calc__scale {
  display: flex; justify-content: space-between;
  font-family: var(--pv-mono);
  font-size: 10px; font-weight: 700;
  color: rgba(255,255,255,0.40);
  padding: 0 4px;
}

/* Output */
.pv-calc__output {
  background: rgba(0,0,0,0.20);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 16px;
  padding: 16px;
  display: flex; flex-direction: column; gap: 8px;
}
.pv-calc__row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 10px; padding: 8px 4px;
  border-bottom: 1px dashed rgba(255,255,255,0.08);
}
.pv-calc__row:last-of-type { border-bottom: none; }
.pv-calc__row-label {
  font-size: 11px; font-weight: 700;
  letter-spacing: 0.04em;
  color: rgba(255,255,255,0.62);
}
.pv-calc__row-value {
  font-size: 16px; font-weight: 900;
  color: #fff; font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}
.pv-calc__row--total { padding: 12px 4px 14px; border-bottom: 2px solid rgba(147,197,253,0.18); border-top: 1px solid rgba(147,197,253,0.10); margin: 4px 0; }
.pv-calc__row--total .pv-calc__row-label { color: var(--pv-accent); text-transform: uppercase; letter-spacing: 0.12em; font-size: 10px; font-weight: 800; }
.pv-calc__row--total .pv-calc__row-value { font-size: 26px; }

.pv-calc__savings {
  display: flex; align-items: center; gap: 12px;
  background: linear-gradient(135deg, rgba(37,211,102,0.18), rgba(37,211,102,0.06));
  border: 1px solid rgba(37,211,102,0.35);
  border-radius: 12px; padding: 12px 14px;
  margin-top: 4px;
}
.pv-calc__savings-icon {
  width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;
  background: rgba(37,211,102,0.25);
  color: #4ADE80;
  display: inline-flex; align-items: center; justify-content: center;
}
.pv-calc__savings-icon [data-lucide] { width: 20px; height: 20px; stroke-width: 2.5; }
.pv-calc__savings-copy { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.pv-calc__savings-label { font-size: 10px; font-weight: 800; letter-spacing: 0.10em; text-transform: uppercase; color: rgba(74,222,128,0.95); }
.pv-calc__savings-value { font-size: 22px; font-weight: 900; color: #fff; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }

.pv-calc__cta { width: 100%; margin-top: 8px; }

/* ====== HOW TO BUY ====== */
/* Mobile-first: stacked, normal scroll. Desktop: scroll-jacked horizontal */
.pv-htb {
  position: relative;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-bg); color: #fff;
}
.pv-htb__sticky {
  position: relative;
  padding: 56px 16px 48px;
  overflow: hidden;
}
.pv-htb__sticky::before {
  content: ""; position: absolute; inset: 0; z-index: 0;
  background:
    radial-gradient(800px 500px at 80% 20%, rgba(24,95,165,0.30) 0%, rgba(10,26,46,0) 60%),
    radial-gradient(600px 400px at 20% 90%, rgba(217,119,6,0.10) 0%, rgba(10,26,46,0) 60%),
    linear-gradient(180deg, var(--pv-bg) 0%, var(--pv-bg-2) 100%);
}
.pv-htb__sticky::after {
  content: ""; position: absolute; inset: 0; z-index: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 56px 56px;
  -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, #000 30%, transparent 100%);
  mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, #000 30%, transparent 100%);
}
.pv-htb__sticky > * { position: relative; z-index: 1; }

.pv-htb__head { text-align: center; max-width: 56ch; margin: 0 auto 28px; display: flex; flex-direction: column; align-items: center; }
.pv-htb__title {
  font-size: clamp(26px, 4.5vw, 40px); font-weight: 900;
  letter-spacing: -0.025em; line-height: 1.1;
  margin: 14px 0 10px; color: #fff; text-wrap: balance;
}
.pv-htb__title-accent {
  color: var(--pv-accent);
  background-image: linear-gradient(180deg, transparent 70%, rgba(147,197,253,.30) 70%, rgba(147,197,253,.30) 92%, transparent 92%);
  background-repeat: no-repeat; padding: 0 4px;
}
.pv-htb__lead { font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.62); margin: 0; max-width: 50ch; line-height: 1.55; }

.pv-htb__progress { display: none; }

/* Mobile: stack panels vertically */
.pv-htb__viewport { width: 100%; }
.pv-htb__track { display: flex; flex-direction: column; gap: 14px; max-width: 720px; margin: 0 auto 28px; }
.pv-htb__panel {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 16px;
  padding: 18px 18px 20px;
  display: flex; flex-direction: column; gap: 10px;
  transition: border-color 240ms var(--pv-ease), background 240ms var(--pv-ease);
}
.pv-htb__panel:hover { border-color: rgba(147,197,253,0.30); background: rgba(255,255,255,0.06); }
.pv-htb__panel-meta { display: flex; align-items: center; gap: 12px; }
.pv-htb__panel-num {
  font-size: 36px; font-weight: 900; line-height: 0.9;
  color: rgba(147,197,253,0.30);
  font-variant-numeric: tabular-nums; letter-spacing: -0.04em;
}
.pv-htb__panel-tag {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(147,197,253,0.30);
  padding: 5px 12px; border-radius: 9999px;
  font-size: 11px; font-weight: 800; color: var(--pv-accent); letter-spacing: 0.04em;
}
.pv-htb__panel-tag [data-lucide] { width: 13px; height: 13px; stroke-width: 2.5; }
.pv-htb__panel-title {
  font-size: clamp(20px, 3.5vw, 30px); font-weight: 900;
  letter-spacing: -0.025em; line-height: 1.1;
  margin: 0; color: #fff; text-wrap: balance; max-width: 22ch;
}
.pv-htb__panel-body {
  font-size: 14px; font-weight: 500; line-height: 1.55;
  color: rgba(255,255,255,0.78); margin: 0; max-width: 50ch;
}
.pv-htb__panel-list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
.pv-htb__panel-list li {
  display: inline-flex; align-items: center; gap: 5px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.12);
  padding: 5px 10px 5px 8px; border-radius: 9999px;
  font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.85);
}
.pv-htb__panel-list [data-lucide] { width: 12px; height: 12px; stroke-width: 3; color: var(--pv-accent); }

.pv-htb__cta { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; max-width: 880px; margin: 0 auto; }
.pv-htb__cta .pv-btn { flex: 1 1 auto; min-width: 0; }
@media (min-width: 480px) { .pv-htb__cta .pv-btn { flex: 0 0 auto; } }

/* Desktop: scroll-jacked horizontal */
@media (min-width: 960px) {
  .pv-htb { height: 400vh; }
  .pv-htb__sticky {
    position: sticky; top: 0; height: 100vh;
    display: flex; flex-direction: column;
    padding: clamp(40px, 7vh, 72px) 16px clamp(32px, 5vh, 48px);
  }
  .pv-htb__progress { display: block; max-width: 880px; width: 100%; margin: 0 auto clamp(24px, 4vh, 40px); padding: 0 24px; }
  .pv-htb__progress-track { position: relative; height: 2px; background: rgba(255,255,255,0.14); border-radius: 2px; }
  .pv-htb__progress-fill {
    position: absolute; top: 0; left: 0; height: 100%; width: 0%;
    background: linear-gradient(90deg, var(--pv-accent) 0%, var(--pv-primary) 100%);
    border-radius: 2px;
    box-shadow: 0 0 12px rgba(147,197,253,0.6);
    transition: width 80ms linear;
  }
  .pv-htb__node { position: absolute; top: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; }
  .pv-htb__node-dot {
    width: 12px; height: 12px;
    background: var(--pv-bg);
    border: 2px solid rgba(255,255,255,0.35);
    border-radius: 50%;
    transition: all 200ms var(--pv-ease);
  }
  .pv-htb__node.is-reached .pv-htb__node-dot { background: var(--pv-accent); border-color: var(--pv-accent); }
  .pv-htb__node.is-active .pv-htb__node-dot {
    background: #fff; border-color: #fff;
    width: 16px; height: 16px;
    box-shadow: 0 0 0 6px rgba(147,197,253,0.25), 0 0 20px rgba(147,197,253,0.6);
  }
  .pv-htb__node-label {
    position: absolute; top: 22px;
    font-size: 10px; font-weight: 800;
    letter-spacing: 0.10em; text-transform: uppercase;
    color: rgba(255,255,255,0.45); white-space: nowrap;
    transition: color 200ms var(--pv-ease);
  }
  .pv-htb__node.is-active .pv-htb__node-label { color: var(--pv-accent); }

  .pv-htb__viewport {
    flex: 1; width: 100%; overflow: hidden;
    position: relative; display: flex; align-items: center;
    margin-bottom: clamp(20px, 3vh, 32px);
  }
  .pv-htb__track {
    flex-direction: row; gap: 0;
    display: flex; width: 400%;
    transform: translateX(0%);
    transition: transform 400ms cubic-bezier(.22,.61,.36,1);
    will-change: transform; max-width: none; margin: 0;
  }
  .pv-htb__panel {
    flex: 0 0 25%; max-width: 100%;
    background: transparent; border: none; padding: 0 clamp(16px, 4vw, 56px);
    opacity: 0.25; transition: opacity 400ms var(--pv-ease);
    justify-content: center;
  }
  .pv-htb__panel:hover { background: transparent; }
  .pv-htb__panel.is-active { opacity: 1; }
  .pv-htb__panel-num { font-size: clamp(48px, 8vw, 88px); }
  .pv-htb__panel-meta { margin-bottom: 8px; }
}

/* ====== FAQ ====== */
.pv-faq {
  position: relative; overflow: hidden;
  width: 100vw; margin-left: calc(-50vw + 50%);
