{% comment %}
========================================================================
PROVENZANO HOME v4 — WebGL + Lenis + GSAP + custom cursor
========================================================================
Stack:
- Three.js (shader hero background)
- GSAP + ScrollTrigger (animaciones + horizontal scroll pinned)
- Lenis (smooth scroll inercial)
- Custom cursor desktop
- Mobile-first, fallbacks limpios

Mobile (90% del tráfico): shader simplificado, sin cursor custom,
sin smooth scroll forzado (ya viene smooth nativo iOS/Android).
========================================================================
{% endcomment %}

{% schema %}
{
  "name": "Home Provenzano",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "logo_url", "label": "URL del logo", "default": "https://cdn.shopify.com/s/files/1/0729/9366/9368/files/provenzano-logo.svg?v=1777313813" },
    { "type": "text", "id": "wpp_phone", "label": "WhatsApp", "default": "5491141794592" },
    { "type": "collection", "id": "featured_collection", "label": "Productos destacados (8)" }
  ],
  "presets": [{ "name": "Home Provenzano" }]
}
{% endschema %}

{%- assign logo_url = section.settings.logo_url | default: 'https://cdn.shopify.com/s/files/1/0729/9366/9368/files/provenzano-logo.svg?v=1777313813' -%}
{%- assign wpp_phone = section.settings.wpp_phone | default: '5491141794592' -%}
{%- assign featured_products = section.settings.featured_collection.products | default: collections['destacados'].products -%}

<div class="pv">

  {%- comment -%} ============ CUSTOM CURSOR (desktop) ============ {%- endcomment -%}
  <div class="pv-cursor" id="provCursor" aria-hidden="true">
    <span class="pv-cursor__dot"></span>
    <span class="pv-cursor__ring"></span>
  </div>
  {%- comment -%} ============ HERO ============ {%- endcomment -%}
  <header class="pv-hero" id="provHero">

    {%- comment -%} WebGL canvas (shader) {%- endcomment -%}
    <canvas class="pv-hero__canvas" id="provHeroCanvas" aria-hidden="true"></canvas>
    <div class="pv-hero__veil" aria-hidden="true"></div>
    <div class="pv-hero__grain" aria-hidden="true"></div>

    {%- comment -%} Nav {%- endcomment -%}
    <nav class="pv-nav pv-wrap">
      <a href="/" class="pv-nav__brand" data-cursor="link" aria-label="Provenzano">
        <span class="pv-nav__mark"><img src="{{ logo_url }}" alt=""></span>
        <span class="pv-nav__name">Provenzano<sup class="pv-nav__sup">®</sup></span>
      </a>
      <div class="pv-nav__meta">
        <span><span class="pv-nav__live"></span>Liniers, CABA</span>
        <span class="pv-nav__sep">/</span>
        <span>Est. 2003</span>
      </div>
      <div class="pv-nav__actions">
        <a href="/search" class="pv-nav__btn" data-cursor="link" aria-label="Buscar"><i data-lucide="search"></i></a>
        <a href="/cart" class="pv-nav__btn" data-cursor="link" aria-label="Carrito">
          <i data-lucide="shopping-cart"></i>
          <span class="pv-nav__badge" id="provCartBadge" style="display:none">0</span>
        </a>
      </div>
    </nav>

    {%- comment -%} Hero copy {%- endcomment -%}
    <div class="pv-hero__inner pv-wrap">

      <div class="pv-hero__top">
        <span class="pv-label">01 — Mayorista de kiosco</span>
        <span class="pv-hero__chip">
          <span class="pv-hero__chip-dot"></span>
          <span class="pv-hero__chip-text">DESPACHANDO AHORA</span>
        </span>
      </div>

      <h1 class="pv-hero__title">
        <span class="pv-hero__line"><span class="pv-hero__word">Tu</span> <span class="pv-hero__word">mayorista</span></span>
        <span class="pv-hero__line"><span class="pv-hero__word">de</span> <span class="pv-hero__word pv-hero__word--ital">toda</span></span>
        <span class="pv-hero__line"><span class="pv-hero__word pv-hero__word--ital">la</span> <span class="pv-hero__word pv-hero__word--ital">vida</span><span class="pv-hero__period">.</span></span>
      </h1>

      <div class="pv-hero__bottom">
        <p class="pv-hero__lead">
          Abastecemos kioscos, almacenes y revendedores desde Liniers, CABA. Catálogo de <b>216+ productos</b> con precios mayoristas <b>actualizados todos los días</b>.
        </p>
        <div class="pv-hero__ctas">
          <a href="#provCatalog" class="pv-btn pv-btn--xxl" data-cursor="cta">
            <span>Armá tu pedido</span>
            <i data-lucide="arrow-down-right"></i>
          </a>
          <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola Provenzano, quiero hacer una consulta' | url_encode }}" target="_blank" rel="noopener" class="pv-hero__wa" data-cursor="link">
            <span class="pv-hero__wa-dot"></span>
            <span class="pv-hero__wa-meta">
              <span class="pv-hero__wa-mini">o consultanos</span>
              <span class="pv-hero__wa-num">+54 9 11 4179-4592</span>
            </span>
          </a>
        </div>
      </div>

      <a href="#provIntro" class="pv-hero__scroll" aria-label="Bajar" data-cursor="link">
        <span class="pv-hero__scroll-track"><span class="pv-hero__scroll-dot"></span></span>
        <span class="pv-hero__scroll-text">Scroll</span>
      </a>
    </div>
  </header>
  {%- comment -%} ============ STATS TICKER ============ {%- endcomment -%}
  <section class="pv-tick" aria-hidden="true">
    <div class="pv-tick__track">
      <span class="pv-tick__num"><span data-counter="216">216</span><i>+</i></span><span class="pv-tick__lab">productos</span>
      <span class="pv-tick__sep">/</span>
      <span class="pv-tick__num"><span data-counter="20">20</span><i>+</i></span><span class="pv-tick__lab">años en Liniers</span>
      <span class="pv-tick__sep">/</span>
      <span class="pv-tick__num"><span data-counter="24">24</span></span><span class="pv-tick__lab">provincias</span>
      <span class="pv-tick__sep">/</span>
      <span class="pv-tick__num">A<i>/</i>B</span><span class="pv-tick__lab">factura</span>
      <span class="pv-tick__sep">/</span>
      <span class="pv-tick__num">5</span><span class="pv-tick__lab">marcas oficiales</span>
      <span class="pv-tick__sep">/</span>
      <span class="pv-tick__num"><span data-counter="216">216</span><i>+</i></span><span class="pv-tick__lab">productos</span>
      <span class="pv-tick__sep">/</span>
      <span class="pv-tick__num"><span data-counter="20">20</span><i>+</i></span><span class="pv-tick__lab">años en Liniers</span>
      <span class="pv-tick__sep">/</span>
      <span class="pv-tick__num"><span data-counter="24">24</span></span><span class="pv-tick__lab">provincias</span>
      <span class="pv-tick__sep">/</span>
      <span class="pv-tick__num">A<i>/</i>B</span><span class="pv-tick__lab">factura</span>
      <span class="pv-tick__sep">/</span>
      <span class="pv-tick__num">5</span><span class="pv-tick__lab">marcas oficiales</span>
      <span class="pv-tick__sep">/</span>
    </div>
  </section>
  {%- comment -%} ============ INTRO / SOBRE ============ {%- endcomment -%}
  <section class="pv-intro" id="provIntro">
    <div class="pv-wrap pv-intro__inner">

      <aside class="pv-intro__aside">
        <span class="pv-label">02 — Sobre Provenzano</span>
        <span class="pv-intro__aside-text">
          Provenzano S.R.L.<br>
          Carhué 74, Liniers<br>
          CABA, Argentina<br>
          <span style="opacity:.5">— 2003 / 2026</span>
        </span>
      </aside>

      <div class="pv-intro__main">
        <h2 class="pv-intro__title">
          <span class="pv-intro__line"><span class="pv-intro__word">Dos</span> <span class="pv-intro__word">décadas</span></span>
          <span class="pv-intro__line"><span class="pv-intro__word">abasteciendo</span></span>
          <span class="pv-intro__line"><span class="pv-intro__word">a</span> <span class="pv-intro__word">los</span> <span class="pv-intro__word pv-intro__word--ital">que</span></span>
          <span class="pv-intro__line"><span class="pv-intro__word pv-intro__word--ital">venden</span> <span class="pv-intro__word pv-intro__word--ital">al</span> <span class="pv-intro__word pv-intro__word--ital">barrio</span><span class="pv-intro__period">.</span></span>
        </h2>

        <p class="pv-intro__body pv-rev">
          Empezamos en Liniers en 2003. Hoy abastecemos a kioscos, almacenes y revendedores de todo el país con <b>las primeras marcas</b> al precio mayorista que necesitan para hacer rotar su negocio.
        </p>

        <div class="pv-intro__pillars pv-rev">
          <div class="pv-intro__pillar">
            <span class="pv-intro__pillar-num">01</span>
            <h4 class="pv-intro__pillar-h">Stock real</h4>
            <p class="pv-intro__pillar-p">Lo que ves está en bodega. Sin sorpresas.</p>
          </div>
          <div class="pv-intro__pillar">
            <span class="pv-intro__pillar-num">02</span>
            <h4 class="pv-intro__pillar-h">Precios al día</h4>
            <p class="pv-intro__pillar-p">Actualizados todos los días. Sin chamuyo.</p>
          </div>
          <div class="pv-intro__pillar">
            <span class="pv-intro__pillar-num">03</span>
            <h4 class="pv-intro__pillar-h">Sin mínimos rígidos</h4>
            <p class="pv-intro__pillar-p">Comprás desde 1 bulto. Reponés cuando querés.</p>
          </div>
          <div class="pv-intro__pillar">
            <span class="pv-intro__pillar-num">04</span>
            <h4 class="pv-intro__pillar-h">Asesor real</h4>
            <p class="pv-intro__pillar-p">Te atiende un humano por WhatsApp. No bots.</p>
          </div>
        </div>
      </div>

    </div>
  </section>
  {%- comment -%} ============ CATALOG (horizontal scroll pinned) ============ {%- endcomment -%}
  <section class="pv-cat" id="provCatalog">

    <div class="pv-wrap pv-cat__head">
      <div class="pv-cat__head-l">
        <span class="pv-label">03 — Catálogo en vivo</span>
        <span class="pv-cat__live"><span class="pv-cat__live-dot"></span>Stock real · precios al día</span>
      </div>
      <h2 class="pv-cat__title">
        <span class="pv-cat__line"><span class="pv-cat__word">Mirá.</span></span>
        <span class="pv-cat__line"><span class="pv-cat__word">Elegí.</span></span>
        <span class="pv-cat__line"><span class="pv-cat__word pv-cat__word--ital">Armá</span> <span class="pv-cat__word pv-cat__word--ital">tu</span> <span class="pv-cat__word pv-cat__word--ital">pedido</span><span class="pv-cat__period">.</span></span>
      </h2>
    </div>

    <div class="pv-cat__pin" id="provCatPin">
      <div class="pv-cat__track" id="provCatTrack">

        <div class="pv-cat__card pv-cat__card--first">
          <span class="pv-cat__first-eye">Catálogo</span>
          <span class="pv-cat__first-num"><span data-counter="216">216</span><i>+</i></span>
          <span class="pv-cat__first-lab">productos · listos para despacho</span>
          <span class="pv-cat__first-arrow"><i data-lucide="arrow-right"></i></span>
        </div>

        {% if featured_products.size > 0 %}
          {% for product in featured_products limit: 8 %}
            {% assign units = product.metafields.custom.bulk_units | default: 0 %}
            {% assign sku_num = forloop.index | prepend: '00' | slice: -3, 3 %}
            <a href="{{ product.url }}" class="pv-prod" data-cursor="link">
              <span class="pv-prod__num">{{ sku_num }}</span>
              <span class="pv-prod__live"><span class="pv-prod__live-dot"></span>EN STOCK</span>
              <div class="pv-prod__img">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '500x500' }}" alt="{{ product.title }}" loading="lazy">
                {% endif %}
              </div>
              <div class="pv-prod__meta">
                {% if product.type and product.type != '' %}<span class="pv-prod__cat">{{ product.type }}</span>{% endif %}
                <h3 class="pv-prod__name">{{ product.title }}</h3>
              </div>
              <div class="pv-prod__foot">
                <span class="pv-prod__price-block">
                  <span class="pv-prod__price-eye">Mayorista</span>
                  <span class="pv-prod__price">{{ product.price | money }}</span>
                </span>
                {% if units > 0 %}<span class="pv-prod__bulk">x{{ units }}</span>{% endif %}
              </div>
              <span class="pv-prod__arrow"><i data-lucide="arrow-up-right"></i></span>
            </a>
          {% endfor %}
        {% endif %}

        <a href="/collections/all" class="pv-cat__card pv-cat__card--cta" data-cursor="cta">
          <div class="pv-cat__cta-top">
            <span class="pv-cat__cta-eye">Próximo paso</span>
            <span class="pv-cat__cta-mini">04</span>
          </div>
          <div class="pv-cat__cta-text">
            <span>Armá</span>
            <span class="pv-cat__cta-ital">tu pedido</span>
            <span>completo<span class="pv-cat__cta-period">.</span></span>
          </div>
          <div class="pv-cat__cta-foot">
            <span class="pv-cat__cta-mini-2">Ver los <span data-counter="216">216</span>+ productos</span>
            <span class="pv-cat__cta-arrow"><i data-lucide="arrow-right"></i></span>
          </div>
        </a>

      </div>
    </div>

  </section>
  {%- comment -%} ============ BRANDS ============ {%- endcomment -%}
  <section class="pv-brands" aria-label="Marcas oficiales">
    <span class="pv-brands__lab">Trabajamos con marcas oficiales</span>
    <div class="pv-brands__marquee">
      <ul class="pv-brands__track">
        <li>Energizer</li><li class="pv-brands__sep">✱</li>
        <li>Duracell</li><li class="pv-brands__sep">✱</li>
        <li>Gillette</li><li class="pv-brands__sep">✱</li>
        <li>Candela</li><li class="pv-brands__sep">✱</li>
        <li>BIC</li><li class="pv-brands__sep">✱</li>
        <li aria-hidden="true">Energizer</li><li class="pv-brands__sep" aria-hidden="true">✱</li>
        <li aria-hidden="true">Duracell</li><li class="pv-brands__sep" aria-hidden="true">✱</li>
        <li aria-hidden="true">Gillette</li><li class="pv-brands__sep" aria-hidden="true">✱</li>
        <li aria-hidden="true">Candela</li><li class="pv-brands__sep" aria-hidden="true">✱</li>
        <li aria-hidden="true">BIC</li><li class="pv-brands__sep" aria-hidden="true">✱</li>
      </ul>
    </div>
  </section>
  {%- comment -%} ============ SHIPPING ============ {%- endcomment -%}
  <section class="pv-ship" id="provShip">
    <div class="pv-wrap">

      <header class="pv-ship__head">
        <span class="pv-label">04 — Envíos</span>
        <h2 class="pv-ship__title">
          <span class="pv-ship__line"><span class="pv-ship__word">Llegamos</span></span>
          <span class="pv-ship__line"><span class="pv-ship__word">donde</span> <span class="pv-ship__word pv-ship__word--ital">estés</span><span class="pv-ship__period">.</span></span>
        </h2>
        <p class="pv-ship__lead pv-rev">Cuatro formas de recibir tu pedido. Todas claras, sin letra chica.</p>
      </header>

      <div class="pv-ship__cards">
        <article class="pv-ship__card pv-rev">
          <div class="pv-ship__card-top"><span class="pv-ship__card-num">01</span><span class="pv-ship__card-icon"><i data-lucide="store"></i></span></div>
          <h3 class="pv-ship__card-title">Retiro<br>en sucursal</h3>
          <span class="pv-ship__card-big pv-ship__card-big--free">Sin costo</span>
          <span class="pv-ship__card-min">Mín. $100.000</span>
          <ul class="pv-ship__card-list">
            <li><span>Dirección</span><span>Carhué 74, Liniers</span></li>
            <li><span>Días</span><span>Lunes a sábado</span></li>
            <li><span>Coordinación</span><span>Por WhatsApp</span></li>
          </ul>
        </article>

        <article class="pv-ship__card pv-ship__card--feat pv-rev">
          <div class="pv-ship__card-top"><span class="pv-ship__card-num">02</span><span class="pv-ship__card-icon"><i data-lucide="truck"></i></span></div>
          <h3 class="pv-ship__card-title">CABA<br>y GBA</h3>
          <span class="pv-ship__card-big">Desde $4.100</span>
          <span class="pv-ship__card-min">GRATIS desde $600.000 · Mín. $100.000</span>
          <ul class="pv-ship__card-list">
            <li><span>Despacho</span><span>Mar. y jue.</span></li>
            <li><span>Salida</span><span>14 hs</span></li>
            <li><span>Llegada</span><span>14 a 21 hs</span></li>
          </ul>
          <a href="#provZones" class="pv-ship__card-link" data-cursor="link">Ver zonas y precios <i data-lucide="arrow-down"></i></a>
        </article>

        <article class="pv-ship__card pv-rev">
          <div class="pv-ship__card-top"><span class="pv-ship__card-num">03</span><span class="pv-ship__card-icon"><i data-lucide="map"></i></span></div>
          <h3 class="pv-ship__card-title">Envío al<br>interior</h3>
          <span class="pv-ship__card-big">Vía cargo</span>
          <span class="pv-ship__card-min">Mín. $200.000 · 24 provincias</span>
          <ul class="pv-ship__card-list">
            <li><span>Tiempo</span><span>2 a 7 días hábiles</span></li>
            <li><span>Flete</span><span>Lo paga el cliente</span></li>
            <li><span>Coordinación</span><span>WhatsApp</span></li>
          </ul>
        </article>

        <article class="pv-ship__card pv-rev">
          <div class="pv-ship__card-top"><span class="pv-ship__card-num">04</span><span class="pv-ship__card-icon"><i data-lucide="handshake"></i></span></div>
          <h3 class="pv-ship__card-title">Tu transporte<br>o comisionista</h3>
          <span class="pv-ship__card-big pv-ship__card-big--free">Sin costo</span>
          <span class="pv-ship__card-min">Mín. $500.000</span>
          <ul class="pv-ship__card-list">
            <li><span>Retiro</span><span>Carhué 74, Liniers</span></li>
            <li><span>Días</span><span>Lunes a sábado</span></li>
            <li><span>Coordinación</span><span>WhatsApp</span></li>
          </ul>
        </article>
      </div>

      {%- comment -%} ZONAS GBA {%- endcomment -%}
      <div class="pv-zones" id="provZones">
        <header class="pv-zones__head pv-rev">
          <span class="pv-label">02.1 — Zonas y precios CABA / GBA</span>
          <p class="pv-zones__hint">Tocá tu zona para ver los partidos.</p>
        </header>

        <div class="pv-zones__list">
          <details class="pv-zone pv-zone--caba pv-rev" open>
            <summary class="pv-zone__sum" data-cursor="link">
              <span class="pv-zone__name">CABA</span>
              <span class="pv-zone__price">$4.100</span>
              <span class="pv-zone__cap">Toda la Capital Federal</span>
              <span class="pv-zone__chev"><i data-lucide="chevron-down"></i></span>
            </summary>
            <div class="pv-zone__body"><span class="pv-zone__partidos">Toda la Ciudad Autónoma de Buenos Aires.</span></div>
          </details>
          <details class="pv-zone pv-zone--g1 pv-rev">
            <summary class="pv-zone__sum" data-cursor="link">
              <span class="pv-zone__name">GBA <em>1</em></span>
              <span class="pv-zone__price">$5.000</span>
              <span class="pv-zone__cap">9 partidos</span>
              <span class="pv-zone__chev"><i data-lucide="chevron-down"></i></span>
            </summary>
            <div class="pv-zone__body"><span class="pv-zone__partidos">Avellaneda · Lanús · Lomas de Zamora · La Matanza Norte · Morón · 3 de Febrero · San Martín · Vicente López · San Isidro</span></div>
          </details>
          <details class="pv-zone pv-zone--g2 pv-rev">
            <summary class="pv-zone__sum" data-cursor="link">
              <span class="pv-zone__name">GBA <em>2</em></span>
              <span class="pv-zone__price">$6.000</span>
              <span class="pv-zone__cap">16 partidos</span>
              <span class="pv-zone__chev"><i data-lucide="chevron-down"></i></span>
            </summary>
            <div class="pv-zone__body"><span class="pv-zone__partidos">San Fernando · Tigre · Malvinas Argentinas · José C. Paz · San Miguel · Hurlingham · Ituzaingó · La Matanza Sur · Merlo · Moreno · Esteban Echeverría · Almirante Brown · Ezeiza · Quilmes · Florencio Varela · Berazategui</span></div>
          </details>
          <details class="pv-zone pv-zone--g3 pv-rev">
            <summary class="pv-zone__sum" data-cursor="link">
              <span class="pv-zone__name">GBA <em>3</em></span>
              <span class="pv-zone__price">$7.900</span>
              <span class="pv-zone__cap">19 partidos</span>
              <span class="pv-zone__chev"><i data-lucide="chevron-down"></i></span>
            </summary>
            <div class="pv-zone__body"><span class="pv-zone__partidos">Zárate · Campana · Escobar · Ing. Maschwitz · Garín · Pilar · Del Viso · Derqui · Villa Rosa · Luján · Gral. Rodríguez · Marcos Paz · Nordelta · San Vicente · Guernica · Berisso · La Plata · Cañuelas · Ensenada</span></div>
          </details>
        </div>

        <p class="pv-zones__note pv-rev">¿No estás seguro de tu zona? <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola, soy de [tu zona] y quiero saber el costo de envio' | url_encode }}" target="_blank" rel="noopener" data-cursor="link">Escribinos por WhatsApp</a> y te confirmamos en el día.</p>
      </div>

    </div>
  </section>
  {%- comment -%} ============ CONTACT ============ {%- endcomment -%}
  <section class="pv-contact" id="provContact">
    <div class="pv-wrap">

      <header class="pv-contact__head">
        <span class="pv-label">05 — Contacto</span>
        <h2 class="pv-contact__title">
          <span class="pv-contact__line"><span class="pv-contact__word">Vení.</span></span>
          <span class="pv-contact__line"><span class="pv-contact__word pv-contact__word--ital">O escribí.</span></span>
        </h2>
      </header>

      <div class="pv-contact__grid">
        <div class="pv-contact__addr pv-rev">
          <span class="pv-contact__addr-eye">Sucursal</span>
          <a href="https://www.google.com/maps/search/?api=1&query=Carh%C3%BA%C3%A9+74+Liniers+CABA" target="_blank" rel="noopener" class="pv-contact__addr-line" data-cursor="link">Carhué 74</a>
          <span class="pv-contact__addr-sub">Liniers, CABA</span>
          <ul class="pv-contact__list">
            <li><span>Horario</span><span>L-V 8:30 a 16 hs</span></li>
            <li><span>Sábados</span><span>A coordinar</span></li>
