  background-repeat: no-repeat; padding: 0 4px;
}
.pv-shelf__lead { font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.62); margin: 0; line-height: 1.55; max-width: 50ch; }

.pv-shelf__counter {
