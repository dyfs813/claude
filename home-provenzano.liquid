/* ====== ACCESIBILIDAD ====== */
@media (prefers-reduced-motion: reduce) {
  .pv-home-root *, .pv-home-root *::before, .pv-home-root *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
</style>

<script>
(function () {
  'use strict';

  // === Counter animado ===
  function animateCounter(el, target, duration, suffix) {
    var start = null;
    function tick(t) {
      if (!start) start = t;
      var progress = Math.min((t - start) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      var current = Math.round(target * eased);
      el.textContent = current + (suffix || '');
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  function initCounters() {
    var counters = document.querySelectorAll('.pv-home-root [data-counter]');
    if (!('IntersectionObserver' in window)) {
      counters.forEach(function (el) {
        var t = parseInt(el.dataset.counter, 10) || 0;
        animateCounter(el, t, 1800, el.dataset.suffix || '');
      });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          var el = e.target;
          var t = parseInt(el.dataset.counter, 10) || 0;
          animateCounter(el, t, 1600, el.dataset.suffix || '');
          io.unobserve(el);
        }
      });
    }, { threshold: 0.4 });
    counters.forEach(function (el) { io.observe(el); });
  }

  // === Header scroll-aware ===
  function initHeaderScroll() {
    var header = document.getElementById('provHeader');
    if (!header) return;
    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        if (window.scrollY > 8) header.classList.add('is-scrolled');
        else header.classList.remove('is-scrolled');
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // === Hero parallax sutil con mouse (solo desktop, sin reduced-motion) ===
  function initHeroTilt() {
    var stage = document.getElementById('provHeroStage');
    if (!stage) return;
    if (window.matchMedia('(max-width: 720px)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    stage.addEventListener('mousemove', function (e) {
      var rect = stage.getBoundingClientRect();
      var x = (e.clientX - rect.left) / rect.width  - 0.5;
      var y = (e.clientY - rect.top)  / rect.height - 0.5;
      stage.style.setProperty('--tilt-x', (y * -6) + 'px');
      stage.style.setProperty('--tilt-y', (x *  10) + 'px');
    });
    stage.addEventListener('mouseleave', function () {
      stage.style.setProperty('--tilt-x', '0px');
      stage.style.setProperty('--tilt-y', '0px');
    });
  }

  // === Orbit pause on hover + HUD update ===
  function initOrbit() {
    var stage = document.getElementById('provOrbitStage');
    var ring  = document.getElementById('provOrbitRing');
    var hud   = document.getElementById('provOrbitHudValue');
    if (!stage || !ring || !hud) return;
    var defaultText = hud.textContent;
    var pins = ring.querySelectorAll('.pv-orbit__pin');
    function setActive(pin) {
      pins.forEach(function (p) { p.classList.remove('is-active'); });
      if (!pin) { hud.textContent = defaultText; return; }
      pin.classList.add('is-active');
      var name = pin.querySelector('.pv-orbit__pin-name');
      if (name) hud.textContent = name.textContent;
    }
    stage.addEventListener('mouseenter', function () { stage.classList.add('is-paused'); });
    stage.addEventListener('mouseleave', function () { stage.classList.remove('is-paused'); setActive(null); });
    pins.forEach(function (pin) {
      pin.addEventListener('mouseenter', function () { setActive(pin); });
      pin.addEventListener('focus', function () { setActive(pin); stage.classList.add('is-paused'); });
      pin.addEventListener('blur', function () { stage.classList.remove('is-paused'); setActive(null); });
    });
  }

  // === Cart badge ===
  function updateCartBadge() {
    var badge = document.getElementById('provCartBadge');
    if (!badge) return;
    fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
      if (cart && cart.item_count > 0) {
        badge.textContent = cart.item_count;
        badge.style.display = 'inline-flex';
      } else {
        badge.style.display = 'none';
      }
    }).catch(function () {});
  }

  // === How To Buy: scroll-jacked solo en desktop (>= 960px) ===
  function initHtbScroll() {
    var section = document.getElementById('provHtb');
    var track   = document.getElementById('provHtbTrack');
    var fill    = document.getElementById('provHtbFill');
    if (!section || !track || !fill) return;

    var nodes  = section.querySelectorAll('.pv-htb__node');
    var panels = section.querySelectorAll('.pv-htb__panel');
    var ticking = false;
    var mql = window.matchMedia('(min-width: 960px)');

    function reset() {
      track.style.transform = '';
      fill.style.width = '';
      nodes.forEach(function (n) { n.classList.remove('is-reached', 'is-active'); });
      panels.forEach(function (p) { p.classList.remove('is-active'); });
    }

    function update() {
      ticking = false;
      if (!mql.matches) { reset(); return; }
      var rect = section.getBoundingClientRect();
      var total = section.offsetHeight - window.innerHeight;
      if (total <= 0) return;
      var raw = (-rect.top) / total;
      var progress = Math.max(0, Math.min(1, raw));
      track.style.transform = 'translateX(' + (-progress * 75) + '%)';
      fill.style.width = (progress * 100) + '%';
      var idx = Math.min(3, Math.floor(progress * 4));
      nodes.forEach(function (n, i) {
        n.classList.toggle('is-reached', i <= idx);
        n.classList.toggle('is-active',  i === idx);
      });
      panels.forEach(function (p, i) {
        p.classList.toggle('is-active', i === idx);
      });
    }

    function onScroll() {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    if (mql.addEventListener) mql.addEventListener('change', onScroll);
    update();
  }

  // === Calculadora de bulto ===
  function initCalc() {
    var root = document.getElementById('provCalc');
    if (!root) return;
    var slider   = document.getElementById('provCalcSlider');
    var bultosEl = document.getElementById('provCalcBultos');
    var unitsEl  = document.getElementById('provCalcUnidades');
    var punitEl  = document.getElementById('provCalcPunit');
    var totalEl  = document.getElementById('provCalcTotal');
    var savEl    = document.getElementById('provCalcAhorro');
    if (!slider) return;

    var unitsPerBulto = parseInt(root.dataset.units, 10) || 50;
    var pmay          = parseFloat(root.dataset.pmay)   || 0;
    var pmin          = parseFloat(root.dataset.pmin)   || 0;

    var fmtMoney = (function () {
      try {
        var f = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 });
        return function (n) { return f.format(n); };
      } catch (e) {
        return function (n) { return '$' + Math.round(n).toLocaleString('es-AR'); };
      }
    })();

    function pct(v) {
      var min = parseFloat(slider.min) || 1;
      var max = parseFloat(slider.max) || 20;
      return ((v - min) / (max - min)) * 100;
    }

    function render() {
      var bultos = parseInt(slider.value, 10) || 1;
      var units  = bultos * unitsPerBulto;
      var total  = units * pmay;
      var minTot = units * pmin;
      var sav    = Math.max(0, minTot - total);
      bultosEl.textContent = bultos;
      unitsEl.textContent  = units.toLocaleString('es-AR');
      punitEl.textContent  = fmtMoney(pmay);
      totalEl.textContent  = fmtMoney(total);
      savEl.textContent    = fmtMoney(sav);
      slider.style.setProperty('--pv-calc-pct', pct(bultos) + '%');
    }

    slider.addEventListener('input', render);
    root.querySelectorAll('.pv-calc__step').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var step = parseInt(btn.dataset.step, 10) || 0;
        var min = parseFloat(slider.min) || 1;
        var max = parseFloat(slider.max) || 20;
        var v = Math.max(min, Math.min(max, (parseInt(slider.value, 10) || 1) + step));
        slider.value = v;
        render();
      });
    });
    render();
  }

  function init() {
    initCounters();
    initHeaderScroll();
    initHeroTilt();
    initOrbit();
    updateCartBadge();
    initHtbScroll();
    initCalc();
    if (window.lucide && typeof window.lucide.createIcons === 'function') {
      window.lucide.createIcons();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
