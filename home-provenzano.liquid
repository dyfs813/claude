<style>
/* ============================================================
   PROVENZANO v6 — LINGO style
   ============================================================ */
.pv, .pv *, .pv *::before, .pv *::after { box-sizing: border-box; }
.pv [data-lucide] { width: 18px; height: 18px; stroke-width: 2; flex-shrink: 0; }
.pv img { max-width: 100%; }

.pv {
  /* Paleta Provenzano */
  --pv-primary:      #185FA5;
  --pv-primary-dk:   #0C447C;
  --pv-primary-lt:   #93C5FD;
  --pv-primary-sub:  #E6F1FB;
  --pv-success:      #10B981;
  --pv-success-dk:   #047857;
  --pv-warning:      #F59E0B;
  --pv-warning-dk:   #B45309;
  --pv-danger:       #DC2626;
  --pv-danger-dk:    #991B1B;
  --pv-wa:           #25D366;
  --pv-wa-dk:        #1A9B4A;

  --pv-white:    #FFFFFF;
  --pv-g100:     #F4F4F5;
  --pv-g200:     #E5E7EB;
  --pv-g300:     #D1D5DB;
  --pv-g500:     #71717A;
  --pv-g700:     #52525B;
  --pv-black:    #0A0A0A;

  /* Lingo signature: bottom-border 3D */
  --pv-r:    18px;
  --pv-r-sm: 12px;
  --pv-r-lg: 24px;
  --pv-r-pill: 9999px;
  --pv-edge: 4px;

  --pv-font: 'Nunito', system-ui, -apple-system, sans-serif;
  --pv-mono: 'JetBrains Mono', 'SF Mono', Consolas, monospace;
  --pv-ease: cubic-bezier(.2,.7,.3,1);
  --pv-ease-out: cubic-bezier(.16,1,.3,1);

  font-family: var(--pv-font);
  font-weight: 600;
  color: var(--pv-black);
  background: var(--pv-primary-sub);
  line-height: 1.5;
}

.pv :focus-visible { outline: 3px solid var(--pv-primary); outline-offset: 4px; border-radius: 8px; }

/* Container */
.pv-wrap { max-width: 1280px; margin: 0 auto; padding: 0 16px; }
@media (min-width: 760px) { .pv-wrap { padding: 0 28px; } }
@media (min-width: 1100px) { .pv-wrap { padding: 0 48px; } }

/* === LINGO BUTTON: 3D tactile === */
.pv-btn {
  position: relative;
  display: inline-flex; align-items: center; justify-content: center;
  gap: 10px;
  padding: 14px 24px;
  border-radius: var(--pv-r);
  border: 2px solid currentColor;
  border-bottom-width: 6px;
  font-family: var(--pv-font);
  font-size: 14px; font-weight: 800;
  letter-spacing: 0.04em; text-transform: uppercase;
  text-decoration: none; cursor: pointer; white-space: nowrap;
  background: var(--pv-primary); color: var(--pv-white); border-color: var(--pv-primary-dk);
  transition: transform 80ms var(--pv-ease), border-bottom-width 80ms var(--pv-ease), filter 200ms var(--pv-ease);
  user-select: none;
}
.pv-btn:hover { filter: brightness(1.06); }
.pv-btn:active {
  transform: translateY(4px);
  border-bottom-width: 2px;
}
.pv-btn--lg { padding: 18px 28px; font-size: 15px; border-radius: var(--pv-r-lg); }
.pv-btn--xl { padding: 22px 32px; font-size: 16px; border-radius: var(--pv-r-lg); border-bottom-width: 8px; }
.pv-btn--xl:active { transform: translateY(6px); border-bottom-width: 2px; }
.pv-btn [data-lucide] { width: 18px; height: 18px; }

.pv-btn--white { background: var(--pv-white); color: var(--pv-black); border-color: var(--pv-g300); }
.pv-btn--wa    { background: var(--pv-wa); color: #052E12; border-color: var(--pv-wa-dk); }
.pv-btn--success { background: var(--pv-success); color: var(--pv-white); border-color: var(--pv-success-dk); }

/* Reveal */
.pv-rev { opacity: 0; transform: translateY(20px); }
.pv-rev.is-in { opacity: 1; transform: translateY(0); transition: opacity 600ms var(--pv-ease-out), transform 600ms var(--pv-ease-out); }

/* Section label */
.pv-sec-label {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--pv-white);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 4px;
  padding: 8px 16px;
  border-radius: var(--pv-r-pill);
  font-size: 11px; font-weight: 800;
  letter-spacing: 0.10em; text-transform: uppercase;
  color: var(--pv-primary);
}
.pv-sec-label::before {
  content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--pv-primary);
  box-shadow: 0 0 0 3px rgba(24,95,165,0.2);
}

/* Section title */
.pv-sec-title {
  font-size: clamp(36px, 6vw, 64px);
  font-weight: 900; letter-spacing: -0.025em;
  line-height: 1.0;
  margin: 12px 0 0; color: var(--pv-black);
  text-wrap: balance;
}
.pv-sec-title em { font-style: italic; color: var(--pv-primary); }

/* ====== HERO ====== */
.pv-hero {
  position: relative;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-primary-sub);
  padding-bottom: 64px;
  overflow: hidden;
}
.pv-hero::before, .pv-hero::after {
  content: ""; position: absolute; border-radius: 50%;
  filter: blur(60px); opacity: 0.5; pointer-events: none;
}
.pv-hero::before { width: 320px; height: 320px; background: var(--pv-primary-lt); top: -80px; left: -60px; }
.pv-hero::after  { width: 280px; height: 280px; background: var(--pv-warning); top: 20%; right: -60px; opacity: 0.30; }

/* Nav */
.pv-nav {
  position: relative; z-index: 4;
  display: flex; align-items: center; justify-content: space-between; gap: 14px;
  padding-top: 18px; padding-bottom: 18px;
}
.pv-nav__brand {
  display: inline-flex; align-items: center; gap: 12px;
  text-decoration: none; color: var(--pv-black);
  background: var(--pv-white);
  padding: 8px 16px 8px 8px;
  border-radius: var(--pv-r-pill);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 4px;
  transition: transform 80ms var(--pv-ease), border-bottom-width 80ms var(--pv-ease);
}
.pv-nav__brand:active { transform: translateY(2px); border-bottom-width: 2px; }
.pv-nav__mark {
  width: 38px; height: 38px; border-radius: 50%;
  background: var(--pv-primary);
  display: inline-flex; align-items: center; justify-content: center;
  padding: 8px;
  border: 2px solid var(--pv-primary-dk);
  border-bottom-width: 4px;
}
.pv-nav__mark img { width: 100%; height: 100%; object-fit: contain; filter: brightness(0) invert(1); }
.pv-nav__txt { display: flex; flex-direction: column; line-height: 1.05; gap: 2px; }
.pv-nav__name { font-size: 15px; font-weight: 900; letter-spacing: -0.015em; }
.pv-nav__tag {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--pv-mono);
  font-size: 9.5px; font-weight: 600;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--pv-g500);
}
.pv-nav__live {
  width: 7px; height: 7px; border-radius: 50%; background: var(--pv-success);
  box-shadow: 0 0 0 0 rgba(16,185,129,0.55);
  animation: pvLive 1.8s var(--pv-ease) infinite;
}
@keyframes pvLive {
  0%, 100% { box-shadow: 0 0 0 0 rgba(16,185,129,0.55); }
  50%      { box-shadow: 0 0 0 8px rgba(16,185,129,0); }
}
.pv-nav__actions { display: flex; gap: 10px; }

/* Icon button (lingo) */
.pv-icon-btn {
  position: relative;
  width: 50px; height: 50px; border-radius: var(--pv-r);
  background: var(--pv-white);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 4px;
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--pv-black); text-decoration: none;
  transition: transform 80ms var(--pv-ease), border-bottom-width 80ms var(--pv-ease), background 200ms var(--pv-ease), color 200ms var(--pv-ease);
}
.pv-icon-btn:hover { background: var(--pv-primary-sub); color: var(--pv-primary); }
.pv-icon-btn:active { transform: translateY(2px); border-bottom-width: 2px; }
.pv-icon-btn [data-lucide] { width: 18px; height: 18px; }
.pv-icon-btn__badge {
  position: absolute; top: -6px; right: -6px;
  background: var(--pv-danger); color: var(--pv-white);
  min-width: 22px; height: 22px; padding: 0 6px;
  border-radius: 9999px; font-size: 11px; font-weight: 800;
  display: inline-flex; align-items: center; justify-content: center;
  border: 3px solid var(--pv-primary-sub);
}

/* Hero inner */
.pv-hero__inner {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center; text-align: center;
  padding-top: 32px;
}
@media (min-width: 760px) { .pv-hero__inner { padding-top: 48px; } }
@media (min-width: 1100px) { .pv-hero__inner { padding-top: 64px; } }

.pv-hero__chip {
  display: inline-flex; align-items: center; gap: 10px;
  background: var(--pv-white);
  padding: 10px 18px;
  border-radius: var(--pv-r-pill);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 4px;
  font-size: 12px; font-weight: 800;
  letter-spacing: 0.04em; text-transform: uppercase;
  color: var(--pv-black);
  margin-bottom: 24px;
}
.pv-hero__chip-icon { font-size: 16px; }

.pv-hero__title {
  font-size: clamp(44px, 9vw, 110px);
  font-weight: 900; letter-spacing: -0.025em;
  line-height: 0.98;
  margin: 0 0 22px;
  color: var(--pv-black); text-wrap: balance; max-width: 14ch;
}
.pv-hero__title em {
  font-style: italic;
  color: var(--pv-primary);
}

.pv-hero__lead {
  font-size: clamp(15px, 1.6vw, 18px);
  font-weight: 600; line-height: 1.55;
  color: var(--pv-g700);
  margin: 0 auto 32px; max-width: 52ch;
}
.pv-hero__lead b { color: var(--pv-black); font-weight: 800; }

.pv-hero__ctas {
  display: flex; flex-direction: column; gap: 12px;
  align-items: center; width: 100%;
  margin-bottom: 48px;
}
@media (min-width: 540px) { .pv-hero__ctas { flex-direction: row; gap: 16px; justify-content: center; flex-wrap: wrap; } }

/* Stats grid */
.pv-hero__stats {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;
  width: 100%; max-width: 720px;
}
@media (min-width: 720px) { .pv-hero__stats { grid-template-columns: repeat(4, 1fr); gap: 16px; } }

.pv-stat {
  display: flex; flex-direction: column; align-items: flex-start; gap: 6px;
  background: var(--pv-white);
  padding: 18px 18px 16px;
  border-radius: var(--pv-r);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 6px;
  border-bottom-color: var(--ac, var(--pv-primary-dk));
  transition: transform 200ms var(--pv-ease), border-bottom-width 200ms var(--pv-ease);
}
.pv-stat:hover { transform: translateY(-3px); }
.pv-stat:active { transform: translateY(2px); border-bottom-width: 2px; }
.pv-stat--blue    { --ac: var(--pv-primary-dk); }
.pv-stat--success { --ac: var(--pv-success-dk); }
.pv-stat--warning { --ac: var(--pv-warning-dk); }
.pv-stat--danger  { --ac: var(--pv-danger-dk); }
.pv-stat__icon { font-size: 24px; line-height: 1; }
.pv-stat__num {
  font-size: clamp(28px, 4vw, 36px); font-weight: 900;
  color: var(--pv-black); letter-spacing: -0.03em; line-height: 1;
  font-variant-numeric: tabular-nums;
  display: inline-flex; align-items: baseline;
}
.pv-stat__num i { font-style: normal; color: var(--pv-primary); }
.pv-stat--success .pv-stat__num i { color: var(--pv-success); }
.pv-stat--warning .pv-stat__num i { color: var(--pv-warning); }
.pv-stat--danger .pv-stat__num i { color: var(--pv-danger); }
.pv-stat__lab {
  font-family: var(--pv-mono);
  font-size: 10.5px; font-weight: 600;
  letter-spacing: 0.10em; text-transform: uppercase;
  color: var(--pv-g500);
}

/* ====== ORBIT ====== */
.pv-orb {
  position: relative; overflow: hidden;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-white);
  padding: 64px 0 80px;
  border-top: 2px solid var(--pv-g200);
}
@media (min-width: 900px) { .pv-orb { padding: 88px 0 100px; } }
.pv-orb__head { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; margin-bottom: 24px; text-align: left; }
.pv-orb__lead { font-size: 15px; font-weight: 600; color: var(--pv-g700); margin: 0; max-width: 50ch; }

.pv-orb__stage {
  position: relative;
  width: 100%; max-width: 600px; aspect-ratio: 1;
  margin: 32px auto 24px;
  --r: 130px; --pin: 92px;
}
@media (min-width: 420px) { .pv-orb__stage { --r: 145px; --pin: 100px; } }
@media (min-width: 540px) { .pv-orb__stage { --r: 175px; --pin: 110px; } }
@media (min-width: 720px) { .pv-orb__stage { --r: 210px; --pin: 124px; } }
@media (min-width: 900px) { .pv-orb__stage { --r: 235px; --pin: 132px; } }

.pv-orb__core {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  z-index: 4;
}
.pv-orb__core-card {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  background: var(--pv-primary);
  padding: 18px 16px 14px;
  border-radius: 50%;
  width: clamp(110px, 22vw, 150px); aspect-ratio: 1;
  border: 2px solid var(--pv-primary-dk);
  border-bottom-width: 6px;
  justify-content: center;
}
.pv-orb__core-card img { width: 50%; height: 50%; object-fit: contain; filter: brightness(0) invert(1); }
.pv-orb__core-card span {
  font-family: var(--pv-mono);
  font-size: 9px; font-weight: 600;
  color: rgba(255,255,255,0.85);
  letter-spacing: 0.10em; text-transform: uppercase;
  text-align: center;
}

.pv-orb__ring {
  position: absolute; inset: 0;
  animation: pvOrbRotate 70s linear infinite;
  transform-origin: center;
}
.pv-orb__stage.is-paused .pv-orb__ring { animation-play-state: paused; }
@keyframes pvOrbRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.pv-orb__pin {
  position: absolute; top: 50%; left: 50%;
  width: var(--pin); height: var(--pin);
  margin-top: calc(var(--pin) / -2);
  margin-left: calc(var(--pin) / -2);
  text-decoration: none;
  transform: rotate(var(--angle)) translateY(calc(-1 * var(--r))) rotate(calc(-1 * var(--angle)));
  display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
  background: var(--pv-white);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 5px;
  border-radius: var(--pv-r);
  color: var(--pv-black);
  padding: 8px;
  transition: background 200ms var(--pv-ease), border-color 200ms var(--pv-ease), color 200ms var(--pv-ease), transform 100ms var(--pv-ease), border-bottom-width 100ms var(--pv-ease);
}
.pv-orb__pin:hover, .pv-orb__pin.is-active {
  background: var(--pv-primary);
  color: var(--pv-white);
  border-color: var(--pv-primary-dk);
}
.pv-orb__pin:active { transform: rotate(var(--angle)) translateY(calc(-1 * var(--r))) rotate(calc(-1 * var(--angle))) translateY(2px); border-bottom-width: 2px; }
.pv-orb__pin-emoji { font-size: clamp(22px, 4vw, 30px); }
.pv-orb__pin-name { font-size: 10px; font-weight: 800; letter-spacing: 0.02em; text-align: center; line-height: 1.1; }

.pv-orb__cta {
  display: flex; justify-content: center;
  margin-top: 24px;
}

/* ====== MARCAS interactivas ====== */
.pv-marca {
  position: relative;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-primary-sub);
  padding: 64px 0 80px;
  border-top: 2px solid var(--pv-g200);
}
@media (min-width: 900px) { .pv-marca { padding: 88px 0 100px; } }
.pv-marca__head { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; margin-bottom: 32px; }
.pv-marca__lead { font-size: 15px; font-weight: 600; color: var(--pv-g700); margin: 0; max-width: 50ch; }

.pv-marca__layout {
  display: grid; grid-template-columns: 1fr; gap: 18px;
}
@media (min-width: 900px) { .pv-marca__layout { grid-template-columns: 1fr 1.2fr; gap: 28px; } }

.pv-marca__list { display: flex; flex-direction: column; gap: 10px; }
.pv-marca__btn {
  display: grid; grid-template-columns: auto 1fr auto; align-items: center;
  gap: 16px;
  width: 100%;
  padding: 16px 18px;
  background: var(--pv-white);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 5px;
  border-radius: var(--pv-r);
  color: var(--pv-black);
  font-family: var(--pv-font);
  cursor: pointer;
  text-align: left;
  transition: background 200ms var(--pv-ease), border-color 200ms var(--pv-ease), color 200ms var(--pv-ease), transform 80ms var(--pv-ease), border-bottom-width 80ms var(--pv-ease);
}
.pv-marca__btn:active { transform: translateY(2px); border-bottom-width: 2px; }
.pv-marca__btn:hover { background: var(--pv-primary-sub); }
.pv-marca__btn.is-active {
  background: var(--pv-primary);
  color: var(--pv-white);
  border-color: var(--pv-primary-dk);
}
.pv-marca__btn-num {
  font-family: var(--pv-mono);
  font-size: 10.5px; font-weight: 600;
  letter-spacing: 0.16em;
  color: var(--pv-g500);
  background: var(--pv-g100);
  padding: 4px 8px;
  border-radius: var(--pv-r-sm);
}
.pv-marca__btn.is-active .pv-marca__btn-num { background: rgba(255,255,255,0.20); color: rgba(255,255,255,0.85); }
.pv-marca__btn-name { font-size: clamp(20px, 3vw, 28px); font-weight: 900; letter-spacing: -0.02em; line-height: 1; }
.pv-marca__btn-arr {
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--pv-g100); color: var(--pv-g500);
  display: inline-flex; align-items: center; justify-content: center;
  transition: background 200ms var(--pv-ease), color 200ms var(--pv-ease), transform 200ms var(--pv-ease);
}
.pv-marca__btn-arr [data-lucide] { width: 16px; height: 16px; }
.pv-marca__btn.is-active .pv-marca__btn-arr { background: var(--pv-white); color: var(--pv-primary); transform: rotate(-15deg) scale(1.05); }

.pv-marca__panels { position: relative; min-height: 320px; }
@media (min-width: 900px) { .pv-marca__panels { min-height: 420px; } }
.pv-marca__panel {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; gap: 14px;
  padding: 28px 26px;
  background: var(--pv-white);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 6px;
  border-radius: var(--pv-r-lg);
  opacity: 0; transform: translateY(12px) scale(0.98); pointer-events: none;
  transition: opacity 320ms var(--pv-ease), transform 320ms var(--pv-ease);
}
@media (min-width: 900px) { .pv-marca__panel { padding: 36px 32px; } }
.pv-marca__panel.is-active { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
.pv-marca__panel-emoji {
  font-size: 56px; line-height: 1;
  align-self: flex-start;
  background: var(--pv-primary-sub);
  padding: 14px;
  border-radius: var(--pv-r);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 4px;
}
.pv-marca__panel-h { margin: 4px 0 0; font-size: clamp(28px, 4vw, 40px); font-weight: 900; letter-spacing: -0.025em; line-height: 1; color: var(--pv-black); }
.pv-marca__panel-eye {
  font-family: var(--pv-mono);
  font-size: 11px; font-weight: 600;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--pv-primary);
}
.pv-marca__panel-p { margin: 0; font-size: 14px; font-weight: 600; line-height: 1.55; color: var(--pv-g700); max-width: 50ch; }
.pv-marca__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
.pv-marca__tags span {
  display: inline-flex; align-items: center;
  background: var(--pv-primary-sub); color: var(--pv-primary-dk);
  padding: 6px 12px;
  border-radius: var(--pv-r-pill);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 3px;
  font-size: 11px; font-weight: 800;
  letter-spacing: 0.04em; text-transform: uppercase;
}

/* ====== ENVIOS ====== */
.pv-ship {
  position: relative;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-white);
  padding: 64px 0 80px;
  border-top: 2px solid var(--pv-g200);
}
@media (min-width: 900px) { .pv-ship { padding: 88px 0 100px; } }
.pv-ship__head { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; margin-bottom: 32px; }
.pv-ship__lead { font-size: 15px; font-weight: 600; color: var(--pv-g700); margin: 0; max-width: 50ch; }

/* Mapa */
.pv-map {
  position: relative;
  width: 100%; max-width: 720px; margin: 24px auto 56px;
  aspect-ratio: 1 / 1.05;
  background: var(--pv-primary-sub);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 5px;
  border-radius: var(--pv-r-lg);
  padding: 16px;
}
@media (min-width: 720px) { .pv-map { aspect-ratio: 4/3; max-width: 880px; padding: 24px; } }
.pv-map__svg { width: 100%; height: 100%; }
.pv-map__line {
  stroke-dasharray: 200; stroke-dashoffset: 200;
  animation: pvMapDraw 5s cubic-bezier(.4,0,.2,1) infinite;
  animation-delay: var(--d, 0s);
}
@keyframes pvMapDraw {
  0%   { stroke-dashoffset: 200; opacity: 0; }
  10%  { opacity: 1; }
  60%  { stroke-dashoffset: 0; opacity: 1; }
  85%  { opacity: 1; }
  100% { stroke-dashoffset: 0; opacity: 0; }
}
.pv-map__ping {
  transform-origin: center; transform-box: fill-box;
  animation: pvMapPing 2.4s ease-out infinite;
}
@keyframes pvMapPing {
  0%   { transform: scale(1); opacity: 0.85; }
  100% { transform: scale(3.5); opacity: 0; }
}
.pv-map__pin { cursor: pointer; outline: none; }
.pv-map__pin circle:nth-child(2) { transition: fill 200ms var(--pv-ease), stroke-width 200ms var(--pv-ease), r 200ms var(--pv-ease); }
.pv-map__pin:hover circle:nth-child(2),
.pv-map__pin:focus circle:nth-child(2),
.pv-map__pin.is-active circle:nth-child(2) { fill: var(--pv-primary); stroke: var(--pv-white); r: 8; }

.pv-map__hud {
  position: absolute; z-index: 4;
  background: var(--pv-white);
  padding: 8px 14px;
  border-radius: var(--pv-r-pill);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 4px;
  font-family: var(--pv-mono);
  font-size: 11px; font-weight: 600;
  letter-spacing: 0.10em; text-transform: uppercase;
  color: var(--pv-black);
  display: inline-flex; align-items: center; gap: 8px;
}
.pv-map__hud--tl { top: 16px; left: 16px; }
.pv-map__hud--tr { top: 16px; right: 16px; }
.pv-map__hud b { font-weight: 900; color: var(--pv-primary); font-size: 14px; }
.pv-map__hud-dot {
  width: 8px; height: 8px; border-radius: 50%; background: var(--pv-success);
  box-shadow: 0 0 0 0 rgba(16,185,129,0.55);
  animation: pvLive 1.8s var(--pv-ease) infinite;
}

.pv-map__tip {
  position: absolute; z-index: 5; pointer-events: none;
  background: var(--pv-primary); color: var(--pv-white);
  padding: 10px 14px;
  border-radius: var(--pv-r);
  border: 2px solid var(--pv-primary-dk);
  border-bottom-width: 4px;
  display: flex; flex-direction: column; gap: 2px;
  opacity: 0; transform: translate(-50%, calc(-100% - 16px)) scale(0.95);
  transition: opacity 200ms var(--pv-ease), transform 200ms var(--pv-ease);
  white-space: nowrap;
}
.pv-map__tip.is-visible { opacity: 1; transform: translate(-50%, calc(-100% - 24px)) scale(1); }
.pv-map__tip::after {
  content: ""; position: absolute; bottom: -8px; left: 50%;
  width: 14px; height: 14px; transform: translateX(-50%) rotate(45deg);
  background: var(--pv-primary);
  border-right: 2px solid var(--pv-primary-dk);
  border-bottom: 2px solid var(--pv-primary-dk);
}
.pv-map__tip-name { font-size: 14px; font-weight: 900; letter-spacing: -0.01em; }
.pv-map__tip-meta { font-family: var(--pv-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.04em; color: rgba(255,255,255,0.85); }

.pv-map__cap {
  display: block;
  position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%);
  background: var(--pv-white);
  padding: 6px 14px;
  border-radius: var(--pv-r-pill);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 4px;
  font-family: var(--pv-mono);
  font-size: 10.5px; font-weight: 600;
  letter-spacing: 0.10em; text-transform: uppercase;
  color: var(--pv-g700);
}

/* Cards modalidades */
.pv-ship__cards {
  display: grid; grid-template-columns: 1fr; gap: 16px;
  margin-bottom: 64px;
}
@media (min-width: 720px) { .pv-ship__cards { grid-template-columns: 1fr 1fr; gap: 20px; } }

.pv-ship-card {
  display: flex; flex-direction: column; gap: 14px;
  padding: 24px;
  background: var(--pv-white);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 6px;
  border-radius: var(--pv-r-lg);
  transition: transform 200ms var(--pv-ease), border-bottom-width 200ms var(--pv-ease);
}
.pv-ship-card:hover { transform: translateY(-3px); }
.pv-ship-card:active { transform: translateY(2px); border-bottom-width: 2px; }
.pv-ship-card--success { border-bottom-color: var(--pv-success); }
.pv-ship-card--warning { border-bottom-color: var(--pv-warning); }
.pv-ship-card--danger  { border-bottom-color: var(--pv-danger); }
.pv-ship-card--feat {
  grid-column: 1 / -1;
  background: var(--pv-primary);
  color: var(--pv-white);
  border-color: var(--pv-primary-dk);
}
.pv-ship-card--feat .pv-ship-card__num,
.pv-ship-card--feat .pv-ship-card__list span { color: rgba(255,255,255,0.75); }
.pv-ship-card--feat .pv-ship-card__list b { color: var(--pv-white); }
.pv-ship-card--feat .pv-ship-card__list li { border-color: rgba(255,255,255,0.20); }
.pv-ship-card__top { display: flex; align-items: center; justify-content: space-between; }
.pv-ship-card__num {
  font-family: var(--pv-mono);
  font-size: 11px; font-weight: 600;
  letter-spacing: 0.18em; color: var(--pv-g500);
  background: var(--pv-g100);
  padding: 4px 10px; border-radius: var(--pv-r-sm);
}
.pv-ship-card--feat .pv-ship-card__num { background: rgba(255,255,255,0.20); }
.pv-ship-card__icon { font-size: 36px; line-height: 1; }
.pv-ship-card__highlight {
  display: inline-flex; align-self: flex-start;
  background: var(--pv-success);
  color: var(--pv-white);
  border: 2px solid var(--pv-success-dk);
  border-bottom-width: 4px;
  padding: 6px 14px;
  border-radius: var(--pv-r-pill);
  font-family: var(--pv-mono);
  font-size: 11px; font-weight: 700;
  letter-spacing: 0.10em; text-transform: uppercase;
}
.pv-ship-card__title { margin: 0; font-size: clamp(24px, 3.4vw, 36px); font-weight: 900; letter-spacing: -0.02em; line-height: 1.05; color: inherit; }
.pv-ship-card__big {
  font-size: clamp(28px, 4vw, 40px); font-weight: 900;
  letter-spacing: -0.025em; line-height: 1;
  font-variant-numeric: tabular-nums;
  color: inherit;
}
.pv-ship-card__big--free { color: var(--pv-success); font-size: clamp(22px, 3vw, 30px); letter-spacing: 0.04em; }
.pv-ship-card__big--alt { color: var(--pv-warning); font-style: italic; font-size: clamp(22px, 3vw, 30px); }
.pv-ship-card__list { list-style: none; padding: 0; margin: 0; }
.pv-ship-card__list li {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 10px 0;
  border-top: 1px solid var(--pv-g200);
  font-size: 13px;
}
.pv-ship-card__list li:last-child { border-bottom: 1px solid var(--pv-g200); }
.pv-ship-card__list span {
  font-family: var(--pv-mono);
  font-size: 10px; font-weight: 600;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--pv-g500);
}
.pv-ship-card__list b { font-weight: 800; color: var(--pv-black); text-align: right; }
.pv-ship-card__link {
  display: inline-flex; align-items: center; gap: 6px;
  align-self: flex-start;
  background: var(--pv-white);
  color: var(--pv-primary);
  padding: 10px 18px;
  border: 2px solid var(--pv-white);
  border-bottom-width: 4px;
  border-bottom-color: var(--pv-g200);
  border-radius: var(--pv-r-pill);
  font-size: 12px; font-weight: 800;
  letter-spacing: 0.04em; text-transform: uppercase;
  text-decoration: none;
  transition: transform 80ms var(--pv-ease), border-bottom-width 80ms var(--pv-ease);
}
.pv-ship-card__link:active { transform: translateY(2px); border-bottom-width: 2px; }
.pv-ship-card__link [data-lucide] { width: 14px; height: 14px; }

/* Zonas */
.pv-zones__head { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; margin-bottom: 24px; }
.pv-zones__title { margin: 0; font-size: clamp(28px, 4.5vw, 44px); font-weight: 900; letter-spacing: -0.025em; line-height: 1; color: var(--pv-black); }
.pv-zones__title em { font-style: italic; color: var(--pv-primary); }
.pv-zones__list { display: grid; grid-template-columns: 1fr; gap: 14px; }
@media (min-width: 720px) { .pv-zones__list { grid-template-columns: 1fr 1fr; } }
.pv-zone {
  position: relative;
  background: var(--pv-white);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 6px;
  border-radius: var(--pv-r);
  padding: 20px;
  transition: transform 200ms var(--pv-ease), border-bottom-width 200ms var(--pv-ease);
}
.pv-zone:active { transform: translateY(2px); border-bottom-width: 2px; }
.pv-zone--success { border-bottom-color: var(--pv-success); }
.pv-zone--blue    { border-bottom-color: var(--pv-primary); }
.pv-zone--warning { border-bottom-color: var(--pv-warning); }
.pv-zone--danger  { border-bottom-color: var(--pv-danger); }
.pv-zone__head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
.pv-zone__name { font-size: 24px; font-weight: 900; letter-spacing: -0.02em; color: var(--pv-black); }
.pv-zone__name em { font-style: normal; opacity: 0.55; font-weight: 900; }
.pv-zone__price {
  font-size: 22px; font-weight: 900;
  color: var(--pv-primary); letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  background: var(--pv-primary-sub);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 3px;
  padding: 4px 14px;
  border-radius: var(--pv-r-pill);
}
.pv-zone--success .pv-zone__price { background: rgba(16,185,129,0.12); color: var(--pv-success-dk); }
.pv-zone--warning .pv-zone__price { background: rgba(245,158,11,0.15); color: var(--pv-warning-dk); }
.pv-zone--danger .pv-zone__price { background: rgba(220,38,38,0.10); color: var(--pv-danger-dk); }
.pv-zone__partidos { margin: 0; font-size: 13.5px; font-weight: 600; line-height: 1.55; color: var(--pv-g700); }

/* ====== COMO COMPRAR ====== */
.pv-htb {
  position: relative;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-primary-sub);
  padding: 64px 0 80px;
  border-top: 2px solid var(--pv-g200);
}
@media (min-width: 900px) { .pv-htb { padding: 88px 0 100px; } }
.pv-htb__head { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; margin-bottom: 32px; }
.pv-htb__lead { font-size: 15px; font-weight: 600; color: var(--pv-g700); margin: 0; max-width: 50ch; }

.pv-htb__widget {
  background: var(--pv-white);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 6px;
  border-radius: var(--pv-r-lg);
  padding: 18px 18px 22px;
}
@media (min-width: 760px) { .pv-htb__widget { padding: 28px; } }

/* Step nav */
.pv-htb__nav {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px;
  background: var(--pv-g100);
  padding: 6px;
  border-radius: var(--pv-r);
  margin-bottom: 14px;
}
.pv-htb__dot {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 2px;
  padding: 10px 4px;
  background: transparent;
  border: none;
  border-radius: var(--pv-r-sm);
  color: var(--pv-g500);
  cursor: pointer;
  font-family: var(--pv-font);
  transition: background 240ms var(--pv-ease), color 240ms var(--pv-ease);
}
.pv-htb__dot:hover { color: var(--pv-black); background: var(--pv-white); }
.pv-htb__dot.is-active {
  background: var(--pv-primary);
  color: var(--pv-white);
  box-shadow: 0 4px 0 var(--pv-primary-dk);
}
.pv-htb__dot span { font-family: var(--pv-mono); font-size: 9.5px; font-weight: 600; letter-spacing: 0.16em; opacity: 0.75; }
.pv-htb__dot b { font-size: 11px; font-weight: 800; letter-spacing: 0.04em; }
@media (min-width: 540px) { .pv-htb__dot span { font-size: 10px; } .pv-htb__dot b { font-size: 13px; } }

/* Progress bar */
.pv-htb__progress {
  height: 6px; background: var(--pv-g100);
  border-radius: var(--pv-r-pill);
  margin-bottom: 24px;
  overflow: hidden;
}
.pv-htb__progress-fill {
  height: 100%; background: linear-gradient(90deg, var(--pv-primary), var(--pv-primary-lt));
  border-radius: var(--pv-r-pill);
  transition: width 380ms var(--pv-ease-out);
}

/* Viewport */
.pv-htb__viewport { position: relative; min-height: 320px; margin-bottom: 20px; }
@media (min-width: 720px) { .pv-htb__viewport { min-height: 340px; } }
.pv-htb__panel {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; gap: 14px; align-items: flex-start;
  padding: 20px 8px 8px;
  opacity: 0; transform: translateX(20px); pointer-events: none;
  transition: opacity 320ms var(--pv-ease), transform 320ms var(--pv-ease-out);
}
.pv-htb__panel.is-active { opacity: 1; transform: translateX(0); pointer-events: auto; }
.pv-htb__panel.is-prev { transform: translateX(-20px); }
.pv-htb__panel-emoji {
  font-size: 56px; line-height: 1;
  background: var(--pv-primary-sub);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 4px;
  padding: 12px;
  border-radius: var(--pv-r);
}
.pv-htb__panel-num {
  font-family: var(--pv-mono);
  font-size: 11px; font-weight: 600;
  letter-spacing: 0.18em;
  color: var(--pv-primary);
  background: var(--pv-primary-sub);
  padding: 4px 10px;
  border-radius: var(--pv-r-sm);
}
.pv-htb__panel-h {
  margin: 0; font-size: clamp(24px, 3.4vw, 36px);
  font-weight: 900; letter-spacing: -0.025em; line-height: 1.05;
  color: var(--pv-black);
}
.pv-htb__panel-h em { font-style: italic; color: var(--pv-primary); }
.pv-htb__panel-p { margin: 0; font-size: 15px; font-weight: 600; line-height: 1.55; color: var(--pv-g700); max-width: 50ch; }
.pv-htb__chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
.pv-htb__chips li {
  display: inline-flex; align-items: center;
  background: var(--pv-success);
  color: var(--pv-white);
  border: 2px solid var(--pv-success-dk);
  border-bottom-width: 3px;
  padding: 6px 12px;
  border-radius: var(--pv-r-pill);
  font-size: 11px; font-weight: 800;
  letter-spacing: 0.04em; text-transform: uppercase;
}

/* Controls */
.pv-htb__controls {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px;
  padding-top: 16px;
  border-top: 2px dashed var(--pv-g200);
}
.pv-htb__ctrl {
  width: 56px; height: 56px;
  background: var(--pv-white);
  border: 2px solid var(--pv-g200);
  border-bottom-width: 5px;
  border-radius: var(--pv-r);
  color: var(--pv-black);
  cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center;
  transition: transform 80ms var(--pv-ease), border-bottom-width 80ms var(--pv-ease), background 200ms var(--pv-ease), color 200ms var(--pv-ease);
}
.pv-htb__ctrl:hover { background: var(--pv-primary-sub); }
.pv-htb__ctrl:active { transform: translateY(2px); border-bottom-width: 2px; }
.pv-htb__ctrl:disabled { opacity: 0.4; cursor: not-allowed; }
.pv-htb__ctrl--primary { background: var(--pv-primary); color: var(--pv-white); border-color: var(--pv-primary-dk); }
.pv-htb__ctrl--primary:hover { background: var(--pv-primary-dk); }
.pv-htb__ctrl [data-lucide] { width: 20px; height: 20px; }
.pv-htb__counter {
  font-family: var(--pv-mono);
  font-size: 13px; font-weight: 600;
  letter-spacing: 0.10em;
  color: var(--pv-g500);
}
.pv-htb__counter b { font-weight: 900; color: var(--pv-black); }

/* ====== FOOTER mini ====== */
.pv-foot {
  position: relative;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-white);
  padding: 28px 0 24px;
  border-top: 2px solid var(--pv-g200);
}
.pv-foot__inner { display: flex; flex-direction: column; gap: 18px; align-items: center; }
@media (min-width: 900px) { .pv-foot__inner { flex-direction: row; justify-content: space-between; } }
.pv-foot__brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--pv-black); }
.pv-foot__mark {
  width: 42px; height: 42px; border-radius: 50%;
  background: var(--pv-primary);
  display: inline-flex; align-items: center; justify-content: center;
  padding: 9px;
  border: 2px solid var(--pv-primary-dk);
  border-bottom-width: 4px;
}
.pv-foot__mark img { width: 100%; height: 100%; object-fit: contain; filter: brightness(0) invert(1); }
.pv-foot__txt { display: flex; flex-direction: column; line-height: 1.05; gap: 2px; }
.pv-foot__name { font-size: 16px; font-weight: 900; letter-spacing: -0.015em; }
.pv-foot__tag {
  font-family: var(--pv-mono);
  font-size: 10px; font-weight: 600;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--pv-g500);
}
.pv-foot__links { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
.pv-foot__chip {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--pv-white);
  padding: 8px 14px;
  border: 2px solid var(--pv-g200);
  border-bottom-width: 4px;
  border-radius: var(--pv-r-pill);
  font-size: 12px; font-weight: 700; color: var(--pv-black);
  text-decoration: none;
  transition: transform 80ms var(--pv-ease), border-bottom-width 80ms var(--pv-ease), background 200ms var(--pv-ease), color 200ms var(--pv-ease);
}
.pv-foot__chip:hover { background: var(--pv-primary-sub); color: var(--pv-primary); }
.pv-foot__chip:active { transform: translateY(2px); border-bottom-width: 2px; }
.pv-foot__chip [data-lucide] { width: 14px; height: 14px; color: var(--pv-primary); }
.pv-foot__chip--wa [data-lucide] { color: var(--pv-wa); }
.pv-foot__legal {
  font-family: var(--pv-mono);
  font-size: 10px; font-weight: 600;
  letter-spacing: 0.10em;
  color: var(--pv-g500);
  text-align: center;
}

/* ====== FAB ====== */
.pv-fab {
  position: fixed; right: 16px; bottom: 16px; z-index: 60;
  width: 60px; height: 60px; border-radius: 50%;
  background: var(--pv-wa); color: #052E12;
  display: inline-flex; align-items: center; justify-content: center;
  text-decoration: none;
  border: 2px solid var(--pv-wa-dk);
  border-bottom-width: 6px;
  transition: transform 80ms var(--pv-ease), border-bottom-width 80ms var(--pv-ease);
}
.pv-fab:hover { transform: translateY(-2px); }
.pv-fab:active { transform: translateY(2px); border-bottom-width: 2px; }
.pv-fab__ring {
  position: absolute; inset: 0; border-radius: 50%;
  border: 2px solid rgba(37,211,102,0.55);
  animation: pvFabRing 2.4s ease-out infinite;
  pointer-events: none;
}
.pv-fab__ring--2 { animation-delay: 1.2s; }
@keyframes pvFabRing {
  0%   { transform: scale(1); opacity: 0.85; }
  100% { transform: scale(1.7); opacity: 0; }
}
.pv-fab svg { position: relative; z-index: 1; }

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .pv *, .pv *::before, .pv *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
  .pv-rev { opacity: 1 !important; transform: none !important; }
}
</style>

<script defer>
(function () {
  'use strict';

  function ready(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  function initLucide() {
    if (window.lucide && typeof window.lucide.createIcons === 'function') window.lucide.createIcons();
  }

  function updateCartBadge() {
    var badge = document.getElementById('provCartBadge');
    if (!badge) return;
    fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
      if (cart && cart.item_count > 0) { badge.textContent = cart.item_count; badge.style.display = 'inline-flex'; }
      else { badge.style.display = 'none'; }
    }).catch(function () {});
  }

  function initReveal() {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.pv .pv-rev').forEach(function (el) { el.classList.add('is-in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          var d = parseInt(e.target.dataset.delay, 10) || 0;
          setTimeout(function () { e.target.classList.add('is-in'); }, d);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.pv .pv-rev').forEach(function (el) { io.observe(el); });
  }

  function initSmoothScroll() {
    document.querySelectorAll('.pv a[href^="#"]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        var id = a.getAttribute('href').slice(1);
        var t = document.getElementById(id);
        if (!t) return;
        e.preventDefault();
        t.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  }

  // === ORBIT: pausa rotación al tap/hover, marca pin activo ===
  function initOrbit() {
    var stage = document.getElementById('provOrbStage');
    var ring  = document.getElementById('provOrbRing');
    if (!stage || !ring) return;
    var pins = ring.querySelectorAll('.pv-orb__pin');
    var resetTimer;

    function clearActive() {
      pins.forEach(function (p) { p.classList.remove('is-active'); });
      stage.classList.remove('is-paused');
    }
    function activate(pin) {
      clearTimeout(resetTimer);
      pins.forEach(function (p) { p.classList.toggle('is-active', p === pin); });
      stage.classList.add('is-paused');
    }
    function scheduleReset() {
      clearTimeout(resetTimer);
      resetTimer = setTimeout(clearActive, 2500);
    }

    pins.forEach(function (pin) {
      pin.addEventListener('mouseenter', function () { activate(pin); });
      pin.addEventListener('mouseleave', function () { scheduleReset(); });
      pin.addEventListener('focus', function () { activate(pin); });
      pin.addEventListener('blur', function () { scheduleReset(); });
      // Touch: tap toggles preview, second tap navigates
      pin.addEventListener('touchstart', function (e) {
        if (!pin.classList.contains('is-active')) {
          e.preventDefault();
          activate(pin);
          scheduleReset();
        }
      }, { passive: false });
    });
  }

  // === MARCAS: tap activa panel ===
  function initBrands() {
    var sec = document.getElementById('provMarca');
    if (!sec) return;
    var btns = sec.querySelectorAll('.pv-marca__btn');
    var panels = sec.querySelectorAll('.pv-marca__panel');
    function activate(name) {
      btns.forEach(function (b) { b.classList.toggle('is-active', b.dataset.brand === name); });
      panels.forEach(function (p) { p.classList.toggle('is-active', p.dataset.panel === name); });
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () { activate(b.dataset.brand); });
      b.addEventListener('mouseenter', function () { activate(b.dataset.brand); });
    });
  }

  // === MAP: tap pin → tooltip ===
  function initMap() {
    var map = document.getElementById('provMap');
    var tip = document.getElementById('provMapTip');
    if (!map || !tip) return;
    var tipName = tip.querySelector('.pv-map__tip-name');
    var tipMeta = tip.querySelector('.pv-map__tip-meta');
    var pins = map.querySelectorAll('.pv-map__pin');
    var hideTimer;

    function show(pin) {
      clearTimeout(hideTimer);
      var mr = map.getBoundingClientRect();
      var pr = pin.getBoundingClientRect();
      tip.style.left = (pr.left - mr.left + pr.width / 2) + 'px';
      tip.style.top  = (pr.top  - mr.top  + pr.height / 2) + 'px';
      tipName.textContent = pin.dataset.name || '';
      tipMeta.textContent = pin.dataset.meta || '';
      pins.forEach(function (p) { p.classList.toggle('is-active', p === pin); });
      tip.classList.add('is-visible');
    }
    function hide() {
      hideTimer = setTimeout(function () {
        tip.classList.remove('is-visible');
        pins.forEach(function (p) { p.classList.remove('is-active'); });
      }, 200);
    }
    pins.forEach(function (pin) {
      pin.addEventListener('mouseenter', function () { show(pin); });
      pin.addEventListener('mouseleave', hide);
      pin.addEventListener('focus', function () { show(pin); });
      pin.addEventListener('blur', hide);
      pin.addEventListener('touchstart', function (e) { e.preventDefault(); show(pin); setTimeout(hide, 2200); }, { passive: false });
      pin.addEventListener('click', function (e) { e.preventDefault(); show(pin); setTimeout(hide, 2200); });
    });
  }

  // === COMO COMPRAR: navegación 4 pasos ===
  function initHtb() {
    var sec = document.getElementById('provHtb');
    if (!sec) return;
    var dots = sec.querySelectorAll('.pv-htb__dot');
    var panels = sec.querySelectorAll('.pv-htb__panel');
    var fill = document.getElementById('provHtbFill');
    var prev = document.getElementById('provHtbPrev');
    var next = document.getElementById('provHtbNext');
    var cur = document.getElementById('provHtbCur');
    var idx = 0; var total = panels.length;

    function go(n) {
      n = Math.max(0, Math.min(total - 1, n));
      idx = n;
      dots.forEach(function (d, i) { d.classList.toggle('is-active', i === n); });
      panels.forEach(function (p, i) {
        p.classList.toggle('is-active', i === n);
        p.classList.toggle('is-prev', i < n);
      });
      if (fill) fill.style.width = ((n + 1) / total * 100) + '%';
      if (cur) cur.textContent = '0' + (n + 1);
      if (prev) prev.disabled = (n === 0);
      if (next) next.disabled = (n === total - 1);
    }
    dots.forEach(function (d) { d.addEventListener('click', function () { go(parseInt(d.dataset.step, 10)); }); });
    if (prev) prev.addEventListener('click', function () { go(idx - 1); });
    if (next) next.addEventListener('click', function () { go(idx + 1); });

    // Swipe support para mobile
    var touchStartX = 0;
    var viewport = sec.querySelector('.pv-htb__viewport');
    if (viewport) {
      viewport.addEventListener('touchstart', function (e) { touchStartX = e.touches[0].clientX; }, { passive: true });
      viewport.addEventListener('touchend', function (e) {
        var dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 50) { go(dx < 0 ? idx + 1 : idx - 1); }
      });
    }

    // Keyboard
    sec.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') go(idx + 1);
      if (e.key === 'ArrowLeft')  go(idx - 1);
    });

    go(0);
  }

  ready(function () {
    initLucide();
    updateCartBadge();
    initReveal();
    initSmoothScroll();
    initOrbit();
    initBrands();
    initMap();
    initHtb();
  });
})();
</script>
