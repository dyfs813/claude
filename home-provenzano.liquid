{% comment %}
========================================================================
PROVENZANO HOME v3 — editorial premium (1 archivo)
========================================================================
Filosofía: editorial light, tipografía gigante, layouts asimétricos,
GSAP narrativo. Mobile-first (90% del tráfico).
========================================================================
{% endcomment %}

{% schema %}
{
  "name": "Home Provenzano",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "logo_url", "label": "URL del logo", "default": "https://cdn.shopify.com/s/files/1/0729/9366/9368/files/provenzano-logo.svg?v=1777313813" },
    { "type": "text", "id": "wpp_phone", "label": "WhatsApp", "default": "5491141794592" },
    { "type": "collection", "id": "featured_collection", "label": "Productos destacados (8)" }
  ],
  "presets": [{ "name": "Home Provenzano" }]
}
{% endschema %}

{%- assign logo_url = section.settings.logo_url | default: 'https://cdn.shopify.com/s/files/1/0729/9366/9368/files/provenzano-logo.svg?v=1777313813' -%}
{%- assign wpp_phone = section.settings.wpp_phone | default: '5491141794592' -%}
{%- assign featured_products = section.settings.featured_collection.products | default: collections['destacados'].products -%}

<div class="pv">

  {%- comment -%} ============ HERO ============ {%- endcomment -%}
  <header class="pv-hero">

    <nav class="pv-nav pv-wrap">
      <a href="/" class="pv-nav__brand" aria-label="Provenzano">
        <span class="pv-nav__mark"><img src="{{ logo_url }}" alt=""></span>
        <span class="pv-nav__name">Provenzano</span>
      </a>
      <div class="pv-nav__meta">
        <span class="pv-nav__meta-bit">Liniers</span>
        <span class="pv-nav__meta-sep">·</span>
        <span class="pv-nav__meta-bit">EST. 2003</span>
        <span class="pv-nav__meta-sep">·</span>
        <span class="pv-nav__meta-bit"><span class="pv-nav__live"></span>OPEN</span>
      </div>
      <div class="pv-nav__actions">
        <a href="/search" class="pv-nav__btn" aria-label="Buscar"><i data-lucide="search"></i></a>
        <a href="/cart" class="pv-nav__btn" aria-label="Carrito">
          <i data-lucide="shopping-cart"></i>
          <span class="pv-nav__badge" id="provCartBadge" style="display:none">0</span>
        </a>
      </div>
    </nav>

    <div class="pv-ticker" aria-hidden="true">
      <div class="pv-ticker__track">
        <span>Mayorista de kiosco</span><span class="pv-ticker__dot">●</span>
        <span>216 productos</span><span class="pv-ticker__dot">●</span>
        <span>20 años en Liniers</span><span class="pv-ticker__dot">●</span>
        <span>Envíos a 24 provincias</span><span class="pv-ticker__dot">●</span>
        <span>Factura A y B</span><span class="pv-ticker__dot">●</span>
        <span>Stock real, precios al día</span><span class="pv-ticker__dot">●</span>
        <span>Energizer · Duracell · Gillette · Candela · BIC</span><span class="pv-ticker__dot">●</span>
        <span>Mayorista de kiosco</span><span class="pv-ticker__dot">●</span>
        <span>216 productos</span><span class="pv-ticker__dot">●</span>
        <span>20 años en Liniers</span><span class="pv-ticker__dot">●</span>
        <span>Envíos a 24 provincias</span><span class="pv-ticker__dot">●</span>
        <span>Factura A y B</span><span class="pv-ticker__dot">●</span>
        <span>Stock real, precios al día</span><span class="pv-ticker__dot">●</span>
        <span>Energizer · Duracell · Gillette · Candela · BIC</span><span class="pv-ticker__dot">●</span>
      </div>
    </div>

    <div class="pv-hero__inner pv-wrap">
      <span class="pv-hero__eye pv-label">01 — Provenzano Mayorista</span>

      <h1 class="pv-hero__title">
        <span class="pv-hero__line"><span class="pv-hero__word">Mayorista</span></span>
        <span class="pv-hero__line"><span class="pv-hero__word">de</span> <span class="pv-hero__word pv-hero__word--ital">toda</span></span>
        <span class="pv-hero__line"><span class="pv-hero__word pv-hero__word--ital">la vida</span><span class="pv-hero__period">.</span></span>
      </h1>

      <div class="pv-hero__bottom">
        <p class="pv-hero__lead">
          Abastecemos kioscos, almacenes y revendedores desde Liniers, CABA. Catálogo de <b>216+ productos</b> con precios mayoristas actualizados todos los días.
        </p>
        <div class="pv-hero__ctas">
          <a href="#provCatalog" class="pv-btn pv-btn--xxl pv-btn--magnetic">
            Ver catálogo
            <i data-lucide="arrow-right"></i>
          </a>
          <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola Provenzano, quiero hacer una consulta' | url_encode }}" target="_blank" rel="noopener" class="pv-hero__wa">
            <span class="pv-hero__wa-dot"></span>
            <span class="pv-hero__wa-text">
              <span class="pv-hero__wa-mini">o consultá ahora</span>
              <span class="pv-hero__wa-num">+54 9 11 4179-4592</span>
            </span>
          </a>
        </div>
      </div>

      <a href="#provIntro" class="pv-hero__scroll" aria-label="Bajar">
        <span class="pv-hero__scroll-line"></span>
        <span class="pv-hero__scroll-text">Scroll</span>
      </a>
    </div>
  </header>
  {%- comment -%} ============ INTRO / SOBRE NOSOTROS ============ {%- endcomment -%}
  <section class="pv-intro" id="provIntro">
    <div class="pv-wrap pv-intro__inner">

      <aside class="pv-intro__aside">
        <span class="pv-label">02 — Sobre Nosotros</span>
        <span class="pv-intro__aside-mono">Provenzano S.R.L.<br>Carhué 74, Liniers, CABA<br>Argentina · 2026</span>
      </aside>

      <div class="pv-intro__main">
        <h2 class="pv-intro__title">
          <span class="pv-intro__line"><span class="pv-intro__word">Dos</span> <span class="pv-intro__word">décadas</span></span>
          <span class="pv-intro__line"><span class="pv-intro__word">abasteciendo</span> <span class="pv-intro__word">a</span></span>
          <span class="pv-intro__line"><span class="pv-intro__word">los</span> <span class="pv-intro__word">que</span> <span class="pv-intro__word pv-intro__word--accent">venden</span></span>
          <span class="pv-intro__line"><span class="pv-intro__word pv-intro__word--accent">al</span> <span class="pv-intro__word pv-intro__word--accent">barrio</span><span class="pv-intro__period">.</span></span>
        </h2>

        <p class="pv-intro__body pv-rev">
          Empezamos en Liniers en 2003. Hoy abastecemos a kioscos, almacenes y revendedores de todo el país con <b>las primeras marcas</b> al precio mayorista que necesitan para hacer rotar su negocio. Sin formularios largos, sin mínimos rígidos, sin sorpresas.
        </p>

        <div class="pv-intro__stats">
          <div class="pv-intro__stat pv-rev">
            <span class="pv-intro__stat-num"><span data-counter="20">0</span><span class="pv-intro__stat-suf">+</span></span>
            <span class="pv-intro__stat-lab">Años en el rubro</span>
          </div>
          <div class="pv-intro__stat pv-rev">
            <span class="pv-intro__stat-num"><span data-counter="216">0</span><span class="pv-intro__stat-suf">+</span></span>
            <span class="pv-intro__stat-lab">Productos en stock</span>
          </div>
          <div class="pv-intro__stat pv-rev">
            <span class="pv-intro__stat-num"><span data-counter="24">0</span></span>
            <span class="pv-intro__stat-lab">Provincias</span>
          </div>
          <div class="pv-intro__stat pv-rev">
            <span class="pv-intro__stat-num">A<span class="pv-intro__stat-slash">/</span>B</span>
            <span class="pv-intro__stat-lab">Factura</span>
          </div>
        </div>
      </div>

    </div>
  </section>
  {%- comment -%} ============ CATALOG ============ {%- endcomment -%}
  <section class="pv-cat" id="provCatalog">
    <div class="pv-wrap">

      <header class="pv-cat__head">
        <div class="pv-cat__head-left">
          <span class="pv-label">03 — Catálogo</span>
          <span class="pv-cat__live"><span class="pv-cat__live-dot"></span>Stock real · precios al día</span>
        </div>
        <h2 class="pv-cat__title">
          <span class="pv-cat__line"><span class="pv-cat__word">El</span> <span class="pv-cat__word">catálogo</span><span class="pv-cat__comma">,</span></span>
          <span class="pv-cat__line"><span class="pv-cat__word pv-cat__word--ital">en</span> <span class="pv-cat__word pv-cat__word--ital">vivo</span><span class="pv-cat__period">.</span></span>
        </h2>
      </header>

      <p class="pv-cat__lead pv-rev">
        Revisamos y actualizamos los precios todos los días. Lo que ves es lo que hay, listo para despachar.
      </p>

      {% if featured_products.size > 0 %}
        <div class="pv-cat__grid">
          {% for product in featured_products limit: 8 %}
            {% assign units = product.metafields.custom.bulk_units | default: 0 %}
            {% assign sku_num = forloop.index | prepend: '00' | slice: -3, 3 %}
            <a href="{{ product.url }}" class="pv-prod pv-rev" style="--i:{{ forloop.index0 }}">
              <span class="pv-prod__num">{{ sku_num }}</span>
              <div class="pv-prod__img">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '500x500' }}" alt="{{ product.title }}" loading="lazy">
                {% endif %}
              </div>
              <div class="pv-prod__meta">
                {% if product.type and product.type != '' %}
                  <span class="pv-prod__cat">{{ product.type }}</span>
                {% endif %}
                <h3 class="pv-prod__name">{{ product.title }}</h3>
              </div>
              <div class="pv-prod__foot">
                <span class="pv-prod__price">{{ product.price | money }}</span>
                {% if units > 0 %}
                  <span class="pv-prod__bulk">x{{ units }}</span>
                {% endif %}
              </div>
              <span class="pv-prod__arrow" aria-hidden="true"><i data-lucide="arrow-up-right"></i></span>
            </a>
          {% endfor %}
        </div>
      {% endif %}

      <div class="pv-cat__cta-wrap">
        <div class="pv-cat__cta-meta">
          <span class="pv-cat__cta-eye">+ <span data-counter="208">0</span> productos</span>
          <span class="pv-cat__cta-mini">en el catálogo completo</span>
        </div>
        <a href="/collections/all" class="pv-cat__cta">
          <span class="pv-cat__cta-text">
            <span class="pv-cat__cta-line">Armá</span>
            <span class="pv-cat__cta-line pv-cat__cta-line--ital">tu pedido</span>
          </span>
          <span class="pv-cat__cta-arrow"><i data-lucide="arrow-right"></i></span>
        </a>
      </div>

    </div>
  </section>
  {%- comment -%} ============ BRANDS slim ============ {%- endcomment -%}
  <section class="pv-brands" aria-label="Marcas oficiales">
    <div class="pv-brands__wrap">
      <span class="pv-brands__label">Trabajamos con marcas oficiales</span>
      <div class="pv-brands__marquee">
        <ul class="pv-brands__track">
          <li>Energizer</li><li class="pv-brands__sep">✱</li>
          <li>Duracell</li><li class="pv-brands__sep">✱</li>
          <li>Gillette</li><li class="pv-brands__sep">✱</li>
          <li>Candela</li><li class="pv-brands__sep">✱</li>
          <li>BIC</li><li class="pv-brands__sep">✱</li>
          <li aria-hidden="true">Energizer</li><li class="pv-brands__sep" aria-hidden="true">✱</li>
          <li aria-hidden="true">Duracell</li><li class="pv-brands__sep" aria-hidden="true">✱</li>
          <li aria-hidden="true">Gillette</li><li class="pv-brands__sep" aria-hidden="true">✱</li>
          <li aria-hidden="true">Candela</li><li class="pv-brands__sep" aria-hidden="true">✱</li>
          <li aria-hidden="true">BIC</li><li class="pv-brands__sep" aria-hidden="true">✱</li>
        </ul>
      </div>
    </div>
  </section>
  {%- comment -%} ============ SHIPPING ============ {%- endcomment -%}
  <section class="pv-ship" id="provShip">
    <div class="pv-wrap">

      <header class="pv-ship__head">
        <div class="pv-ship__head-left">
          <span class="pv-label">04 — Envíos</span>
        </div>
        <h2 class="pv-ship__title">
          <span class="pv-ship__line"><span class="pv-ship__word">Llegamos</span></span>
          <span class="pv-ship__line"><span class="pv-ship__word">donde</span> <span class="pv-ship__word pv-ship__word--ital">estés</span><span class="pv-ship__period">.</span></span>
        </h2>
      </header>

      <p class="pv-ship__lead pv-rev">
        Cuatro formas de recibir tu pedido, todas claras desde el principio. Sin letra chica.
      </p>

      <div class="pv-ship__cards">

        {%- comment -%} 01 RETIRO {%- endcomment -%}
        <article class="pv-ship__card pv-rev">
          <div class="pv-ship__card-top">
            <span class="pv-ship__card-num">01</span>
            <span class="pv-ship__card-icon"><i data-lucide="store"></i></span>
          </div>
          <h3 class="pv-ship__card-title">Retiro<br>en sucursal</h3>
          <div class="pv-ship__card-bigs">
            <span class="pv-ship__card-big pv-ship__card-big--free">Sin costo</span>
            <span class="pv-ship__card-min">Mín. $100.000</span>
          </div>
          <ul class="pv-ship__card-list">
            <li><span class="pv-ship__card-k">Dirección</span><span>Carhué 74, Liniers</span></li>
            <li><span class="pv-ship__card-k">Días</span><span>Lunes a sábado</span></li>
            <li><span class="pv-ship__card-k">Coordinación</span><span>Por WhatsApp</span></li>
          </ul>
          <a href="https://www.google.com/maps/search/?api=1&query=Carh%C3%BA%C3%A9+74+Liniers+CABA" target="_blank" rel="noopener" class="pv-ship__card-link">Ver mapa <i data-lucide="arrow-up-right"></i></a>
        </article>

        {%- comment -%} 02 CABA/GBA {%- endcomment -%}
        <article class="pv-ship__card pv-ship__card--feat pv-rev">
          <div class="pv-ship__card-top">
            <span class="pv-ship__card-num">02</span>
            <span class="pv-ship__card-icon"><i data-lucide="truck"></i></span>
          </div>
          <h3 class="pv-ship__card-title">Envío<br>CABA y GBA</h3>
          <div class="pv-ship__card-bigs">
            <span class="pv-ship__card-big">Desde $4.100</span>
            <span class="pv-ship__card-min">Mín. $100.000 · GRATIS desde $600.000</span>
          </div>
          <ul class="pv-ship__card-list">
            <li><span class="pv-ship__card-k">Despacho</span><span>Martes y jueves</span></li>
            <li><span class="pv-ship__card-k">Salida</span><span>14 hs</span></li>
            <li><span class="pv-ship__card-k">Llegada</span><span>14 a 21 hs</span></li>
          </ul>
          <a href="#provZones" class="pv-ship__card-link">Ver zonas y precios <i data-lucide="arrow-down"></i></a>
        </article>

        {%- comment -%} 03 INTERIOR {%- endcomment -%}
        <article class="pv-ship__card pv-rev">
          <div class="pv-ship__card-top">
            <span class="pv-ship__card-num">03</span>
            <span class="pv-ship__card-icon"><i data-lucide="map"></i></span>
          </div>
          <h3 class="pv-ship__card-title">Envío al<br>interior</h3>
          <div class="pv-ship__card-bigs">
            <span class="pv-ship__card-big">Vía cargo</span>
            <span class="pv-ship__card-min">Mín. $200.000</span>
          </div>
          <ul class="pv-ship__card-list">
            <li><span class="pv-ship__card-k">Cobertura</span><span>24 provincias</span></li>
            <li><span class="pv-ship__card-k">Tiempo</span><span>2 a 7 días hábiles</span></li>
            <li><span class="pv-ship__card-k">Flete</span><span>Lo paga el cliente al recibir</span></li>
          </ul>
          <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola, quiero coordinar un envio al interior' | url_encode }}" target="_blank" rel="noopener" class="pv-ship__card-link">Coordinar <i data-lucide="arrow-up-right"></i></a>
        </article>

        {%- comment -%} 04 COMISIONISTA {%- endcomment -%}
        <article class="pv-ship__card pv-rev">
          <div class="pv-ship__card-top">
            <span class="pv-ship__card-num">04</span>
            <span class="pv-ship__card-icon"><i data-lucide="handshake"></i></span>
          </div>
          <h3 class="pv-ship__card-title">Tu transporte<br>o comisionista</h3>
          <div class="pv-ship__card-bigs">
            <span class="pv-ship__card-big pv-ship__card-big--free">Sin costo</span>
            <span class="pv-ship__card-min">Mín. $500.000</span>
          </div>
          <ul class="pv-ship__card-list">
            <li><span class="pv-ship__card-k">Retiro</span><span>Carhué 74, Liniers</span></li>
            <li><span class="pv-ship__card-k">Días</span><span>Lunes a sábado</span></li>
            <li><span class="pv-ship__card-k">Coordinación</span><span>Por WhatsApp</span></li>
          </ul>
          <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola, mando comisionista a retirar un pedido' | url_encode }}" target="_blank" rel="noopener" class="pv-ship__card-link">Coordinar <i data-lucide="arrow-up-right"></i></a>
        </article>

      </div>

      {%- comment -%} ZONAS GBA {%- endcomment -%}
      <div class="pv-zones" id="provZones">
        <header class="pv-zones__head">
          <span class="pv-label pv-label--alt">02.1 — Zonas y precios CABA / GBA</span>
          <p class="pv-zones__hint">Tocá tu zona para ver los partidos.</p>
        </header>

        <div class="pv-zones__list">
          <details class="pv-zone pv-zone--caba pv-rev" open>
            <summary class="pv-zone__sum">
              <span class="pv-zone__name">CABA</span>
              <span class="pv-zone__price">$4.100</span>
              <span class="pv-zone__cap">Toda la Capital Federal</span>
              <span class="pv-zone__chev"><i data-lucide="chevron-down"></i></span>
            </summary>
            <div class="pv-zone__body">
              <span class="pv-zone__partidos">Toda la Ciudad Autónoma de Buenos Aires.</span>
            </div>
          </details>

          <details class="pv-zone pv-zone--g1 pv-rev">
            <summary class="pv-zone__sum">
              <span class="pv-zone__name">GBA <em>1</em></span>
              <span class="pv-zone__price">$5.000</span>
              <span class="pv-zone__cap">9 partidos</span>
              <span class="pv-zone__chev"><i data-lucide="chevron-down"></i></span>
            </summary>
            <div class="pv-zone__body">
              <span class="pv-zone__partidos">Avellaneda · Lanús · Lomas de Zamora · La Matanza Norte · Morón · 3 de Febrero · San Martín · Vicente López · San Isidro</span>
            </div>
          </details>

          <details class="pv-zone pv-zone--g2 pv-rev">
            <summary class="pv-zone__sum">
              <span class="pv-zone__name">GBA <em>2</em></span>
              <span class="pv-zone__price">$6.000</span>
              <span class="pv-zone__cap">16 partidos</span>
              <span class="pv-zone__chev"><i data-lucide="chevron-down"></i></span>
            </summary>
            <div class="pv-zone__body">
              <span class="pv-zone__partidos">San Fernando · Tigre · Malvinas Argentinas · José C. Paz · San Miguel · Hurlingham · Ituzaingó · La Matanza Sur · Merlo · Moreno · Esteban Echeverría · Almirante Brown · Ezeiza · Quilmes · Florencio Varela · Berazategui</span>
            </div>
          </details>

          <details class="pv-zone pv-zone--g3 pv-rev">
            <summary class="pv-zone__sum">
              <span class="pv-zone__name">GBA <em>3</em></span>
              <span class="pv-zone__price">$7.900</span>
              <span class="pv-zone__cap">19 partidos</span>
              <span class="pv-zone__chev"><i data-lucide="chevron-down"></i></span>
            </summary>
            <div class="pv-zone__body">
              <span class="pv-zone__partidos">Zárate · Campana · Escobar · Ing. Maschwitz · Garín · Pilar · Del Viso · Derqui · Villa Rosa · Luján · Gral. Rodríguez · Marcos Paz · Nordelta · San Vicente · Guernica · Berisso · La Plata · Cañuelas · Ensenada</span>
            </div>
          </details>
        </div>

        <p class="pv-zones__note">¿No estás seguro de tu zona? <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola, soy de [tu zona] y quiero saber el costo de envio' | url_encode }}" target="_blank" rel="noopener">Escribinos por WhatsApp</a> y te confirmamos en el día.</p>
      </div>

    </div>
  </section>
  {%- comment -%} ============ CONTACT ============ {%- endcomment -%}
  <section class="pv-contact" id="provContact">
    <div class="pv-wrap">

      <header class="pv-contact__head">
        <span class="pv-label">05 — Contacto</span>
        <h2 class="pv-contact__title">
          <span class="pv-contact__line"><span class="pv-contact__word">Vení.</span></span>
          <span class="pv-contact__line"><span class="pv-contact__word pv-contact__word--ital">O escribí.</span></span>
        </h2>
      </header>

      <div class="pv-contact__grid">

        <div class="pv-contact__addr pv-rev">
          <span class="pv-contact__addr-eye">Sucursal</span>
          <a href="https://www.google.com/maps/search/?api=1&query=Carh%C3%BA%C3%A9+74+Liniers+CABA" target="_blank" rel="noopener" class="pv-contact__addr-line">Carhué 74</a>
          <span class="pv-contact__addr-line pv-contact__addr-line--sub">Liniers, CABA</span>
          <ul class="pv-contact__addr-list">
            <li><span>Horario</span><span>L-V 8:30 a 16 hs</span></li>
            <li><span>Sábados</span><span>A coordinar</span></li>
            <li><span>Coordinación</span><span>WhatsApp</span></li>
          </ul>
          <a href="https://www.google.com/maps/search/?api=1&query=Carh%C3%BA%C3%A9+74+Liniers+CABA" target="_blank" rel="noopener" class="pv-contact__addr-link">
            <i data-lucide="map-pin"></i> Cómo llegar
          </a>
        </div>

        <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola Provenzano, quiero hacer un pedido' | url_encode }}" target="_blank" rel="noopener" class="pv-contact__wa pv-rev">
          <div class="pv-contact__wa-top">
            <span class="pv-contact__wa-eye"><span class="pv-contact__wa-dot"></span>WhatsApp</span>
            <span class="pv-contact__wa-arrow"><i data-lucide="arrow-up-right"></i></span>
          </div>
          <span class="pv-contact__wa-num">+54 9 11<br>4179-4592</span>
          <span class="pv-contact__wa-cta">Tocá para escribirnos →</span>
