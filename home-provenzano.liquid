</div>

<style>
/* ============================================================
   PROVENZANO HOME v5 — CLAYMORPHISM
   ============================================================ */
.pv, .pv *, .pv *::before, .pv *::after { box-sizing: border-box; }
.pv [data-lucide] { width: 18px; height: 18px; stroke-width: 2; flex-shrink: 0; }
.pv img { max-width: 100%; }

.pv {
  /* Tokens claymorphism */
  --pv-bg: #EEF2FA;
  --pv-bg-2: #F6F8FD;
  --pv-surface: #FFFFFF;
  --pv-ink: #1C398E;
  --pv-ink-2: #475569;
  --pv-ink-3: #94A3B8;
  --pv-primary: #3B82F6;
  --pv-primary-dk: #1D4ED8;
  --pv-success: #16A34A;
  --pv-warning: #D97706;
  --pv-danger: #DC2626;
  --pv-pink: #EC4899;
  --pv-purple: #A855F7;
  --pv-yellow: #FACC15;
  --pv-wa: #25D366;

  /* Sombras claymorphic puffy */
  --pv-clay: 0 16px 40px -12px rgba(28,57,142,0.18), 0 6px 14px -4px rgba(28,57,142,0.10), inset 0 -6px 14px rgba(28,57,142,0.08), inset 0 6px 14px rgba(255,255,255,0.95);
  --pv-clay-sm: 0 10px 24px -8px rgba(28,57,142,0.16), inset 0 -4px 10px rgba(28,57,142,0.06), inset 0 4px 10px rgba(255,255,255,0.95);
  --pv-clay-blue: 0 18px 42px -12px rgba(59,130,246,0.55), 0 6px 14px -4px rgba(59,130,246,0.30), inset 0 -8px 16px rgba(0,0,0,0.18), inset 0 8px 16px rgba(255,255,255,0.45);
  --pv-clay-green: 0 18px 42px -12px rgba(37,211,102,0.50), 0 6px 14px -4px rgba(37,211,102,0.25), inset 0 -8px 16px rgba(0,0,0,0.18), inset 0 8px 16px rgba(255,255,255,0.50);
  --pv-clay-press: 0 4px 10px -4px rgba(28,57,142,0.20), inset 0 -2px 6px rgba(28,57,142,0.06), inset 0 2px 6px rgba(255,255,255,0.95);

  --pv-r: 28px;
  --pv-r-sm: 20px;
  --pv-r-pill: 9999px;

  --pv-font: 'Poppins', 'Manrope', system-ui, -apple-system, sans-serif;
  --pv-mono: 'JetBrains Mono', 'SF Mono', Consolas, monospace;
  --pv-ease: cubic-bezier(.2,.7,.3,1);
  --pv-ease-out: cubic-bezier(.16,1,.3,1);

  font-family: var(--pv-font);
  color: var(--pv-ink);
  background: var(--pv-bg);
  line-height: 1.55;
  font-feature-settings: "ss01", "ss02";
}

.pv :focus-visible { outline: 3px solid var(--pv-primary); outline-offset: 4px; border-radius: 8px; }

/* Container */
.pv-wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }
@media (min-width: 760px) { .pv-wrap { padding: 0 32px; } }
@media (min-width: 1100px) { .pv-wrap { padding: 0 48px; } }

/* Reveal */
.pv-rev { opacity: 0; transform: translateY(24px); }
.pv-rev.is-in { opacity: 1; transform: translateY(0); transition: opacity 700ms var(--pv-ease-out), transform 700ms var(--pv-ease-out); }

/* ====== HERO ====== */
.pv-hero {
  position: relative; overflow: hidden;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-bg);
  padding-bottom: 80px;
}
@media (min-width: 900px) { .pv-hero { padding-bottom: 120px; } }

/* Decorative blobs */
.pv-hero__deco { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
.pv-blob {
  position: absolute; border-radius: 50%;
  filter: blur(60px); opacity: 0.45;
  animation: pvBlob 22s ease-in-out infinite alternate;
}
.pv-blob--1 { width: 320px; height: 320px; background: var(--pv-primary); top: -80px; left: -60px; }
.pv-blob--2 { width: 280px; height: 280px; background: var(--pv-purple); top: 30%; right: -80px; animation-duration: 26s; animation-direction: alternate-reverse; }
.pv-blob--3 { width: 240px; height: 240px; background: var(--pv-pink); bottom: -60px; left: 20%; animation-duration: 30s; }
.pv-blob--4 { width: 200px; height: 200px; background: var(--pv-yellow); top: 50%; left: 40%; animation-duration: 34s; opacity: 0.30; }
.pv-blob--5 { width: 260px; height: 260px; background: var(--pv-success); bottom: 10%; right: 10%; animation-duration: 28s; animation-direction: alternate-reverse; opacity: 0.25; }
@keyframes pvBlob {
  from { transform: translate(0, 0) scale(1); }
  to   { transform: translate(60px, 40px) scale(1.15); }
}

/* Nav */
.pv-nav {
  position: relative; z-index: 4;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding-top: 20px; padding-bottom: 20px;
}
.pv-nav__brand {
  display: inline-flex; align-items: center; gap: 14px;
  text-decoration: none; color: var(--pv-ink);
  background: var(--pv-surface);
  padding: 10px 18px 10px 10px;
  border-radius: var(--pv-r-pill);
  box-shadow: var(--pv-clay-sm);
  transition: transform 200ms var(--pv-ease);
}
.pv-nav__brand:hover { transform: translateY(-2px); }
.pv-nav__mark {
  width: 40px; height: 40px; border-radius: 50%;
  background: var(--pv-primary);
  display: inline-flex; align-items: center; justify-content: center;
  padding: 8px;
  box-shadow: inset 0 -3px 8px rgba(0,0,0,0.18), inset 0 3px 8px rgba(255,255,255,0.4);
}
.pv-nav__mark img { width: 100%; height: 100%; object-fit: contain; filter: brightness(0) invert(1); }
.pv-nav__text { display: flex; flex-direction: column; line-height: 1.05; gap: 2px; }
.pv-nav__name { font-size: 15px; font-weight: 800; letter-spacing: -0.02em; color: var(--pv-ink); }
.pv-nav__tag {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--pv-mono);
  font-size: 9.5px; font-weight: 500;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--pv-ink-2);
}
.pv-nav__live {
  width: 7px; height: 7px; border-radius: 50%; background: var(--pv-wa);
  box-shadow: 0 0 0 0 rgba(37,211,102,0.55);
  animation: pvLive 1.8s var(--pv-ease) infinite;
}
@keyframes pvLive {
  0%, 100% { box-shadow: 0 0 0 0 rgba(37,211,102,0.55); }
  50%      { box-shadow: 0 0 0 8px rgba(37,211,102,0); }
}
.pv-nav__actions { display: flex; gap: 10px; }
.pv-nav__btn {
  position: relative;
  width: 48px; height: 48px; border-radius: 50%;
  background: var(--pv-surface);
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--pv-ink); text-decoration: none;
  box-shadow: var(--pv-clay-sm);
  transition: transform 200ms var(--pv-ease), background 200ms var(--pv-ease), color 200ms var(--pv-ease);
}
.pv-nav__btn:hover { transform: translateY(-2px); background: var(--pv-primary); color: #fff; }
.pv-nav__btn:active { transform: translateY(0); box-shadow: var(--pv-clay-press); }
.pv-nav__btn [data-lucide] { width: 18px; height: 18px; }
.pv-nav__badge {
  position: absolute; top: -4px; right: -4px;
  background: var(--pv-danger); color: #fff;
  min-width: 22px; height: 22px; padding: 0 6px;
  border-radius: 9999px; font-size: 11px; font-weight: 800;
  display: inline-flex; align-items: center; justify-content: center;
  border: 3px solid var(--pv-bg);
  box-shadow: 0 4px 10px rgba(220,38,38,0.4);
}

/* Hero inner */
.pv-hero__inner {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center; text-align: center;
  padding-top: 40px;
}
@media (min-width: 760px) { .pv-hero__inner { padding-top: 56px; } }
@media (min-width: 1100px) { .pv-hero__inner { padding-top: 72px; } }

/* Chip */
.pv-hero__chip {
  display: inline-flex; align-items: center; gap: 10px;
  background: var(--pv-surface);
  padding: 10px 20px;
  border-radius: var(--pv-r-pill);
  box-shadow: var(--pv-clay-sm);
  margin-bottom: 28px;
}
.pv-hero__chip-dot {
  width: 10px; height: 10px; border-radius: 50%; background: var(--pv-success);
  box-shadow: 0 0 0 0 rgba(22,163,74,0.55), inset 0 -2px 4px rgba(0,0,0,0.18);
  animation: pvLive 1.8s var(--pv-ease) infinite;
}
.pv-hero__chip-text {
  font-family: var(--pv-mono);
  font-size: 11px; font-weight: 500;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--pv-ink);
}

/* Title */
.pv-hero__title {
  font-size: clamp(48px, 9vw, 120px);
  font-weight: 800; letter-spacing: -0.035em;
  line-height: 1.0;
  margin: 0 0 24px;
  color: var(--pv-ink); text-wrap: balance; max-width: 14ch;
}
.pv-hero__title-em {
  background: linear-gradient(135deg, var(--pv-primary) 0%, var(--pv-purple) 50%, var(--pv-pink) 100%);
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  font-style: italic; font-weight: 800;
}

.pv-hero__lead {
  font-size: clamp(16px, 1.7vw, 19px);
  font-weight: 500; line-height: 1.55;
  color: var(--pv-ink-2);
  margin: 0 auto 36px; max-width: 52ch;
}
.pv-hero__lead b { color: var(--pv-ink); font-weight: 700; }

/* CTAs */
.pv-hero__ctas {
  display: flex; flex-direction: column; gap: 18px;
  align-items: center; width: 100%;
  margin-bottom: 48px;
}
@media (min-width: 760px) { .pv-hero__ctas { flex-direction: row; gap: 24px; justify-content: center; } }

.pv-cta {
  position: relative;
  display: inline-flex; align-items: center; gap: 18px;
  padding: 18px 18px 18px 28px;
  background: var(--pv-primary);
  color: #fff;
  border-radius: var(--pv-r-pill);
  text-decoration: none;
  box-shadow: var(--pv-clay-blue);
  transition: transform 220ms var(--pv-ease), box-shadow 220ms var(--pv-ease), background 220ms var(--pv-ease);
}
.pv-cta:hover { transform: translateY(-3px); background: var(--pv-primary-dk); box-shadow: 0 22px 50px -12px rgba(29,78,216,0.65), 0 8px 16px -4px rgba(29,78,216,0.30), inset 0 -8px 16px rgba(0,0,0,0.20), inset 0 8px 16px rgba(255,255,255,0.40); }
.pv-cta:active { transform: translateY(0); box-shadow: var(--pv-clay-press); }
.pv-cta__main { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.1; gap: 4px; }
.pv-cta__lab {
  font-family: var(--pv-mono);
  font-size: 10px; font-weight: 500;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: rgba(255,255,255,0.75);
}
.pv-cta__title { display: inline-flex; align-items: center; gap: 8px; font-size: 18px; font-weight: 800; letter-spacing: -0.01em; }
.pv-cta__title [data-lucide] { width: 18px; height: 18px; }
.pv-cta__chip {
  width: 56px; height: 56px; border-radius: 50%;
  background: #fff; color: var(--pv-primary);
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 22px; font-weight: 900;
  box-shadow: inset 0 -4px 10px rgba(0,0,0,0.10), inset 0 4px 10px rgba(255,255,255,0.95);
  transition: transform 220ms var(--pv-ease);
}
.pv-cta:hover .pv-cta__chip { transform: rotate(-15deg) scale(1.05); }

.pv-wa-btn {
  display: inline-flex; align-items: center; gap: 14px;
  padding: 12px 22px 12px 12px;
  background: var(--pv-surface);
  color: var(--pv-ink);
  border-radius: var(--pv-r-pill);
  text-decoration: none;
  box-shadow: var(--pv-clay-sm);
  transition: transform 200ms var(--pv-ease);
}
.pv-wa-btn:hover { transform: translateY(-2px); }
.pv-wa-btn__icon {
  width: 48px; height: 48px; border-radius: 50%;
  background: var(--pv-wa); color: #052E12;
  display: inline-flex; align-items: center; justify-content: center;
  box-shadow: var(--pv-clay-green);
}
.pv-wa-btn__text { display: flex; flex-direction: column; line-height: 1.1; align-items: flex-start; gap: 2px; }
.pv-wa-btn__lab {
  font-family: var(--pv-mono);
  font-size: 10px; font-weight: 500;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--pv-ink-2);
}
.pv-wa-btn__num { font-size: 16px; font-weight: 800; color: var(--pv-ink); letter-spacing: -0.005em; }

/* Stats grid */
.pv-hero__stats {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;
  width: 100%; max-width: 720px;
  margin: 0 0 36px;
}
@media (min-width: 720px) { .pv-hero__stats { grid-template-columns: repeat(4, 1fr); gap: 16px; } }
.pv-stat {
  display: flex; flex-direction: column; gap: 6px;
  padding: 18px 20px;
  border-radius: var(--pv-r);
  background: var(--pv-surface);
  box-shadow: var(--pv-clay);
  position: relative; overflow: hidden;
  transition: transform 220ms var(--pv-ease);
}
.pv-stat:hover { transform: translateY(-3px) rotate(-1deg); }
.pv-stat::before {
  content: ""; position: absolute; top: -30px; right: -30px;
  width: 80px; height: 80px; border-radius: 50%;
  background: var(--accent, var(--pv-primary)); opacity: 0.18;
  filter: blur(8px);
}
.pv-stat--blue   { --accent: var(--pv-primary); }
.pv-stat--purple { --accent: var(--pv-purple); }
.pv-stat--pink   { --accent: var(--pv-pink); }
.pv-stat--yellow { --accent: var(--pv-yellow); }
.pv-stat__num {
  font-size: clamp(28px, 4vw, 42px); font-weight: 800;
  color: var(--pv-ink); letter-spacing: -0.03em; line-height: 1;
  font-variant-numeric: tabular-nums;
  display: inline-flex; align-items: baseline;
  position: relative; z-index: 1;
}
.pv-stat__num i { font-style: normal; color: var(--accent, var(--pv-primary)); }
.pv-stat__lab {
  font-family: var(--pv-mono);
  font-size: 10.5px; font-weight: 500;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--pv-ink-2);
  position: relative; z-index: 1;
}

/* Brands */
.pv-hero__brands {
  display: flex; flex-direction: column; align-items: center; gap: 14px;
  width: 100%;
}
@media (min-width: 720px) { .pv-hero__brands { flex-direction: row; justify-content: center; gap: 20px; } }
.pv-hero__brands-lab {
  font-family: var(--pv-mono);
  font-size: 11px; font-weight: 500;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--pv-ink-3);
}
.pv-hero__brands-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
.pv-brand-pill {
  display: inline-flex; align-items: center;
  background: var(--pv-surface);
  padding: 8px 16px;
  border-radius: var(--pv-r-pill);
  font-size: 13px; font-weight: 700;
  color: var(--pv-ink);
  letter-spacing: -0.005em;
  box-shadow: var(--pv-clay-sm);
  transition: transform 200ms var(--pv-ease), color 200ms var(--pv-ease);
}
.pv-brand-pill:hover { transform: translateY(-2px); color: var(--pv-primary); }

/* ====== ENVÍOS ====== */
.pv-ship {
  position: relative;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-bg);
  padding: 80px 0 96px;
  overflow: hidden;
}
@media (min-width: 900px) { .pv-ship { padding: 120px 0 140px; } }

.pv-mini-label {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--pv-mono);
  font-size: 11px; font-weight: 500;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--pv-ink-2);
}
.pv-mini-label::before {
  content: ""; display: inline-block;
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--pv-primary);
  box-shadow: 0 0 12px rgba(59,130,246,0.55);
}

.pv-ship__head {
  display: flex; flex-direction: column; gap: 18px;
  margin-bottom: 48px;
}
@media (min-width: 900px) { .pv-ship__head { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 56px; } }
.pv-ship__head-l { display: flex; flex-direction: column; gap: 12px; }
.pv-ship__title {
  font-size: clamp(40px, 7vw, 88px);
  font-weight: 800; letter-spacing: -0.035em; line-height: 0.95;
  margin: 0; color: var(--pv-ink); text-wrap: balance;
}
.pv-ship__title-em {
  background: linear-gradient(135deg, var(--pv-primary), var(--pv-purple));
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  font-style: italic;
}
.pv-ship__lead {
  font-size: clamp(15px, 1.6vw, 18px); font-weight: 500;
  line-height: 1.55; color: var(--pv-ink-2);
  margin: 0; max-width: 42ch;
}

/* Cards */
.pv-ship__cards {
  display: grid; grid-template-columns: 1fr; gap: 18px;
  margin-bottom: 80px;
}
@media (min-width: 720px) { .pv-ship__cards { grid-template-columns: 1fr 1fr; gap: 22px; } }
@media (min-width: 1100px) { .pv-ship__cards { grid-template-columns: repeat(2, 1fr); gap: 24px; } }

.pv-ship-card {
  position: relative; overflow: hidden;
  background: var(--pv-surface);
  border-radius: var(--pv-r);
  padding: 28px;
  display: flex; flex-direction: column; gap: 18px;
  box-shadow: var(--pv-clay);
  transition: transform 240ms var(--pv-ease);
}
.pv-ship-card:hover { transform: translateY(-4px); }
.pv-ship-card::before {
  content: ""; position: absolute; top: -60px; right: -60px;
  width: 180px; height: 180px; border-radius: 50%;
  background: var(--accent, var(--pv-primary)); opacity: 0.20;
  filter: blur(20px); pointer-events: none;
}
.pv-ship-card--blue   { --accent: var(--pv-primary); }
.pv-ship-card--green  { --accent: var(--pv-success); }
.pv-ship-card--purple { --accent: var(--pv-purple); }
.pv-ship-card--yellow { --accent: var(--pv-warning); }
.pv-ship-card--feat {
  background: linear-gradient(180deg, var(--pv-primary) 0%, var(--pv-primary-dk) 100%);
  color: #fff;
  box-shadow: var(--pv-clay-blue);
  grid-column: 1 / -1;
}
@media (min-width: 1100px) { .pv-ship-card--feat { grid-column: 1 / -1; padding: 36px 36px 32px; } }
.pv-ship-card--feat::before { background: rgba(255,255,255,0.4); opacity: 0.4; }
.pv-ship-card--feat .pv-ship-card__num,
.pv-ship-card--feat .pv-ship-card__list li > span:first-child { color: rgba(255,255,255,0.75); }
.pv-ship-card--feat .pv-ship-card__list li > span:last-child b { color: #fff; }
.pv-ship-card--feat .pv-ship-card__list li { border-color: rgba(255,255,255,0.20); }
.pv-ship-card--feat .pv-ship-card__icon { background: rgba(255,255,255,0.20); color: #fff; }

.pv-ship-card__top {
  display: flex; align-items: center; justify-content: space-between;
  position: relative; z-index: 1;
}
.pv-ship-card__num {
  font-family: var(--pv-mono);
  font-size: 11px; font-weight: 500;
  letter-spacing: 0.20em; color: var(--pv-ink-3);
}
.pv-ship-card__icon {
  width: 56px; height: 56px; border-radius: 50%;
  background: var(--accent, var(--pv-primary));
  color: #fff;
  display: inline-flex; align-items: center; justify-content: center;
  box-shadow: 0 10px 24px -6px var(--accent), inset 0 -4px 10px rgba(0,0,0,0.18), inset 0 4px 10px rgba(255,255,255,0.45);
}
.pv-ship-card__icon [data-lucide] { width: 24px; height: 24px; stroke-width: 2; }

.pv-ship-card__hero { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; position: relative; z-index: 1; }
.pv-ship-card__highlight {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,0.20);
  color: #fff;
  padding: 6px 14px; border-radius: var(--pv-r-pill);
  font-family: var(--pv-mono);
  font-size: 11px; font-weight: 500; letter-spacing: 0.10em; text-transform: uppercase;
  box-shadow: inset 0 -2px 6px rgba(0,0,0,0.15), inset 0 2px 6px rgba(255,255,255,0.30);
}
.pv-ship-card__title {
  margin: 0; font-size: clamp(28px, 3.6vw, 40px);
  font-weight: 800; letter-spacing: -0.02em; line-height: 1.05;
  color: inherit;
}
.pv-ship-card__big {
  display: flex; flex-direction: column; gap: 4px;
  position: relative; z-index: 1;
}
.pv-ship-card__big-lab {
  font-family: var(--pv-mono);
  font-size: 10.5px; font-weight: 500;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: rgba(255,255,255,0.75);
}
.pv-ship-card__big-num {
  font-size: clamp(36px, 5vw, 56px);
  font-weight: 800; letter-spacing: -0.035em; line-height: 1;
  color: inherit;
  font-variant-numeric: tabular-nums;
}
.pv-ship-card__big-num--free { color: var(--pv-success); letter-spacing: 0.02em; font-size: clamp(28px, 4vw, 40px); }
.pv-ship-card__big-num--alt { color: var(--accent, var(--pv-primary)); font-style: italic; font-size: clamp(28px, 4vw, 40px); }
.pv-ship-card__list {
  list-style: none; padding: 0; margin: 0;
  position: relative; z-index: 1;
}
.pv-ship-card__list li {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 12px 0;
  border-top: 1px solid rgba(28,57,142,0.10);
  font-size: 13px;
}
.pv-ship-card__list li:last-child { border-bottom: 1px solid rgba(28,57,142,0.10); }
.pv-ship-card__list li > span:first-child {
  font-family: var(--pv-mono);
  font-size: 10.5px; font-weight: 500;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--pv-ink-2);
}
.pv-ship-card__list li > span:last-child { font-weight: 600; color: var(--pv-ink); text-align: right; }
.pv-ship-card__list b { font-weight: 700; }

.pv-ship-card__cta {
  display: inline-flex; align-items: center; gap: 8px;
  align-self: flex-start;
  padding: 12px 18px;
  background: rgba(255,255,255,0.20);
  color: #fff;
  border-radius: var(--pv-r-pill);
  font-size: 13px; font-weight: 700;
  text-decoration: none;
  box-shadow: inset 0 -3px 8px rgba(0,0,0,0.18), inset 0 3px 8px rgba(255,255,255,0.30);
  transition: background 200ms var(--pv-ease), transform 200ms var(--pv-ease);
  position: relative; z-index: 1;
}
.pv-ship-card__cta:hover { background: rgba(255,255,255,0.30); transform: translateY(-2px); }
.pv-ship-card__cta [data-lucide] { width: 14px; height: 14px; }

/* Zonas GBA */
.pv-zones { margin-bottom: 80px; }
.pv-zones__head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 28px; }
.pv-zones__title {
  font-size: clamp(32px, 5vw, 56px);
  font-weight: 800; letter-spacing: -0.03em; line-height: 1;
  margin: 0; color: var(--pv-ink);
}
.pv-zones__title-em {
  background: linear-gradient(135deg, var(--pv-primary), var(--pv-purple));
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  font-style: italic;
}
.pv-zones__list {
  display: grid; grid-template-columns: 1fr; gap: 14px;
}
@media (min-width: 720px) { .pv-zones__list { grid-template-columns: 1fr 1fr; } }
.pv-zone {
  position: relative; overflow: hidden;
  background: var(--pv-surface);
  border-radius: var(--pv-r);
  padding: 22px 24px;
  box-shadow: var(--pv-clay);
  transition: transform 220ms var(--pv-ease);
}
.pv-zone:hover { transform: translateY(-3px); }
.pv-zone::before {
  content: ""; position: absolute; top: -40px; right: -40px;
  width: 140px; height: 140px; border-radius: 50%;
  background: var(--zc, var(--pv-primary)); opacity: 0.18;
  filter: blur(14px);
}
.pv-zone--green  { --zc: var(--pv-success); }
.pv-zone--blue   { --zc: var(--pv-primary); }
.pv-zone--orange { --zc: var(--pv-warning); }
.pv-zone--pink   { --zc: var(--pv-pink); }
.pv-zone__head {
  display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
  margin-bottom: 12px;
  position: relative; z-index: 1;
}
.pv-zone__name {
