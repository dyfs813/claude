/* Identidad visual por marca (sin usar logos oficiales) */
.pv-brand--energizer { --pv-brand-glow: radial-gradient(circle at 50% 0%, rgba(220,38,38,0.30), transparent 60%); }
.pv-brand--energizer .pv-brand__name { font-style: italic; letter-spacing: -0.04em; color: #FCA5A5; }
.pv-brand--duracell  { --pv-brand-glow: radial-gradient(circle at 50% 0%, rgba(234,88,12,0.30), transparent 60%); }
