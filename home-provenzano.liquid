{% comment %}
========================================================================
PROVENZANO HOME v2 — premium futurista (1 archivo)
========================================================================
Estructura focalizada:
  1. Hero — presentación + CTA principal al catálogo
  2. Brands — marquee sutil
  3. Catálogo showcase — productos destacados + CTA gigante
  4. Envíos — 4 modalidades interactivas
  5. Footer + WhatsApp FAB

Mobile-first (90% del tráfico). Testeado < 360px.
========================================================================
{% endcomment %}

{% schema %}
{
  "name": "Home Provenzano",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "logo_url",
      "label": "URL del logo",
      "default": "https://cdn.shopify.com/s/files/1/0729/9366/9368/files/provenzano-logo.svg?v=1777313813"
    },
    {
      "type": "text",
      "id": "wpp_phone",
      "label": "WhatsApp (sin + ni espacios)",
      "default": "5491141794592"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Colección de productos destacados (8 cards)"
    }
  ],
  "presets": [
    { "name": "Home Provenzano" }
  ]
}
{% endschema %}

{%- assign logo_url = section.settings.logo_url | default: 'https://cdn.shopify.com/s/files/1/0729/9366/9368/files/provenzano-logo.svg?v=1777313813' -%}
{%- assign wpp_phone = section.settings.wpp_phone | default: '5491141794592' -%}
{%- assign featured_products = section.settings.featured_collection.products | default: collections['destacados'].products -%}

<div class="pv-home-root">

  {%- comment -%} ============ HERO ============ {%- endcomment -%}
  <section class="pv-hero" id="provHero" data-spotlight>
    <div class="pv-hero__atmos" aria-hidden="true">
      <div class="pv-hero__mesh"></div>
      <div class="pv-hero__grid"></div>
      <div class="pv-hero__noise"></div>
      <div class="pv-hero__spotlight"></div>
      <div class="pv-hero__scanline"></div>
    </div>

    <header class="pv-hero__nav">
      <a href="/" class="pv-hero__brand" aria-label="Provenzano home">
        <span class="pv-hero__brand-mark"><img src="{{ logo_url }}" alt=""></span>
        <span class="pv-hero__brand-text">
          <span class="pv-hero__brand-name">Provenzano</span>
          <span class="pv-hero__brand-tag"><span class="pv-hero__brand-pulse"></span>Mayorista · Liniers</span>
        </span>
      </a>
      <div class="pv-hero__nav-actions">
        <a href="/search" class="pv-hero__nav-btn" aria-label="Buscar"><i data-lucide="search"></i></a>
        <a href="/cart" class="pv-hero__nav-btn pv-hero__nav-btn--cart" aria-label="Carrito">
          <i data-lucide="shopping-cart"></i>
          <span class="pv-hero__nav-badge" id="provCartBadge" style="display:none">0</span>
        </a>
      </div>
    </header>

    <div class="pv-hero__inner">
      <div class="pv-hero__copy">
        <span class="pv-chip pv-hero__chip">
          <span class="pv-chip__dot"></span>
          Desde 2003 · Liniers, CABA
        </span>

        <h1 class="pv-hero__title">
          Tu mayorista de <span class="pv-hero__shine">kiosco</span>,<br>
          sin vueltas.
        </h1>

        <p class="pv-hero__lead">
          Más de 20 años abasteciendo kioscos, almacenes y revendedores. Catálogo de 200+ productos con precios mayoristas <b>actualizados al día</b>.
        </p>

        <div class="pv-hero__ctas">
          <a href="/collections/all" class="pv-btn pv-btn--primary pv-btn--xl pv-hero__cta-main">
            <span>Armá tu pedido</span>
            <i data-lucide="arrow-right"></i>
          </a>
          <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola Provenzano, quiero hacer una consulta' | url_encode }}" target="_blank" rel="noopener" class="pv-btn pv-btn--ghost pv-btn--lg">
            <i data-lucide="message-circle"></i>
            WhatsApp
          </a>
        </div>

        <div class="pv-hero__creds">
          <div class="pv-hero__cred">
            <span class="pv-hero__cred-num" data-counter="20" data-suffix="+">0+</span>
            <span class="pv-hero__cred-lab">años en el rubro</span>
          </div>
          <div class="pv-hero__cred">
            <span class="pv-hero__cred-num" data-counter="216" data-suffix="+">0+</span>
            <span class="pv-hero__cred-lab">productos en stock</span>
          </div>
          <div class="pv-hero__cred">
            <span class="pv-hero__cred-num">A/B</span>
            <span class="pv-hero__cred-lab">factura</span>
          </div>
        </div>
      </div>

      <aside class="pv-hero__visual" aria-hidden="true">
        <div class="pv-hero__stage" id="provHeroStage">
          <div class="pv-map">
            <svg class="pv-map__svg" viewBox="0 0 400 540" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
              <defs>
                <radialGradient id="pv-map-glow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="rgba(147,197,253,0.5)"/>
                  <stop offset="100%" stop-color="rgba(147,197,253,0)"/>
                </radialGradient>
                <linearGradient id="pv-map-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="rgba(96,165,250,0.10)"/>
                  <stop offset="100%" stop-color="rgba(24,95,165,0.05)"/>
                </linearGradient>
              </defs>
              <g class="pv-map__country">
                <path d="M 220,40 L 235,55 L 240,75 L 248,95 L 256,115 L 268,140 L 274,165 L 282,195 L 290,225 L 296,255 L 298,290 L 290,325 L 280,360 L 268,395 L 252,425 L 234,450 L 215,470 L 195,485 L 178,495 L 165,505 L 158,520 L 162,533 L 175,530 L 175,512 L 188,508 L 192,495 L 178,488 L 198,470 L 215,455 L 220,470 L 215,488 L 218,500 L 232,492 L 230,478 L 240,460 L 252,440 L 230,425 L 215,395 L 200,370 L 185,345 L 170,335 L 155,330 L 148,320 L 152,300 L 168,285 L 180,272 L 186,250 L 178,225 L 168,200 L 155,180 L 148,158 L 152,135 L 162,115 L 175,95 L 188,72 L 200,55 L 210,42 Z" fill="url(#pv-map-gradient)" stroke="rgba(147,197,253,0.30)" stroke-width="1" stroke-linejoin="round"/>
              </g>
              <g class="pv-map__lines" stroke-linecap="round" fill="none">
                <path class="pv-map__line" style="--delay:0s" d="M 260,295 Q 270,330 255,360" stroke="#93C5FD" stroke-width="1.5"/>
                <path class="pv-map__line" style="--delay:0.4s" d="M 260,295 Q 240,270 230,235" stroke="#93C5FD" stroke-width="1.5"/>
                <path class="pv-map__line" style="--delay:0.8s" d="M 260,295 Q 235,250 220,200" stroke="#93C5FD" stroke-width="1.5"/>
                <path class="pv-map__line" style="--delay:1.2s" d="M 260,295 Q 225,265 200,230" stroke="#93C5FD" stroke-width="1.5"/>
                <path class="pv-map__line" style="--delay:1.6s" d="M 260,295 Q 210,300 170,280" stroke="#93C5FD" stroke-width="1.5"/>
              </g>
              <g class="pv-map__origin" transform="translate(260,295)">
                <circle r="22" fill="url(#pv-map-glow)" opacity="0.7"/>
                <circle class="pv-map__ping" r="8" fill="none" stroke="#93C5FD" stroke-width="1.5" opacity="0.7"/>
                <circle class="pv-map__ping" r="8" fill="none" stroke="#93C5FD" stroke-width="1.5" opacity="0.7" style="animation-delay:1s"/>
                <circle r="8" fill="#185FA5" stroke="#93C5FD" stroke-width="2"/>
                <circle r="3" fill="#fff"/>
              </g>
              <g class="pv-map__pin" style="--delay:1.4s" transform="translate(255,360)"><circle r="3.5" fill="#93C5FD"/><circle r="3.5" fill="#93C5FD" class="pv-map__pin-pulse"/></g>
              <g class="pv-map__pin" style="--delay:1.8s" transform="translate(230,235)"><circle r="3.5" fill="#93C5FD"/><circle r="3.5" fill="#93C5FD" class="pv-map__pin-pulse"/></g>
              <g class="pv-map__pin" style="--delay:2.2s" transform="translate(220,200)"><circle r="3.5" fill="#93C5FD"/><circle r="3.5" fill="#93C5FD" class="pv-map__pin-pulse"/></g>
              <g class="pv-map__pin" style="--delay:2.6s" transform="translate(200,230)"><circle r="3.5" fill="#93C5FD"/><circle r="3.5" fill="#93C5FD" class="pv-map__pin-pulse"/></g>
              <g class="pv-map__pin" style="--delay:3.0s" transform="translate(170,280)"><circle r="3.5" fill="#93C5FD"/><circle r="3.5" fill="#93C5FD" class="pv-map__pin-pulse"/></g>
            </svg>

            <span class="pv-map__label pv-map__label--origin" style="--x:65%;--y:54.6%">
              <span class="pv-map__label-eyebrow">Origen</span>
              CABA · GBA
            </span>
            <span class="pv-map__label" style="--x:64%;--y:67%">Mar del Plata</span>
            <span class="pv-map__label" style="--x:58%;--y:43.5%">Rosario</span>
            <span class="pv-map__label pv-map__label--left" style="--x:50%;--y:42.6%">Córdoba</span>
            <span class="pv-map__label pv-map__label--left" style="--x:42.5%;--y:51.8%">Mendoza</span>
          </div>

          <div class="pv-hero__hud pv-hero__hud--tl">
            <span class="pv-hero__hud-lab">Cobertura</span>
            <span class="pv-hero__hud-val">CABA · GBA · 24 provincias</span>
          </div>
          <div class="pv-hero__hud pv-hero__hud--br">
            <span class="pv-hero__hud-status"><span class="pv-hero__hud-dot"></span>Despachando</span>
            <span class="pv-hero__hud-mono">CABA · mismo día</span>
          </div>
        </div>
      </aside>
    </div>

    <a href="#provCatalog" class="pv-hero__scroll" aria-label="Bajar al catálogo">
      <span class="pv-hero__scroll-mouse"><span class="pv-hero__scroll-wheel"></span></span>
      <span class="pv-hero__scroll-text">Catálogo</span>
    </a>
  </section>
  {%- comment -%} ============ BRANDS ============ {%- endcomment -%}
  <section class="pv-brands" aria-label="Marcas oficiales">
    <div class="pv-brands__inner">
      <span class="pv-brands__title">Marcas oficiales</span>
      <div class="pv-brands__marquee">
        <ul class="pv-brands__track">
          <li class="pv-brand pv-brand--energizer"><span>Energizer</span></li>
          <li class="pv-brand-sep" aria-hidden="true"></li>
          <li class="pv-brand pv-brand--duracell"><span>Duracell</span></li>
          <li class="pv-brand-sep" aria-hidden="true"></li>
          <li class="pv-brand pv-brand--gillette"><span>Gillette</span></li>
          <li class="pv-brand-sep" aria-hidden="true"></li>
          <li class="pv-brand pv-brand--candela"><span>Candela</span></li>
          <li class="pv-brand-sep" aria-hidden="true"></li>
          <li class="pv-brand pv-brand--bic"><span>BIC</span></li>
          <li class="pv-brand-sep" aria-hidden="true"></li>
          <li class="pv-brand pv-brand--energizer" aria-hidden="true"><span>Energizer</span></li>
          <li class="pv-brand-sep" aria-hidden="true"></li>
          <li class="pv-brand pv-brand--duracell" aria-hidden="true"><span>Duracell</span></li>
          <li class="pv-brand-sep" aria-hidden="true"></li>
          <li class="pv-brand pv-brand--gillette" aria-hidden="true"><span>Gillette</span></li>
          <li class="pv-brand-sep" aria-hidden="true"></li>
          <li class="pv-brand pv-brand--candela" aria-hidden="true"><span>Candela</span></li>
          <li class="pv-brand-sep" aria-hidden="true"></li>
          <li class="pv-brand pv-brand--bic" aria-hidden="true"><span>BIC</span></li>
        </ul>
      </div>
    </div>
  </section>
  {%- comment -%} ============ CATALOG ============ {%- endcomment -%}
  <section class="pv-cat" id="provCatalog" data-spotlight>
    <div class="pv-cat__atmos" aria-hidden="true">
      <div class="pv-cat__mesh"></div>
      <div class="pv-cat__grid"></div>
      <div class="pv-cat__spotlight"></div>
    </div>

    <div class="pv-cat__inner">
      <header class="pv-cat__head pv-reveal">
        <div class="pv-cat__head-left">
          <span class="pv-chip"><span class="pv-chip__dot"></span>Catálogo en vivo · 200+ productos</span>
          <h2 class="pv-cat__title">
            Mirá. Elegí.<br>
            <span class="pv-cat__title-accent">Armá tu pedido.</span>
          </h2>
          <p class="pv-cat__lead">
            Todo el catálogo con <b>precios mayoristas actualizados constantemente</b>. Stock real, sin esperar respuestas. Lo que ves es lo que hay.
          </p>
        </div>
        <a href="/collections/all" class="pv-btn pv-btn--primary pv-btn--xl pv-cat__head-cta">
          Ver catálogo completo
          <i data-lucide="arrow-up-right"></i>
        </a>
      </header>

      <div class="pv-cat__featbar pv-reveal">
        <div class="pv-cat__feat"><i data-lucide="zap"></i> Precios al día</div>
        <div class="pv-cat__feat"><i data-lucide="package-check"></i> Stock real</div>
        <div class="pv-cat__feat"><i data-lucide="layers"></i> Por bulto o suelto</div>
        <div class="pv-cat__feat"><i data-lucide="shield-check"></i> Marcas oficiales</div>
      </div>

      {% if featured_products.size > 0 %}
      <div class="pv-cat__rail">
        <div class="pv-cat__rail-head">
          <span class="pv-cat__rail-eye"><span class="pv-chip__dot"></span>Lo más pedido esta semana</span>
          <span class="pv-cat__rail-mono">8 / <span data-counter="216" data-suffix="+">0+</span></span>
        </div>

        <div class="pv-cat__grid-products">
          {% for product in featured_products limit: 8 %}
            {% assign units = product.metafields.custom.bulk_units | default: 0 %}
            {% assign sku_num = forloop.index | prepend: '00' | slice: -3, 3 %}
            <a href="{{ product.url }}" class="pv-pcard pv-reveal" style="--delay:{{ forloop.index0 | times: 60 }}ms">
              <span class="pv-pcard__sku">SKU·{{ sku_num }}</span>
              <span class="pv-pcard__live">
                <span class="pv-pcard__live-dot"></span> En stock
              </span>
              <div class="pv-pcard__img">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '500x500' }}" alt="{{ product.title }}" loading="lazy">
                {% endif %}
                <div class="pv-pcard__shine" aria-hidden="true"></div>
              </div>
              <div class="pv-pcard__body">
                {% if product.type and product.type != '' %}<span class="pv-pcard__cat">{{ product.type }}</span>{% endif %}
                <h3 class="pv-pcard__name">{{ product.title }}</h3>
                {% if units > 0 %}
                  <div class="pv-pcard__bulk"><i data-lucide="package"></i> Bulto x<b>{{ units }}</b></div>
                {% endif %}
              </div>
              <div class="pv-pcard__bottom">
                <div class="pv-pcard__price-block">
                  <span class="pv-pcard__price-lab">Mayorista</span>
                  <span class="pv-pcard__price">{{ product.price | money }}</span>
                </div>
                <span class="pv-pcard__add" aria-hidden="true">
                  <i data-lucide="arrow-right"></i>
                </span>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      <div class="pv-cat__cta pv-reveal">
        <div class="pv-cat__cta-num">
          <span class="pv-cat__cta-num-val" data-counter="208" data-suffix="+">0+</span>
          <span class="pv-cat__cta-num-lab">productos más<br>en el catálogo</span>
        </div>
        <a href="/collections/all" class="pv-btn pv-btn--primary pv-btn--xl">
          Armá tu pedido ahora
          <i data-lucide="arrow-right"></i>
        </a>
        <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola Provenzano, quiero hacer una consulta' | url_encode }}" target="_blank" rel="noopener" class="pv-btn pv-btn--ghost pv-btn--lg">
          <i data-lucide="message-circle"></i>
          Consultar
        </a>
      </div>
    </div>
  </section>
  {%- comment -%} ============ SHIPPING ============ {%- endcomment -%}
  <section class="pv-ship" id="provShip">
    <div class="pv-ship__atmos" aria-hidden="true">
      <div class="pv-ship__mesh"></div>
      <div class="pv-ship__grid"></div>
    </div>

    <div class="pv-ship__inner">
      <header class="pv-ship__head pv-reveal">
        <span class="pv-chip"><span class="pv-chip__dot"></span>Envíos · 4 modalidades</span>
        <h2 class="pv-ship__title">
          ¿Cómo te llega <span class="pv-ship__title-accent">tu pedido?</span>
        </h2>
        <p class="pv-ship__lead">
          Elegí cómo querés recibirlo. Tocá la modalidad para ver los detalles.
        </p>
      </header>

      <div class="pv-ship__widget pv-reveal">
        <div class="pv-ship__tabs" role="tablist" aria-label="Modalidades de envío">
          <button type="button" class="pv-ship__tab is-active" role="tab" aria-selected="true" data-tab="retiro">
            <span class="pv-ship__tab-num">01</span>
            <span class="pv-ship__tab-icon"><i data-lucide="store"></i></span>
            <span class="pv-ship__tab-label">Retiro</span>
            <span class="pv-ship__tab-sub">Sucursal</span>
          </button>
          <button type="button" class="pv-ship__tab" role="tab" aria-selected="false" data-tab="caba">
            <span class="pv-ship__tab-num">02</span>
            <span class="pv-ship__tab-icon"><i data-lucide="truck"></i></span>
            <span class="pv-ship__tab-label">CABA · GBA</span>
            <span class="pv-ship__tab-sub">A domicilio</span>
          </button>
          <button type="button" class="pv-ship__tab" role="tab" aria-selected="false" data-tab="interior">
            <span class="pv-ship__tab-num">03</span>
            <span class="pv-ship__tab-icon"><i data-lucide="map"></i></span>
            <span class="pv-ship__tab-label">Interior</span>
            <span class="pv-ship__tab-sub">Vía cargo</span>
          </button>
          <button type="button" class="pv-ship__tab" role="tab" aria-selected="false" data-tab="comisio">
            <span class="pv-ship__tab-num">04</span>
            <span class="pv-ship__tab-icon"><i data-lucide="handshake"></i></span>
            <span class="pv-ship__tab-label">Comisionista</span>
            <span class="pv-ship__tab-sub">Tu transporte</span>
          </button>
        </div>

        <div class="pv-ship__panels">

          {%- comment -%} ===== TAB 1 · RETIRO ===== {%- endcomment -%}
          <article class="pv-ship__panel is-active" data-panel="retiro" role="tabpanel">
            <div class="pv-ship__panel-side">
              <div class="pv-ship__visual pv-ship__visual--store">
                <div class="pv-ship__visual-glow"></div>
                <i data-lucide="store" class="pv-ship__visual-icon"></i>
                <div class="pv-ship__pin">
                  <span class="pv-ship__pin-dot"></span>
                  <span class="pv-ship__pin-label">Carhué 74<br>Liniers, CABA</span>
                </div>
              </div>
            </div>
            <div class="pv-ship__panel-body">
              <span class="pv-ship__panel-eye"><i data-lucide="check-circle-2"></i> Sin costo de envío</span>
              <h3 class="pv-ship__panel-title">Pasá a buscar tu pedido</h3>
              <p class="pv-ship__panel-text">Te avisamos por WhatsApp cuando esté listo. Vení tranqui en horario comercial.</p>
              <div class="pv-ship__facts">
                <div class="pv-ship__fact">
                  <span class="pv-ship__fact-lab">Costo</span>
                  <span class="pv-ship__fact-val pv-ship__fact-val--free">GRATIS</span>
                </div>
                <div class="pv-ship__fact">
                  <span class="pv-ship__fact-lab">Pedido mínimo</span>
                  <span class="pv-ship__fact-val">$100.000</span>
                </div>
                <div class="pv-ship__fact">
                  <span class="pv-ship__fact-lab">Días</span>
                  <span class="pv-ship__fact-val">Lun. a Sáb.</span>
                </div>
                <div class="pv-ship__fact">
                  <span class="pv-ship__fact-lab">Dirección</span>
                  <span class="pv-ship__fact-val">Carhué 74, Liniers</span>
                </div>
              </div>
              <a href="https://www.google.com/maps/search/?api=1&query=Carh%C3%BA%C3%A9+74+Liniers+CABA" target="_blank" rel="noopener" class="pv-btn pv-btn--ghost">
                <i data-lucide="map-pin"></i> Cómo llegar
              </a>
            </div>
          </article>

          {%- comment -%} ===== TAB 2 · CABA Y GBA ===== {%- endcomment -%}
          <article class="pv-ship__panel" data-panel="caba" role="tabpanel">
            <div class="pv-ship__panel-side">
              <div class="pv-ship__zones">
                <div class="pv-ship__zone pv-ship__zone--caba">
                  <span class="pv-ship__zone-name">CABA</span>
                  <span class="pv-ship__zone-price">$4.100</span>
                  <span class="pv-ship__zone-info">Toda la Capital</span>
                </div>
                <div class="pv-ship__zone pv-ship__zone--g1">
                  <span class="pv-ship__zone-name">GBA <b>1</b></span>
                  <span class="pv-ship__zone-price">$5.000</span>
                  <span class="pv-ship__zone-info">Avellaneda · Lanús · Lomas · La Matanza N · Morón · 3 de Febrero · San Martín · Vte. López · San Isidro</span>
                </div>
                <div class="pv-ship__zone pv-ship__zone--g2">
                  <span class="pv-ship__zone-name">GBA <b>2</b></span>
                  <span class="pv-ship__zone-price">$6.000</span>
                  <span class="pv-ship__zone-info">San Fernando · Tigre · Malvinas Arg. · José C. Paz · San Miguel · Hurlingham · Ituzaingó · La Matanza S · Merlo · Moreno · E. Echeverría · Alte. Brown · Ezeiza · Quilmes · F. Varela · Berazategui</span>
                </div>
                <div class="pv-ship__zone pv-ship__zone--g3">
                  <span class="pv-ship__zone-name">GBA <b>3</b></span>
                  <span class="pv-ship__zone-price">$7.900</span>
                  <span class="pv-ship__zone-info">Zárate · Campana · Escobar · Maschwitz · Garín · Pilar · Del Viso · Derqui · Villa Rosa · Luján · Gral. Rodríguez · Marcos Paz · Nordelta · San Vicente · Guernica · Berisso · La Plata · Cañuelas · Ensenada</span>
                </div>
              </div>
            </div>
            <div class="pv-ship__panel-body">
              <span class="pv-ship__panel-eye pv-ship__panel-eye--accent"><i data-lucide="gift"></i> Envío GRATIS desde $600.000</span>
              <h3 class="pv-ship__panel-title">A tu puerta, martes y jueves</h3>
              <p class="pv-ship__panel-text">Despachamos a las 14hs. Llega entre las 14hs y las 21hs del mismo día. Tocá una zona para ver los partidos.</p>
              <div class="pv-ship__facts">
                <div class="pv-ship__fact">
