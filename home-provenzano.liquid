<style>
/* ============================================================
   PROVENZANO HOME — STYLES
   ============================================================ */

/* Reset suave dentro del root */
.pv-home-root, .pv-home-root *, .pv-home-root *::before, .pv-home-root *::after { box-sizing: border-box; }
.pv-home-root [data-lucide] { width: 20px; height: 20px; stroke-width: 2; flex-shrink: 0; }
.pv-home-root img { max-width: 100%; }

/* Variables globales */
.pv-home-root {
  --pv-bg: #0A1A2E;
  --pv-bg-2: #0F2340;
  --pv-primary: #185FA5;
  --pv-primary-dk: #0C447C;
  --pv-accent: #93C5FD;
  --pv-wa: #25D366;
  --pv-text: #fff;
  --pv-text-mute: rgba(255,255,255,0.65);
  --pv-text-soft: rgba(255,255,255,0.92);
  --pv-border: rgba(255,255,255,0.10);
  --pv-border-2: rgba(255,255,255,0.14);
  --pv-glass: rgba(255,255,255,0.06);
  --pv-glass-2: rgba(255,255,255,0.04);
  --pv-font: 'Manrope', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --pv-mono: 'SF Mono', 'Monaco', 'Roboto Mono', Consolas, monospace;
  --pv-ease: cubic-bezier(.2,.7,.3,1);
  font-family: var(--pv-font);
}

/* ====== EYEBROWS comunes ====== */
.pv-eyebrow--live, .pv-eyebrow--dark {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--pv-glass);
  border: 1px solid var(--pv-border-2);
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
  color: var(--pv-text-soft);
  padding: 7px 14px; border-radius: 9999px;
  font-size: 11px; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase;
  white-space: nowrap;
  font-family: var(--pv-font);
}
.pv-eyebrow__dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: #10B981;
  box-shadow: 0 0 0 0 rgba(16,185,129,0.6);
  animation: pvPulseDot 1.8s var(--pv-ease) infinite;
  flex-shrink: 0;
}
@keyframes pvPulseDot {
  0%, 100% { box-shadow: 0 0 0 0 rgba(16,185,129,0.6); }
  50%      { box-shadow: 0 0 0 8px rgba(16,185,129,0); }
}

/* ====== BOTONES ====== */
.pv-btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 10px; height: 44px; padding: 0 24px;
  border-radius: 12px; border: none;
  font-family: var(--pv-font);
  font-size: 15px; font-weight: 800;
  letter-spacing: -0.005em;
  text-decoration: none; cursor: pointer; white-space: nowrap;
  transition: transform 120ms var(--pv-ease), background 200ms var(--pv-ease), box-shadow 200ms var(--pv-ease), filter 200ms var(--pv-ease);
}
.pv-btn:active { transform: translateY(1px) scale(.99); }
.pv-btn--lg { height: 52px; padding: 0 28px; font-size: 16px; }
@media (min-width: 720px) { .pv-btn--lg { height: 54px; padding: 0 32px; font-size: 17px; } }
.pv-btn--primary { background: var(--pv-primary); color: #fff !important; box-shadow: 0 8px 24px rgba(24,95,165,.35); }
.pv-btn--primary:hover { background: var(--pv-primary-dk); }
.pv-btn--whatsapp { background: var(--pv-wa); color: #fff !important; box-shadow: 0 8px 24px rgba(37,211,102,.32); }
.pv-btn--whatsapp:hover { filter: brightness(0.95); }
.pv-btn--ghost.pv-btn--on-dark { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.18); color: #fff !important; }
.pv-btn--ghost.pv-btn--on-dark:hover { background: rgba(255,255,255,0.10); border-color: rgba(255,255,255,0.30); }
.pv-btn [data-lucide] { width: 18px; height: 18px; }

/* ====== HEADER ====== */
.pv-header {
  position: sticky; top: 0; z-index: 50;
  background: rgba(10, 26, 46, 0.55);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  transition: background 240ms var(--pv-ease), border-color 240ms var(--pv-ease);
}
.pv-header.is-scrolled {
  background: rgba(10, 26, 46, 0.88);
  border-bottom-color: rgba(255,255,255,0.14);
}
.pv-header__inner {
  max-width: 1280px; margin: 0 auto;
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px; min-height: 60px;
}
.pv-header__logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.pv-header__mark {
  width: 36px; height: 36px;
  display: inline-flex; align-items: center; justify-content: center;
  background: linear-gradient(180deg, #fff 0%, #F0F6FC 100%);
  border-radius: 10px; padding: 6px;
  box-shadow: 0 0 0 1px rgba(147,197,253,0.30), 0 6px 16px rgba(0,0,0,0.20);
  flex-shrink: 0;
}
.pv-header__mark img { width: 100%; height: 100%; object-fit: contain; }
.pv-header__wordmark { display: flex; flex-direction: column; line-height: 1.05; gap: 2px; }
.pv-header__brand { font-size: 16px; font-weight: 900; letter-spacing: -0.025em; color: #fff; }
.pv-header__tag {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 9.5px; font-weight: 800;
  letter-spacing: 0.10em; text-transform: uppercase;
  color: rgba(147,197,253,0.85);
}
.pv-header__dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: #25D366;
  box-shadow: 0 0 8px rgba(37,211,102,0.7);
  animation: pvPulseDot 2s var(--pv-ease) infinite;
}
.pv-header__search {
  flex: 1; min-width: 0;
  display: flex; align-items: center; gap: 10px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 12px;
  height: 40px; padding: 0 10px 0 14px;
  color: rgba(255,255,255,0.55);
  font-size: 13px; font-weight: 500;
  text-decoration: none;
  transition: background 180ms var(--pv-ease), border-color 180ms var(--pv-ease);
}
.pv-header__search:hover { background: rgba(255,255,255,0.10); border-color: rgba(255,255,255,0.18); }
.pv-header__search [data-lucide] { color: rgba(255,255,255,0.55); width: 16px; height: 16px; }
.pv-header__search > span { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pv-header__kbd {
  display: none;
  font-family: var(--pv-mono); font-size: 10px; font-weight: 700;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 5px; padding: 3px 6px;
  color: rgba(255,255,255,0.65);
}
@media (min-width: 720px) { .pv-header__kbd { display: inline-flex; } }
.pv-header__cart {
  position: relative; width: 40px; height: 40px; border-radius: 12px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.10);
  color: #fff;
  display: inline-flex; align-items: center; justify-content: center;
  text-decoration: none; flex-shrink: 0;
  transition: background 180ms var(--pv-ease);
}
.pv-header__cart:hover { background: rgba(255,255,255,0.10); }
.pv-header__cart [data-lucide] { width: 18px; height: 18px; }
.pv-header__cart-badge {
  position: absolute; top: -4px; right: -4px;
  background: var(--pv-primary); color: #fff;
  min-width: 18px; height: 18px; padding: 0 5px;
  border-radius: 9999px;
  font-size: 10px; font-weight: 800;
  display: inline-flex; align-items: center; justify-content: center;
  border: 2px solid #0A1A2E;
}
/* Beam tipo "scan line" sutil al final del header */
.pv-header__beam {
  height: 1px; width: 100%;
  background: linear-gradient(90deg, transparent, rgba(147,197,253,0.5), transparent);
  opacity: 0.5;
  animation: pvHeaderBeam 6s ease-in-out infinite;
}
@keyframes pvHeaderBeam {
  0%, 100% { opacity: 0.2; }
  50% { opacity: 0.7; }
}
@media (max-width: 600px) {
  .pv-header__search > span { display: none; }
  .pv-header__search { width: 40px; flex: 0 0 auto; padding: 0; justify-content: center; }
  .pv-header__wordmark { display: none; }
}

/* ====== HERO ====== */
.pv-hero {
  position: relative; overflow: hidden;
  width: 100vw; margin-left: calc(-50vw + 50%);
  padding: 32px 16px 48px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  background: var(--pv-bg);
  color: #fff;
}
.pv-hero__bg {
  position: absolute; inset: 0; z-index: 0;
  background:
    radial-gradient(900px 500px at 88% -10%, rgba(59,130,246,.35) 0%, rgba(10,26,46,0) 70%),
    radial-gradient(700px 400px at -10% 110%, rgba(24,95,165,.30) 0%, rgba(10,26,46,0) 70%),
    linear-gradient(180deg, var(--pv-bg) 0%, var(--pv-bg-2) 100%);
}
.pv-hero__grid-bg {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 56px 56px;
  -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 40%, transparent 100%);
  mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 40%, transparent 100%);
}
.pv-hero__orb {
  position: absolute; border-radius: 50%;
  filter: blur(80px); opacity: 0.45;
  animation: pvHeroOrbFloat 18s ease-in-out infinite alternate;
}
.pv-hero__orb--a { width: 380px; height: 380px; background: #185FA5; top: -120px; right: -80px; }
.pv-hero__orb--b { width: 320px; height: 320px; background: #0C447C; bottom: -100px; left: -60px; animation-duration: 22s; animation-direction: alternate-reverse; }
@keyframes pvHeroOrbFloat {
  from { transform: translate(0, 0) scale(1); }
  to   { transform: translate(40px, 30px) scale(1.1); }
}

.pv-hero__inner {
  position: relative; z-index: 1;
  max-width: 1280px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr; gap: 32px;
  align-items: center;
}
.pv-hero__copy { display: flex; flex-direction: column; align-items: flex-start; }
.pv-hero__title {
  font-size: clamp(30px, 8vw, 72px);
  font-weight: 900;
  letter-spacing: -0.025em;
  line-height: 1.06;
  margin: 20px 0 20px;
  max-width: 18ch;
  color: #fff; text-wrap: balance;
}
.pv-hero__title-accent {
  color: var(--pv-accent);
  background-image: linear-gradient(180deg, transparent 70%, rgba(147,197,253,.30) 70%, rgba(147,197,253,.30) 92%, transparent 92%);
  background-repeat: no-repeat; padding: 0 4px;
}
.pv-hero__lead {
  font-size: 15px; font-weight: 500;
  color: rgba(255,255,255,0.72);
  margin: 0 0 24px;
  max-width: 50ch; line-height: 1.6;
}
.pv-hero__ctas { display: flex; flex-wrap: wrap; gap: 10px; width: 100%; }
.pv-hero__ctas .pv-btn { flex: 1 1 auto; min-width: 0; }
@media (min-width: 720px) {
  .pv-hero__ctas { width: auto; }
  .pv-hero__ctas .pv-btn { flex: 0 0 auto; }
}
.pv-hero__stats {
  display: flex; align-items: stretch;
  margin-top: 28px;
  padding: 14px 16px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.10);
  -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
  border-radius: 16px;
  width: 100%; max-width: 560px;
}
.pv-hero__stat { display: flex; flex-direction: column; padding: 4px 12px; flex: 1; min-width: 0; }
.pv-hero__stat:first-child { padding-left: 0; }
.pv-hero__stat:last-child  { padding-right: 0; }
.pv-hero__stat-value {
  font-size: clamp(20px, 5vw, 30px);
  font-weight: 900; color: #fff;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums; line-height: 1;
}
.pv-hero__stat-label {
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.10em; text-transform: uppercase;
  color: rgba(255,255,255,0.55); margin-top: 6px;
}
.pv-hero__stat-div { width: 1px; background: rgba(255,255,255,0.12); margin: 4px 0; align-self: stretch; }

.pv-hero__visual { position: relative; min-height: 320px; }
.pv-hero__stage {
  position: relative; width: 100%;
  aspect-ratio: 5/3;
  max-width: 600px; margin: 0 auto;
  --tilt-x: 0px; --tilt-y: 0px;
}

/* MAPA */
.pv-map {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  padding: 12px;
  transform: translate(var(--tilt-y, 0), var(--tilt-x, 0));
  transition: transform 400ms var(--pv-ease);
}
.pv-map__svg { width: auto; height: 100%; max-width: 100%; filter: drop-shadow(0 24px 48px rgba(12,30,60,0.5)); }
.pv-map__country path:first-child { filter: drop-shadow(0 0 12px rgba(147,197,253,0.15)); }
.pv-map__line {
  stroke-dasharray: 200; stroke-dashoffset: 200;
  filter: drop-shadow(0 0 4px rgba(147,197,253,0.6));
  animation: pvMapLineDraw 4s cubic-bezier(.4,0,.2,1) infinite;
  animation-delay: var(--delay, 0s);
}
@keyframes pvMapLineDraw {
  0%   { stroke-dashoffset: 200; opacity: 0; }
  10%  { opacity: 1; }
  60%  { stroke-dashoffset: 0; opacity: 1; }
  85%  { opacity: 1; }
  100% { stroke-dashoffset: 0; opacity: 0; }
}
.pv-map__origin { filter: drop-shadow(0 0 8px rgba(147,197,253,0.6)); }
.pv-map__ping {
  transform-origin: center; transform-box: fill-box;
  animation: pvMapPing 2s ease-out infinite;
}
@keyframes pvMapPing {
  0%   { transform: scale(1); opacity: 0.7; }
  100% { transform: scale(3.5); opacity: 0; }
}
.pv-map__pin circle:first-child { filter: drop-shadow(0 0 4px rgba(147,197,253,0.8)); }
.pv-map__pin-pulse {
  transform-origin: center; transform-box: fill-box;
  animation: pvMapPinPulse 4s ease-out infinite;
  animation-delay: var(--delay, 0s); opacity: 0;
}
@keyframes pvMapPinPulse {
  0%, 30% { transform: scale(1); opacity: 0; }
  40%     { transform: scale(1); opacity: 0.8; }
  70%     { transform: scale(2.5); opacity: 0; }
  100%    { transform: scale(2.5); opacity: 0; }
}
.pv-map__label {
  position: absolute; left: var(--x, 50%); top: var(--y, 50%);
  transform: translate(8px, -50%);
  font-size: 9.5px; font-weight: 800;
  color: rgba(255,255,255,0.78);
  background: rgba(10,26,46,0.55);
  border: 1px solid rgba(147,197,253,0.18);
  -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  padding: 3px 7px; border-radius: 4px;
  white-space: nowrap; pointer-events: none; z-index: 3;
}
.pv-map__label--left { transform: translate(calc(-100% - 8px), -50%); }
.pv-map__label--origin {
  font-size: 10.5px; font-weight: 900; color: #fff;
  background: rgba(24,95,165,0.40);
  border-color: rgba(147,197,253,0.50);
  padding: 5px 9px;
  display: flex; flex-direction: column; line-height: 1.15; z-index: 4;
}
.pv-map__label-eyebrow {
  font-size: 8px; font-weight: 800;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: rgba(147,197,253,0.85); margin-bottom: 2px;
}
@media (max-width: 540px) {
  .pv-map__label { font-size: 8px; padding: 2px 5px; }
  .pv-map__label--origin { font-size: 9px; padding: 3px 6px; }
  .pv-map__label-eyebrow { font-size: 7px; }
}

/* HUD */
.pv-hero__hud {
  position: absolute; z-index: 5;
  background: rgba(10,26,46,0.65);
  border: 1px solid rgba(255,255,255,0.14);
  -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
  border-radius: 12px; padding: 8px 12px;
  display: flex; flex-direction: column; gap: 4px;
  font-size: 11px; pointer-events: none; min-width: 130px;
}
.pv-hero__hud--tl { top: 8px; left: 8px; }
.pv-hero__hud--br { bottom: 8px; right: 8px; }
.pv-hero__hud-label { font-size: 8.5px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.55); }
.pv-hero__hud-value { font-size: 12px; font-weight: 800; color: #fff; }
.pv-hero__hud-row { display: flex; align-items: center; gap: 8px; }
.pv-hero__hud-dot { width: 6px; height: 6px; border-radius: 50%; background: #10B981; box-shadow: 0 0 8px #10B981; animation: pvPulseDot 2s var(--pv-ease) infinite; }
.pv-hero__hud-text { font-size: 10.5px; font-weight: 700; color: rgba(255,255,255,0.9); }
.pv-hero__hud-text-mono { font-size: 10.5px; font-weight: 600; color: rgba(255,255,255,0.65); font-variant-numeric: tabular-nums; letter-spacing: 0.04em; font-family: var(--pv-mono); }

@media (min-width: 720px) {
  .pv-hero { padding: 56px 32px 80px; }
  .pv-hero__inner { grid-template-columns: 1.05fr 1fr; gap: 56px; }
  .pv-hero__lead { font-size: 17px; }
  .pv-hero__visual { min-height: 460px; }
  .pv-hero__hud { padding: 10px 14px; font-size: 12px; }
  .pv-hero__hud-value { font-size: 13px; }
}
@media (min-width: 1000px) { .pv-hero { padding: 72px 32px 96px; } }

/* ====== TRUST BAND ====== */
.pv-trust {
  position: relative; overflow: hidden;
  width: 100vw; margin-left: calc(-50vw + 50%);
  background: var(--pv-bg-2);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 28px 16px;
}
.pv-trust__bg {
  position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(147,197,253,0.05) 50%, transparent);
  pointer-events: none;
}
.pv-trust__inner {
  max-width: 1280px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
  position: relative; z-index: 1;
}
@media (min-width: 720px) { .pv-trust__inner { grid-template-columns: repeat(4, 1fr); gap: 14px; } }
.pv-trust__card {
  display: flex; align-items: center; gap: 12px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 14px 14px;
  transition: transform 240ms var(--pv-ease), border-color 240ms var(--pv-ease), background 240ms var(--pv-ease);
  animation: pvTrustIn 600ms var(--pv-ease) backwards;
  animation-delay: calc(var(--idx, 0) * 100ms);
}
@keyframes pvTrustIn {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
.pv-trust__card:hover {
  transform: translateY(-2px);
  border-color: rgba(147,197,253,0.35);
  background: rgba(255,255,255,0.06);
}
.pv-trust__icon {
  width: 42px; height: 42px; border-radius: 11px; flex-shrink: 0;
  display: inline-flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, rgba(147,197,253,0.18), rgba(24,95,165,0.25));
  border: 1px solid rgba(147,197,253,0.30);
  color: var(--pv-accent);
  position: relative;
}
.pv-trust__icon::after {
  content: ""; position: absolute; inset: -2px; border-radius: 13px;
  background: radial-gradient(circle at 30% 30%, rgba(147,197,253,0.4), transparent 70%);
  opacity: 0; transition: opacity 240ms var(--pv-ease);
  z-index: -1; filter: blur(8px);
}
.pv-trust__card:hover .pv-trust__icon::after { opacity: 1; }
.pv-trust__icon [data-lucide] { width: 22px; height: 22px; stroke-width: 2.2; }
.pv-trust__copy { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.pv-trust__title {
  margin: 0; font-size: 14px; font-weight: 900;
  color: #fff; letter-spacing: -0.01em; line-height: 1.2;
}
