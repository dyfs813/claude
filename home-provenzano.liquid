<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js" defer></script>
<script defer>
(function () {
  'use strict';

  function ready(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  function initLucide() {
    if (window.lucide && typeof window.lucide.createIcons === 'function') window.lucide.createIcons();
  }

  function updateCartBadge() {
    var badge = document.getElementById('provCartBadge');
    if (!badge) return;
    fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
      if (cart && cart.item_count > 0) { badge.textContent = cart.item_count; badge.style.display = 'inline-flex'; }
      else { badge.style.display = 'none'; }
    }).catch(function () {});
  }

  var lenisInstance = null;
  var isMobile = window.matchMedia('(max-width: 760px)').matches;
  var hasFineCursor = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // === LENIS smooth scroll (desktop + tablet, no en mobile que ya viene smooth) ===
  function initLenis() {
    if (typeof window.Lenis === 'undefined') return null;
    if (prefersReducedMotion) return null;
    var lenis = new window.Lenis({
      duration: 1.1,
      easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
      smoothWheel: true,
      smoothTouch: false,
      touchMultiplier: 1.5
    });
    lenisInstance = lenis;
    function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
    requestAnimationFrame(raf);
    return lenis;
  }

  // === CUSTOM CURSOR (desktop fine pointer) ===
  function initCursor() {
    if (!hasFineCursor || prefersReducedMotion) return;
    var cursor = document.getElementById('provCursor');
    if (!cursor) return;
    document.body.classList.add('pv-has-cursor');
    var mx = window.innerWidth / 2, my = window.innerHeight / 2;
    var cx = mx, cy = my;
    var visible = false;
    window.addEventListener('mousemove', function (e) {
      mx = e.clientX; my = e.clientY;
      if (!visible) { cursor.style.opacity = '1'; visible = true; }
    });
    window.addEventListener('mouseleave', function () { cursor.style.opacity = '0'; visible = false; });
    function tick() {
      cx += (mx - cx) * 0.22;
      cy += (my - cy) * 0.22;
      cursor.style.transform = 'translate3d(' + cx + 'px, ' + cy + 'px, 0)';
      requestAnimationFrame(tick);
    }
    tick();
    document.querySelectorAll('.pv [data-cursor]').forEach(function (el) {
      var type = el.dataset.cursor;
      el.addEventListener('mouseenter', function () { cursor.classList.add('is-' + type); });
      el.addEventListener('mouseleave', function () { cursor.classList.remove('is-' + type); });
    });
  }

  // === THREE.js HERO SHADER ===
  function initShader() {
    if (typeof window.THREE === 'undefined') return;
    if (prefersReducedMotion) return;
    var canvas = document.getElementById('provHeroCanvas');
    if (!canvas) return;

    var THREE = window.THREE;
    var renderer, scene, camera, mat, mesh, mouse = { x: 0.5, y: 0.5 }, target = { x: 0.5, y: 0.5 };
    var dpr = Math.min(window.devicePixelRatio || 1, isMobile ? 1.2 : 2);
    var hero = canvas.parentElement;
    var raf;

    try {
      renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: false, alpha: false, powerPreference: 'high-performance' });
      renderer.setPixelRatio(dpr);
    } catch (e) { return; }

    scene = new THREE.Scene();
    camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    var vert = [
      'varying vec2 vUv;',
      'void main() {',
      '  vUv = uv;',
      '  gl_Position = vec4(position.xy, 0.0, 1.0);',
      '}'
    ].join('\n');

    var frag = [
      'precision highp float;',
      'varying vec2 vUv;',
      'uniform float uTime;',
      'uniform vec2 uMouse;',
      'uniform vec2 uRes;',
      'uniform vec3 cBg;',
      'uniform vec3 cBlue;',
      'uniform vec3 cBlueDk;',
      'uniform vec3 cAcc;',
      // 2D simplex noise (Ashima)
      'vec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}',
      'vec2 mod289(vec2 x){return x-floor(x*(1.0/289.0))*289.0;}',
      'vec3 permute(vec3 x){return mod289(((x*34.0)+1.0)*x);}',
      'float snoise(vec2 v){',
      '  const vec4 C=vec4(0.211324865405187,0.366025403784439,-0.577350269189626,0.024390243902439);',
      '  vec2 i=floor(v+dot(v,C.yy));vec2 x0=v-i+dot(i,C.xx);',
      '  vec2 i1=(x0.x>x0.y)?vec2(1.0,0.0):vec2(0.0,1.0);',
      '  vec4 x12=x0.xyxy+C.xxzz;x12.xy-=i1;',
      '  i=mod289(i);vec3 p=permute(permute(i.y+vec3(0.0,i1.y,1.0))+i.x+vec3(0.0,i1.x,1.0));',
      '  vec3 m=max(0.5-vec3(dot(x0,x0),dot(x12.xy,x12.xy),dot(x12.zw,x12.zw)),0.0);m=m*m;m=m*m;',
      '  vec3 x=2.0*fract(p*C.www)-1.0;vec3 h=abs(x)-0.5;vec3 ox=floor(x+0.5);vec3 a0=x-ox;',
      '  m*=1.79284291400159-0.85373472095314*(a0*a0+h*h);',
      '  vec3 g;g.x=a0.x*x0.x+h.x*x0.y;g.yz=a0.yz*x12.xz+h.yz*x12.yw;',
      '  return 130.0*dot(m,g);',
      '}',
      'void main(){',
      '  vec2 uv=vUv;',
      '  float aspect=uRes.x/uRes.y;',
      '  vec2 p=uv;p.x*=aspect;',
      '  float t=uTime*0.06;',
      '  vec2 m=uMouse;m.x*=aspect;',
      '  float dM=length(p-m)*0.4;',
      // mesh gradient via noise layers
      '  float n1=snoise(p*1.4+vec2(t, t*0.6))*0.5+0.5;',
      '  float n2=snoise(p*0.9-vec2(t*0.4, -t*0.7)+m*0.6)*0.5+0.5;',
      '  float n3=snoise(p*2.2+vec2(-t*0.8,t*0.2))*0.5+0.5;',
      // base mix
      '  vec3 col=mix(cBg,cBlueDk,smoothstep(0.0,1.0,n1));',
      '  col=mix(col,cBlue,smoothstep(0.2,0.9,n2)*0.85);',
      '  col=mix(col,cAcc,smoothstep(0.7,1.0,n3)*0.18);',
      // mouse glow
      '  float glow=exp(-dM*4.0)*0.35;',
      '  col+=cBlue*glow;',
      // film grain via noise high-freq
      '  float gr=snoise(uv*uRes*0.7+t*30.0)*0.04;',
      '  col+=gr;',
      // vignette + slight darken bottom (legibility)
      '  float v=1.0-length((uv-0.5)*vec2(1.1,1.0))*0.7;',
      '  col*=clamp(v,0.55,1.0);',
      '  col*=mix(1.0,0.78,smoothstep(0.55,1.0,uv.y));',
      '  gl_FragColor=vec4(col,1.0);',
      '}'
    ].join('\n');

    mat = new THREE.ShaderMaterial({
      vertexShader: vert,
      fragmentShader: frag,
      uniforms: {
        uTime:   { value: 0 },
        uMouse:  { value: new THREE.Vector2(0.5, 0.5) },
        uRes:    { value: new THREE.Vector2(1, 1) },
        cBg:     { value: new THREE.Color(0x050507) },
        cBlue:   { value: new THREE.Color(0x3B82F6) },
        cBlueDk: { value: new THREE.Color(0x0F1F38) },
        cAcc:    { value: new THREE.Color(0xF2EFE7) }
      }
    });

    mesh = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), mat);
    scene.add(mesh);

    function size() {
      var w = hero.offsetWidth, h = hero.offsetHeight;
      renderer.setSize(w, h, false);
      mat.uniforms.uRes.value.set(w, h);
    }
    size();
    var ro = ('ResizeObserver' in window) ? new ResizeObserver(size) : null;
    if (ro) ro.observe(hero); else window.addEventListener('resize', size);

    // Pointer
    hero.addEventListener('pointermove', function (e) {
      var r = hero.getBoundingClientRect();
      target.x = (e.clientX - r.left) / r.width;
      target.y = 1 - (e.clientY - r.top) / r.height;
    });

    var t0 = performance.now();
    function loop(now) {
      mouse.x += (target.x - mouse.x) * 0.06;
      mouse.y += (target.y - mouse.y) * 0.06;
      mat.uniforms.uMouse.value.set(mouse.x, mouse.y);
      mat.uniforms.uTime.value = (now - t0) * 0.001;
      renderer.render(scene, camera);
      raf = requestAnimationFrame(loop);
    }
    raf = requestAnimationFrame(loop);

    // Pause when offscreen
    if ('IntersectionObserver' in window) {
      var pio = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { if (!raf) raf = requestAnimationFrame(loop); }
          else { if (raf) { cancelAnimationFrame(raf); raf = null; } }
        });
      });
      pio.observe(hero);
    }
  }

  // === GSAP timelines + ScrollTrigger ===
  function initGsap() {
    if (typeof window.gsap === 'undefined' || typeof window.ScrollTrigger === 'undefined') return false;
    gsap.registerPlugin(ScrollTrigger);
    gsap.defaults({ ease: 'power3.out', duration: 0.8 });

    // Hook Lenis -> ScrollTrigger
    if (lenisInstance) {
      lenisInstance.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(function (time) { lenisInstance.raf(time * 1000); });
      gsap.ticker.lagSmoothing(0);
    }

    var mm = gsap.matchMedia();

    // ===== MOTION OK =====
    mm.add('(prefers-reduced-motion: no-preference)', function () {

      // HERO entrance
      var heroTl = gsap.timeline({ delay: 0.15, defaults: { ease: 'expo.out' } });
      heroTl
        .from('.pv-nav__brand, .pv-nav__meta, .pv-nav__actions', { y: -16, autoAlpha: 0, duration: 0.7, stagger: 0.06 })
        .from('.pv-hero__top > *', { y: 14, autoAlpha: 0, duration: 0.5, stagger: 0.08 }, '-=0.3')
        .from('.pv-hero__word', { yPercent: 110, duration: 1.1, stagger: 0.07 }, '-=0.2')
        .from('.pv-hero__lead', { y: 14, autoAlpha: 0, duration: 0.6 }, '-=0.6')
        .from('.pv-hero__ctas > *', { y: 14, autoAlpha: 0, duration: 0.6, stagger: 0.08 }, '-=0.4')
        .from('.pv-hero__scroll', { autoAlpha: 0, y: 8, duration: 0.5 }, '-=0.2');

      // Hero title parallax al scroll
      gsap.to('.pv-hero__title', {
        yPercent: -8, ease: 'none',
        scrollTrigger: { trigger: '.pv-hero', start: 'top top', end: 'bottom top', scrub: true }
      });

      // Reveals
      gsap.set('.pv-rev', { autoAlpha: 0, y: 32 });
      ScrollTrigger.batch('.pv-rev', {
        start: 'top 88%',
        onEnter: function (els) {
          gsap.to(els, { autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.06, ease: 'power3.out', overwrite: 'auto' });
        }
      });

      // Word reveals por sección
      ['.pv-intro__title', '.pv-orb__title', '.pv-cat__title', '.pv-marca__title', '.pv-ship__title', '.pv-htb__title', '.pv-contact__title', '.pv-foot__big-text'].forEach(function (sel) {
        var el = document.querySelector(sel);
        if (!el) return;
        var words = el.querySelectorAll('.pv-intro__word, .pv-orb__word, .pv-cat__word, .pv-marca__word, .pv-ship__word, .pv-htb__word, .pv-contact__word, .pv-foot__big-line');
        if (!words.length) return;
        gsap.from(words, {
          yPercent: 110, duration: 1.1, stagger: 0.07, ease: 'expo.out',
          scrollTrigger: { trigger: el, start: 'top 85%', once: true }
        });
      });

      // Counters
      document.querySelectorAll('.pv [data-counter]').forEach(function (el) {
        var target = parseInt(el.dataset.counter, 10) || 0;
        var obj = { v: 0 };
        gsap.to(obj, {
          v: target, duration: 1.8, ease: 'power3.out',
          onUpdate: function () { el.textContent = Math.round(obj.v); },
          scrollTrigger: { trigger: el, start: 'top 90%', once: true }
        });
      });

      // Marquees pause offscreen
      gsap.utils.toArray('.pv-tick, .pv-brands').forEach(function (sec) {
        var track = sec.querySelector('.pv-tick__track, .pv-brands__track');
        if (!track) return;
        ScrollTrigger.create({
          trigger: sec, start: 'top bottom', end: 'bottom top',
          onEnter: function () { track.style.animationPlayState = 'running'; },
          onLeave: function () { track.style.animationPlayState = 'paused'; },
          onEnterBack: function () { track.style.animationPlayState = 'running'; },
          onLeaveBack: function () { track.style.animationPlayState = 'paused'; }
        });
      });

      window.addEventListener('load', function () { ScrollTrigger.refresh(); });
    });

    // ===== HORIZONTAL SCROLL CATALOG (desktop) con efecto 3D shelf =====
    mm.add('(min-width: 1100px) and (prefers-reduced-motion: no-preference)', function () {
      var pin = document.getElementById('provCatPin');
      var track = document.getElementById('provCatTrack');
      if (!pin || !track) return;
      var cards = track.querySelectorAll('.pv-prod, .pv-cat__card');

      var getDistance = function () { return track.scrollWidth - window.innerWidth + 56; };

      function update3D() {
        var screenCenter = window.innerWidth / 2;
        cards.forEach(function (card) {
          var r = card.getBoundingClientRect();
          var cardCenter = r.left + r.width / 2;
          var dist = (cardCenter - screenCenter) / window.innerWidth; // -1..1 roughly
          var clamped = Math.max(-1, Math.min(1, dist));
          var rotY = clamped * -28;
          var sc = 1 - Math.abs(clamped) * 0.12;
          var br = 1 - Math.abs(clamped) * 0.35;
          card.style.setProperty('--cy', rotY + 'deg');
          card.style.setProperty('--sc', sc.toFixed(3));
          card.style.setProperty('--br', br.toFixed(3));
        });
      }

      var st = gsap.to(track, {
        x: function () { return -getDistance(); },
        ease: 'none',
        scrollTrigger: {
          trigger: pin,
          pin: true,
          start: 'top top',
          end: function () { return '+=' + getDistance(); },
          scrub: 0.8,
          invalidateOnRefresh: true,
          anticipatePin: 1,
          onUpdate: update3D,
          onRefresh: update3D
        }
      });
      update3D();
      return function () {
        st.kill();
        cards.forEach(function (c) { c.style.removeProperty('--cy'); c.style.removeProperty('--sc'); c.style.removeProperty('--br'); });
      };
    });

    // ===== HTB scroll-jacked (desktop) =====
    mm.add('(min-width: 1100px) and (prefers-reduced-motion: no-preference)', function () {
      var sec = document.getElementById('provHtb');
      var track = document.getElementById('provHtbTrack');
      var fill = document.getElementById('provHtbFill');
      var bg = document.getElementById('provHtbBg');
      if (!sec || !track || !fill) return;
      var nodes  = sec.querySelectorAll('.pv-htb__node');
      var panels = sec.querySelectorAll('.pv-htb__panel');
      var glows = ['rgba(59,130,246,0.18)', 'rgba(37,211,102,0.18)', 'rgba(245,158,11,0.18)', 'rgba(168,85,247,0.18)'];

      var st = ScrollTrigger.create({
        trigger: sec,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.6,
        onUpdate: function (self) {
          var p = self.progress;
          track.style.transform = 'translate3d(' + (-p * 75) + '%, 0, 0)';
          fill.style.width = (p * 100) + '%';
          var idx = Math.min(3, Math.floor(p * 4));
          nodes.forEach(function (n, i) {
            n.classList.toggle('is-reached', i <= idx);
            n.classList.toggle('is-active',  i === idx);
          });
          panels.forEach(function (panel, i) {
            panel.classList.toggle('is-active', i === idx);
          });
          if (bg) bg.style.setProperty('--htbGlow', glows[idx] || glows[0]);
        }
      });
      return function () { st.kill(); };
    });

    // ===== REDUCED MOTION =====
    mm.add('(prefers-reduced-motion: reduce)', function () {
      gsap.set('.pv-rev', { autoAlpha: 1, y: 0 });
      gsap.set('.pv-hero__word, .pv-intro__word, .pv-orb__word, .pv-cat__word, .pv-marca__word, .pv-ship__word, .pv-htb__word, .pv-contact__word, .pv-foot__big-line', { yPercent: 0, autoAlpha: 1 });
      document.querySelectorAll('.pv [data-counter]').forEach(function (el) {
        el.textContent = parseInt(el.dataset.counter, 10) || 0;
      });
    });

    return true;
  }

  // === ORBIT: pause + label + HUD on hover/tap ===
  function initOrbit() {
    var stage = document.getElementById('provOrbStage');
    var ring  = document.getElementById('provOrbRing');
    var hud   = document.getElementById('provOrbHudVal');
    if (!stage || !ring || !hud) return;
    var defaultText = hud.textContent;
    var pins = ring.querySelectorAll('.pv-orb__pin');
    function setActive(pin) {
      pins.forEach(function (p) { p.classList.remove('is-active'); });
      if (!pin) { hud.textContent = defaultText; return; }
      pin.classList.add('is-active');
      var lab = pin.getAttribute('aria-label');
      if (lab) hud.textContent = lab;
    }
    stage.addEventListener('mouseenter', function () { stage.classList.add('is-paused'); });
    stage.addEventListener('mouseleave', function () { stage.classList.remove('is-paused'); setActive(null); });
    pins.forEach(function (pin) {
      pin.addEventListener('mouseenter', function () { setActive(pin); });
      pin.addEventListener('focus', function () { setActive(pin); stage.classList.add('is-paused'); });
      pin.addEventListener('blur', function () { setActive(null); stage.classList.remove('is-paused'); });
    });
  }

  // === MARCAS: tab switching with bg morph ===
  function initMarca() {
    var sec = document.getElementById('provMarca');
    if (!sec) return;
    var bg = document.getElementById('provMarcaBg');
    var btns = sec.querySelectorAll('.pv-marca__btn');
    var panels = sec.querySelectorAll('.pv-marca__panel');
    function colorFor(name) {
      return ({
        energizer: 'rgba(225,29,72,0.30)',
        duracell:  'rgba(234,88,12,0.30)',
        gillette:  'rgba(59,130,246,0.30)',
        candela:   'rgba(245,158,11,0.30)',
        bic:       'rgba(30,64,175,0.40)'
      })[name] || 'rgba(59,130,246,0.30)';
    }
    function activate(name, x, y) {
      btns.forEach(function (b) { b.classList.toggle('is-active', b.dataset.brand === name); });
      panels.forEach(function (p) { p.classList.toggle('is-active', p.dataset.panel === name); });
      if (bg) {
        if (typeof x === 'number') {
          bg.style.setProperty('--bx', x + 'px');
          bg.style.setProperty('--by', y + 'px');
        }
        bg.style.setProperty('--bgGlow', colorFor(name));
      }
    }
    btns.forEach(function (b) {
      b.addEventListener('mouseenter', function (e) {
        var r = sec.getBoundingClientRect();
        activate(b.dataset.brand, e.clientX - r.left, e.clientY - r.top);
      });
      b.addEventListener('focus', function () { activate(b.dataset.brand); });
      b.addEventListener('click', function () { activate(b.dataset.brand); });
    });
  }

  // === MAP: tooltip on hover/focus ===
  function initMap() {
    var map = document.getElementById('provMap');
    var tip = document.getElementById('provMapTip');
    if (!map || !tip) return;
    var tipEye  = tip.querySelector('.pv-map__tip-eye');
    var tipName = tip.querySelector('.pv-map__tip-name');
    var tipMeta = tip.querySelector('.pv-map__tip-meta');
    var pins = map.querySelectorAll('.pv-map__pin');
    function show(pin) {
      var rect = map.getBoundingClientRect();
      var pinRect = pin.getBoundingClientRect();
      var x = pinRect.left - rect.left + pinRect.width / 2;
      var y = pinRect.top  - rect.top + pinRect.height / 2;
      tip.style.left = x + 'px';
      tip.style.top  = y + 'px';
      tipEye.textContent = 'Destino';
      tipName.textContent = pin.dataset.name || '';
      tipMeta.textContent = pin.dataset.meta || '';
      tip.classList.add('is-visible');
    }
    function hide() { tip.classList.remove('is-visible'); }
    pins.forEach(function (pin) {
      pin.addEventListener('mouseenter', function () { show(pin); });
      pin.addEventListener('mouseleave', hide);
      pin.addEventListener('focus', function () { show(pin); });
      pin.addEventListener('blur', hide);
    });
  }

  // === Smooth scroll para anchors (compatible con Lenis) ===
  function initAnchors() {
    document.querySelectorAll('.pv a[href^="#"]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        var id = a.getAttribute('href').slice(1);
        var target = document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        if (lenisInstance) lenisInstance.scrollTo(target, { offset: 0 });
        else target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  }

  function initFallback() {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.pv .pv-rev').forEach(function (el) { el.classList.add('is-in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
    document.querySelectorAll('.pv .pv-rev').forEach(function (el) { io.observe(el); });
  }

  ready(function () {
    initLucide();
    updateCartBadge();
    initLenis();
    initCursor();
    initShader();
    initAnchors();
    initOrbit();
    initMarca();
    initMap();
    var hasGsap = initGsap();
    if (!hasGsap) initFallback();
  });
})();
</script>
