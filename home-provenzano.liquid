.pv-foot__legal-mono { letter-spacing: 0.16em; text-transform: uppercase; }

/* ====== FAB WhatsApp ====== */
.pv-fab {
  position: fixed; right: 18px; bottom: 18px; z-index: 60;
  width: 60px; height: 60px; border-radius: 50%;
  background: var(--pv-wa); color: #052E12;
  display: inline-flex; align-items: center; justify-content: center;
  text-decoration: none;
  box-shadow: var(--pv-clay-green);
  transition: transform 220ms var(--pv-ease);
}
.pv-fab:hover { transform: translateY(-3px) scale(1.05); }
.pv-fab:active { transform: translateY(0) scale(0.96); box-shadow: var(--pv-clay-press); }
.pv-fab__ring {
  position: absolute; inset: 0; border-radius: 50%;
  border: 2px solid rgba(37,211,102,0.55);
  animation: pvFabRing 2.4s ease-out infinite;
  pointer-events: none;
}
.pv-fab__ring--2 { animation-delay: 1.2s; }
@keyframes pvFabRing {
  0%   { transform: scale(1); opacity: 0.85; }
  100% { transform: scale(1.7); opacity: 0; }
}
.pv-fab svg { position: relative; z-index: 1; }

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .pv *, .pv *::before, .pv *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
  .pv-rev { opacity: 1 !important; transform: none !important; }
}
</style>

<script defer>
(function () {
  'use strict';

  function ready(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  function initLucide() {
    if (window.lucide && typeof window.lucide.createIcons === 'function') window.lucide.createIcons();
  }

  function updateCartBadge() {
    var badge = document.getElementById('provCartBadge');
    if (!badge) return;
    fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
      if (cart && cart.item_count > 0) { badge.textContent = cart.item_count; badge.style.display = 'inline-flex'; }
      else { badge.style.display = 'none'; }
    }).catch(function () {});
  }

  function initReveal() {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.pv .pv-rev').forEach(function (el) { el.classList.add('is-in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          var idx = parseInt(e.target.dataset.delay, 10) || 0;
          setTimeout(function () { e.target.classList.add('is-in'); }, idx);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.pv .pv-rev').forEach(function (el) { io.observe(el); });
  }

  function initSmoothScroll() {
    document.querySelectorAll('.pv a[href^="#"]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        var id = a.getAttribute('href').slice(1);
        var t = document.getElementById(id);
        if (!t) return;
        e.preventDefault();
        t.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  }

  ready(function () {
    initLucide();
    updateCartBadge();
    initReveal();
    initSmoothScroll();
  });
})();
</script>
