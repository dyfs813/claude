.pv-brand--gillette  { --pv-brand-glow: radial-gradient(circle at 50% 0%, rgba(59,130,246,0.30), transparent 60%); }
.pv-brand--gillette  .pv-brand__name { font-style: italic; color: #93C5FD; letter-spacing: -0.04em; font-weight: 800; }
.pv-brand--candela   { --pv-brand-glow: radial-gradient(circle at 50% 0%, rgba(217,119,6,0.30), transparent 60%); }
.pv-brand--candela   .pv-brand__name { color: #FCD34D; font-weight: 800; letter-spacing: 0.02em; }
.pv-brand--bic       { --pv-brand-glow: radial-gradient(circle at 50% 0%, rgba(217,119,6,0.30), transparent 60%); }
.pv-brand--bic       .pv-brand__name { color: #fff; background: linear-gradient(180deg, #fff 50%, #FB923C 50%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; font-size: 28px; }

@media (max-width: 540px) {
