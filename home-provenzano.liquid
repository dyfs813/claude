  opacity: 0; transition: opacity 280ms var(--pv-ease);
}
.pv-brand:hover { transform: translateY(-3px); border-color: rgba(147,197,253,0.30); background: rgba(255,255,255,0.07); }
.pv-brand:hover::before { opacity: 1; }
.pv-brand__name {
