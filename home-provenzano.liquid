.pv-shelf__counter-value { font-size: 28px; font-weight: 900; color: #fff; letter-spacing: -0.02em; line-height: 1; }
.pv-shelf__counter-divider { font-size: 22px; font-weight: 800; color: rgba(255,255,255,0.30); margin: 0 2px; }
.pv-shelf__counter-total { font-size: 22px; font-weight: 800; color: rgba(147,197,253,0.85); letter-spacing: -0.02em; line-height: 1; }
.pv-shelf__counter-label { font-size: 9px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.55); margin-left: 10px; line-height: 1.3; align-self: center; }

.pv-shelf__grid-wrap {
