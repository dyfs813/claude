}
.pv-brands__marquee:hover .pv-brands__track { animation-play-state: paused; }
@keyframes pvBrandsScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.pv-brand {
  position: relative;
  flex: 0 0 auto;
