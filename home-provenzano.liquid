  border-top: 1px dashed rgba(24,95,165,0.18);
}
.pv-shelf-card__price-block { display: flex; flex-direction: column; line-height: 1; }
.pv-shelf-card__price-label { font-size: 9px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #71717A; margin-bottom: 3px; }
.pv-shelf-card__price { font-size: 18px; font-weight: 900; letter-spacing: -0.02em; color: var(--pv-primary-dk); font-variant-numeric: tabular-nums; }
