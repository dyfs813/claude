}
@media (min-width: 540px) { .pv-shelf__grid-wrap { grid-template-columns: repeat(3, 1fr); gap: 16px; } }
@media (min-width: 900px) { .pv-shelf__grid-wrap { grid-template-columns: repeat(4, 1fr); gap: 20px; } }

.pv-shelf-card {
  position: relative;
  background: linear-gradient(180deg, #fff 0%, #FAFCFE 100%);
  border: 1px solid rgba(147,197,253,0.14);
  border-radius: 14px; padding: 12px 12px 14px;
  display: flex; flex-direction: column; gap: 10px;
  text-decoration: none; color: inherit;
  box-shadow: 0 1px 0 0 rgba(255,255,255,0.6) inset, 0 12px 32px -12px rgba(12,30,60,0.55), 0 4px 12px -4px rgba(12,30,60,0.4);
  transition: transform 240ms var(--pv-ease), box-shadow 240ms var(--pv-ease), border-color 240ms var(--pv-ease);
  animation: pvShelfPop 600ms var(--pv-ease) backwards;
  animation-delay: var(--delay, 0ms);
