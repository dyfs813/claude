  background: #E6F1FB; border-radius: 6px; padding: 4px 8px;
  font-size: 11px; font-weight: 800; color: var(--pv-primary-dk); align-self: flex-start;
}
.pv-shelf-card__bulk [data-lucide] { width: 12px; height: 12px; color: var(--pv-primary); stroke-width: 2.5; }

.pv-shelf-card__bottom {
