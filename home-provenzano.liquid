.pv-why__grid {
  display: grid; gap: 12px;
  grid-template-columns: 1fr;
  grid-template-areas:
    "hero"
    "catalog"
    "store"
    "ship"
    "invoice";
}
@media (min-width: 640px) {
  .pv-why__grid {
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      "hero hero"
      "catalog store"
      "ship invoice";
    gap: 14px;
  }
}
@media (min-width: 960px) {
  .pv-why__grid {
    grid-template-columns: 1.4fr 1fr 1fr;
    grid-template-rows: auto auto;
    grid-template-areas:
      "hero catalog store"
      "hero ship invoice";
