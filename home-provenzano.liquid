@keyframes pvShelfPop { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
.pv-shelf-card:hover {
  transform: translateY(-4px);
  border-color: rgba(147,197,253,0.6);
  box-shadow: 0 1px 0 0 rgba(255,255,255,0.6) inset, 0 0 0 4px rgba(147,197,253,0.10), 0 22px 44px -14px rgba(12,30,60,0.65), 0 8px 16px -4px rgba(24,95,165,0.4);
}
.pv-shelf-card:hover .pv-shelf-card__add { background: var(--pv-primary); color: #fff; transform: translateX(2px); }

.pv-shelf-card__sku {
  position: absolute; top: 8px; left: 8px; z-index: 3;
  font-family: var(--pv-mono);
  font-size: 9px; font-weight: 700; letter-spacing: 0.10em;
  color: rgba(12,68,124,0.6);
  background: rgba(230,241,251,0.85);
  border: 1px solid rgba(24,95,165,0.20);
  padding: 3px 7px; border-radius: 4px;
}

.pv-shelf-card__img {
