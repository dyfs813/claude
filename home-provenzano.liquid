{% comment %}
========================================================================
PROVENZANO HOME v5 — claymorphism (1 archivo)
========================================================================
Estructura ultra-focalizada:
  1. Hero (quiénes somos + qué vendemos + CTA al catálogo)
  2. Envíos (toda la info)
  3. Mini footer

Estética: claymorphism (puffy, redondo, light, playful pero serio).
Sin video, sin WebGL, sin smooth-scroll — load liviano.
========================================================================
{% endcomment %}

{% schema %}
{
  "name": "Home Provenzano",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "logo_url", "label": "URL del logo", "default": "https://cdn.shopify.com/s/files/1/0729/9366/9368/files/provenzano-logo.svg?v=1777313813" },
    { "type": "text", "id": "wpp_phone", "label": "WhatsApp", "default": "5491141794592" }
  ],
  "presets": [{ "name": "Home Provenzano" }]
}
{% endschema %}

{%- assign logo_url = section.settings.logo_url | default: 'https://cdn.shopify.com/s/files/1/0729/9366/9368/files/provenzano-logo.svg?v=1777313813' -%}
{%- assign wpp_phone = section.settings.wpp_phone | default: '5491141794592' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<div class="pv">
  {%- comment -%} ============ HERO ============ {%- endcomment -%}
  <header class="pv-hero">

    {%- comment -%} Decorative blobs {%- endcomment -%}
    <div class="pv-hero__deco" aria-hidden="true">
      <div class="pv-blob pv-blob--1"></div>
      <div class="pv-blob pv-blob--2"></div>
      <div class="pv-blob pv-blob--3"></div>
      <div class="pv-blob pv-blob--4"></div>
      <div class="pv-blob pv-blob--5"></div>
    </div>

    <nav class="pv-nav pv-wrap">
      <a href="/" class="pv-nav__brand" aria-label="Provenzano">
        <span class="pv-nav__mark"><img src="{{ logo_url }}" alt=""></span>
        <span class="pv-nav__text">
          <span class="pv-nav__name">Provenzano</span>
          <span class="pv-nav__tag"><span class="pv-nav__live"></span>Liniers · Mayorista</span>
        </span>
      </a>
      <div class="pv-nav__actions">
        <a href="/search" class="pv-nav__btn" aria-label="Buscar"><i data-lucide="search"></i></a>
        <a href="/cart" class="pv-nav__btn" aria-label="Carrito">
          <i data-lucide="shopping-cart"></i>
          <span class="pv-nav__badge" id="provCartBadge" style="display:none">0</span>
        </a>
      </div>
    </nav>

    <div class="pv-hero__inner pv-wrap">

      <div class="pv-hero__chip pv-rev">
        <span class="pv-hero__chip-dot"></span>
        <span class="pv-hero__chip-text">Mayorista de kiosko · desde 2003</span>
      </div>

      <h1 class="pv-hero__title pv-rev" data-delay="80">
        Tu mayorista de<br>
        <span class="pv-hero__title-em">toda la vida.</span>
      </h1>

      <p class="pv-hero__lead pv-rev" data-delay="160">
        Abastecemos kioscos, almacenes y revendedores desde Liniers, CABA. Catálogo de <b>200+ productos</b> con precios mayoristas <b>actualizados todos los días</b>.
      </p>

      <div class="pv-hero__ctas pv-rev" data-delay="240">
        <a href="/collections/all" class="pv-cta">
          <span class="pv-cta__main">
            <span class="pv-cta__lab">Catálogo en vivo</span>
            <span class="pv-cta__title">Armá tu pedido <i data-lucide="arrow-right"></i></span>
          </span>
          <span class="pv-cta__chip">→</span>
        </a>
        <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola Provenzano, quiero hacer una consulta' | url_encode }}" target="_blank" rel="noopener" class="pv-wa-btn">
          <span class="pv-wa-btn__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>
          </span>
          <span class="pv-wa-btn__text">
            <span class="pv-wa-btn__lab">o consultanos</span>
            <span class="pv-wa-btn__num">+54 9 11 4179-4592</span>
          </span>
        </a>
      </div>

      <div class="pv-hero__stats pv-rev" data-delay="320">
        <div class="pv-stat pv-stat--blue">
          <span class="pv-stat__num">20<i>+</i></span>
          <span class="pv-stat__lab">años en Liniers</span>
        </div>
        <div class="pv-stat pv-stat--purple">
          <span class="pv-stat__num">216<i>+</i></span>
          <span class="pv-stat__lab">productos en stock</span>
        </div>
        <div class="pv-stat pv-stat--pink">
          <span class="pv-stat__num">24</span>
          <span class="pv-stat__lab">provincias</span>
        </div>
        <div class="pv-stat pv-stat--yellow">
          <span class="pv-stat__num">A<i>/</i>B</span>
          <span class="pv-stat__lab">factura</span>
        </div>
      </div>

      <div class="pv-hero__brands pv-rev" data-delay="400">
        <span class="pv-hero__brands-lab">Trabajamos con</span>
        <div class="pv-hero__brands-list">
          <span class="pv-brand-pill">Energizer</span>
          <span class="pv-brand-pill">Duracell</span>
          <span class="pv-brand-pill">Gillette</span>
          <span class="pv-brand-pill">Candela</span>
          <span class="pv-brand-pill">BIC</span>
        </div>
      </div>
    </div>
  </header>
  {%- comment -%} ============ ENVÍOS ============ {%- endcomment -%}
  <section class="pv-ship" id="provShip">
    <div class="pv-wrap">

      <header class="pv-ship__head pv-rev">
        <div class="pv-ship__head-l">
          <span class="pv-mini-label">02 · Envíos</span>
          <h2 class="pv-ship__title">Cómo te <span class="pv-ship__title-em">llega.</span></h2>
        </div>
        <p class="pv-ship__lead">Cuatro formas de recibir tu pedido. Todas claras desde el principio, sin letra chica.</p>
      </header>

      {%- comment -%} 4 modalidades {%- endcomment -%}
      <div class="pv-ship__cards">

        <article class="pv-ship-card pv-ship-card--blue pv-ship-card--feat pv-rev" data-delay="0">
          <div class="pv-ship-card__top">
            <span class="pv-ship-card__num">02</span>
            <span class="pv-ship-card__icon"><i data-lucide="truck"></i></span>
          </div>
          <div class="pv-ship-card__hero">
            <span class="pv-ship-card__highlight">Envío GRATIS desde $600.000</span>
            <h3 class="pv-ship-card__title">CABA<br>y GBA</h3>
          </div>
          <div class="pv-ship-card__big">
            <span class="pv-ship-card__big-lab">Desde</span>
            <span class="pv-ship-card__big-num">$4.100</span>
          </div>
          <ul class="pv-ship-card__list">
            <li><span>Pedido mínimo</span><span><b>$100.000</b></span></li>
            <li><span>Días de despacho</span><span><b>Martes y jueves</b></span></li>
            <li><span>Salida</span><span><b>14 hs</b></span></li>
            <li><span>Llegada</span><span><b>14 a 21 hs</b></span></li>
          </ul>
          <a href="#provZones" class="pv-ship-card__cta">Ver zonas y precios <i data-lucide="arrow-down"></i></a>
        </article>

        <article class="pv-ship-card pv-ship-card--green pv-rev" data-delay="80">
          <div class="pv-ship-card__top">
            <span class="pv-ship-card__num">01</span>
            <span class="pv-ship-card__icon"><i data-lucide="store"></i></span>
          </div>
          <h3 class="pv-ship-card__title">Retiro<br>en sucursal</h3>
          <span class="pv-ship-card__big-num pv-ship-card__big-num--free">SIN COSTO</span>
          <ul class="pv-ship-card__list">
            <li><span>Pedido mínimo</span><span><b>$100.000</b></span></li>
            <li><span>Días</span><span><b>Lun. a sáb.</b></span></li>
            <li><span>Dirección</span><span><b>Carhué 74, Liniers</b></span></li>
          </ul>
        </article>

        <article class="pv-ship-card pv-ship-card--purple pv-rev" data-delay="160">
          <div class="pv-ship-card__top">
            <span class="pv-ship-card__num">03</span>
            <span class="pv-ship-card__icon"><i data-lucide="map"></i></span>
          </div>
          <h3 class="pv-ship-card__title">Envío al<br>interior</h3>
          <span class="pv-ship-card__big-num pv-ship-card__big-num--alt">Vía cargo</span>
          <ul class="pv-ship-card__list">
            <li><span>Pedido mínimo</span><span><b>$200.000</b></span></li>
            <li><span>Tiempo</span><span><b>2 a 7 días hábiles</b></span></li>
            <li><span>Cobertura</span><span><b>24 provincias</b></span></li>
            <li><span>Flete</span><span><b>Lo paga el cliente</b></span></li>
          </ul>
        </article>

        <article class="pv-ship-card pv-ship-card--yellow pv-rev" data-delay="240">
          <div class="pv-ship-card__top">
            <span class="pv-ship-card__num">04</span>
            <span class="pv-ship-card__icon"><i data-lucide="handshake"></i></span>
          </div>
          <h3 class="pv-ship-card__title">Tu transporte<br>o comisionista</h3>
          <span class="pv-ship-card__big-num pv-ship-card__big-num--free">SIN COSTO</span>
          <ul class="pv-ship-card__list">
            <li><span>Pedido mínimo</span><span><b>$500.000</b></span></li>
            <li><span>Retiro</span><span><b>Carhué 74, Liniers</b></span></li>
            <li><span>Días</span><span><b>Lun. a sáb.</b></span></li>
          </ul>
        </article>

      </div>

      {%- comment -%} Zonas GBA {%- endcomment -%}
      <div class="pv-zones" id="provZones">
        <header class="pv-zones__head pv-rev">
          <span class="pv-mini-label">02.1 · Zonas y precios CABA / GBA</span>
          <h3 class="pv-zones__title">Tu zona, <span class="pv-zones__title-em">tu precio.</span></h3>
        </header>

        <div class="pv-zones__list">
          <article class="pv-zone pv-zone--green pv-rev">
            <div class="pv-zone__head">
              <span class="pv-zone__name">CABA</span>
              <span class="pv-zone__price">$4.100</span>
            </div>
            <p class="pv-zone__partidos">Toda la Capital Federal.</p>
          </article>

          <article class="pv-zone pv-zone--blue pv-rev" data-delay="80">
            <div class="pv-zone__head">
              <span class="pv-zone__name">GBA <em>1</em></span>
              <span class="pv-zone__price">$5.000</span>
            </div>
            <p class="pv-zone__partidos">Avellaneda · Lanús · Lomas de Zamora · La Matanza Norte · Morón · 3 de Febrero · San Martín · Vicente López · San Isidro</p>
          </article>

          <article class="pv-zone pv-zone--orange pv-rev" data-delay="160">
            <div class="pv-zone__head">
              <span class="pv-zone__name">GBA <em>2</em></span>
              <span class="pv-zone__price">$6.000</span>
            </div>
            <p class="pv-zone__partidos">San Fernando · Tigre · Malvinas Argentinas · José C. Paz · San Miguel · Hurlingham · Ituzaingó · La Matanza Sur · Merlo · Moreno · Esteban Echeverría · Almirante Brown · Ezeiza · Quilmes · Florencio Varela · Berazategui</p>
          </article>

          <article class="pv-zone pv-zone--pink pv-rev" data-delay="240">
            <div class="pv-zone__head">
              <span class="pv-zone__name">GBA <em>3</em></span>
              <span class="pv-zone__price">$7.900</span>
            </div>
            <p class="pv-zone__partidos">Zárate · Campana · Escobar · Ing. Maschwitz · Garín · Pilar · Del Viso · Derqui · Villa Rosa · Luján · Gral. Rodríguez · Marcos Paz · Nordelta · San Vicente · Guernica · Berisso · La Plata · Cañuelas · Ensenada</p>
          </article>
        </div>
      </div>

      {%- comment -%} CTA coordinar {%- endcomment -%}
      <div class="pv-ship__bottom pv-rev">
        <div class="pv-ship__bottom-text">
          <span class="pv-mini-label">¿Dudas con tu envío?</span>
          <h3 class="pv-ship__bottom-h">Coordinemos en el día.</h3>
          <p class="pv-ship__bottom-p">Te respondemos por WhatsApp en horario comercial. Sin formularios largos.</p>
        </div>
        <a href="https://wa.me/{{ wpp_phone }}?text={{ 'Hola Provenzano, quiero coordinar el envio de un pedido' | url_encode }}" target="_blank" rel="noopener" class="pv-ship__bottom-cta">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>
          <span>Escribir por WhatsApp</span>
        </a>
      </div>

    </div>
  </section>
  {%- comment -%} ============ FOOTER mini ============ {%- endcomment -%}
  <footer class="pv-foot">
    <div class="pv-wrap pv-foot__inner">
      <a href="/" class="pv-foot__brand">
        <span class="pv-foot__mark"><img src="{{ logo_url }}" alt=""></span>
        <span class="pv-foot__text">
          <span class="pv-foot__name">Provenzano</span>
          <span class="pv-foot__tag">Mayorista · Desde 2003</span>
        </span>
      </a>
      <div class="pv-foot__links">
        <a class="pv-foot__chip" href="https://www.google.com/maps/search/?api=1&query=Carh%C3%BA%C3%A9+74+Liniers+CABA" target="_blank" rel="noopener">
          <i data-lucide="map-pin"></i> Carhué 74, Liniers
